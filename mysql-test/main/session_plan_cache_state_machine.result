CREATE TABLE pc_sm_t1 (
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
CREATE TABLE pc_sm_t2 (
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO pc_sm_t1 VALUES (1,10),(2,20);
INSERT INTO pc_sm_t2 VALUES (1,100),(2,200);
# DISABLED is transient: the same prepared statement can cache after enabling
SET @@session.session_plan_cache = OFF;
PREPARE stmt FROM 'SELECT id, v FROM pc_sm_t1 WHERE id = ?';
SET @p=1;
EXECUTE stmt USING @p;
id	v
1	10
include/assert.inc [Cached_plan_count does not grow while session_plan_cache is OFF]
SET @@session.session_plan_cache = ON;
SET @p=2;
EXECUTE stmt USING @p;
id	v
2	20
include/assert.inc [Cached_plan_count grows after enabling session_plan_cache on the same prepared statement]
include/assert.inc [Cached_plan_hits remains unchanged before reuse is implemented]
include/assert.inc [Cached_plan_invalidations remains unchanged after enabling]
DEALLOCATE PREPARE stmt;
include/assert.inc [Cached_plan_count returns to baseline after deallocate]
# Unsupported shapes are permanently uncacheable for this prepared statement
PREPARE stmt FROM 'SELECT pc_sm_t1.id, pc_sm_t2.v FROM pc_sm_t1 JOIN pc_sm_t2 ON pc_sm_t2.id = pc_sm_t1.id WHERE pc_sm_t1.id = ?';
SET @p=1;
EXECUTE stmt USING @p;
id	v
1	100
SET @p=2;
EXECUTE stmt USING @p;
id	v
2	200
include/assert.inc [Unsupported prepared statement does not create a cached-plan state]
include/assert.inc [Unsupported prepared statement does not record hits]
include/assert.inc [Unsupported prepared statement does not invalidate absent state]
DEALLOCATE PREPARE stmt;
SET @@session.session_plan_cache = DEFAULT;
DROP TABLE pc_sm_t2;
DROP TABLE pc_sm_t1;
