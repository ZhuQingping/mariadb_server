CREATE TABLE pc_readiness_t1 (
id INT PRIMARY KEY,
v INT,
KEY(v)
) ENGINE=InnoDB;
CREATE TABLE pc_readiness_t2 (
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO pc_readiness_t1 VALUES (1,10),(2,20),(3,20);
INSERT INTO pc_readiness_t2 VALUES (1,100),(2,200);
SET @@session.session_plan_cache = ON;
# Recipe-less SELECT without a WHERE predicate does not create plan-cache state
PREPARE stmt FROM 'SELECT id FROM pc_readiness_t1';
EXECUTE stmt;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
# Literal non-unique key equality does not create plan-cache state
PREPARE stmt FROM 'SELECT id FROM pc_readiness_t1 WHERE v = 20';
EXECUTE stmt;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
# Literal unique-key equality does not create plan-cache state
PREPARE stmt FROM 'SELECT id FROM pc_readiness_t1 WHERE id = 1';
EXECUTE stmt;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
# Join remains outside the plan-cache boundary
PREPARE stmt FROM 'SELECT t1.id, t2.v FROM pc_readiness_t1 t1 JOIN pc_readiness_t2 t2 ON t2.id = t1.id WHERE t1.id = ?';
SET @p=1;
EXECUTE stmt USING @p;
EXECUTE stmt USING @p;
DEALLOCATE PREPARE stmt;
# Derived table remains outside the plan-cache boundary
PREPARE stmt FROM 'SELECT id FROM (SELECT id, v FROM pc_readiness_t1 WHERE v = ?) AS d WHERE id > 0';
SET @p=20;
EXECUTE stmt USING @p;
EXECUTE stmt USING @p;
DEALLOCATE PREPARE stmt;
# Correlated subquery remains outside the plan-cache boundary
PREPARE stmt FROM 'SELECT id FROM pc_readiness_t1 t1 WHERE id = ? AND EXISTS (SELECT 1 FROM pc_readiness_t2 t2 WHERE t2.id = t1.id)';
SET @p=1;
EXECUTE stmt USING @p;
EXECUTE stmt USING @p;
DEALLOCATE PREPARE stmt;
# mysql system tables remain outside the plan-cache boundary
PREPARE stmt FROM 'SELECT name FROM mysql.help_topic WHERE help_topic_id = ?';
SET @p=1;
EXECUTE stmt USING @p;
EXECUTE stmt USING @p;
DEALLOCATE PREPARE stmt;
include/assert.inc [Cached_plan_count does not grow for readiness boundary cases]
include/assert.inc [Cached_plan_hits does not grow for readiness boundary cases]
include/assert.inc [Cached_plan_prevalidations does not grow for readiness boundary cases]
include/assert.inc [Cached_plan_invalidations does not grow for readiness boundary cases]
SET @@session.session_plan_cache = DEFAULT;
DROP TABLE pc_readiness_t2;
DROP TABLE pc_readiness_t1;
