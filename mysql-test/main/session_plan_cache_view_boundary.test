--source include/have_innodb.inc

CREATE TABLE pc_view_base (
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

INSERT INTO pc_view_base VALUES (1,10),(2,20);

CREATE VIEW pc_view_boundary AS
  SELECT id, v FROM pc_view_base;

SET @@session.session_plan_cache = ON;

--disable_query_log
let $count_before= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);
let $invalidations_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_invalidations', Value, 1);
--enable_query_log

--echo # Views are not plan-cache candidates
PREPARE stmt FROM
  'SELECT id, v FROM pc_view_boundary WHERE id = ?';
SET @p=1;
EXECUTE stmt USING @p;
SET @p=2;
EXECUTE stmt USING @p;

--disable_query_log
let $count_after= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);
let $invalidations_after= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_invalidations', Value, 1);

--let $assert_text= Cached_plan_count does not grow for view SELECT
--let $assert_cond= $count_after = $count_before
--source include/assert.inc

--let $assert_text= Cached_plan_hits does not grow for view SELECT
--let $assert_cond= $hits_after = $hits_before
--source include/assert.inc

--let $assert_text= Cached_plan_prevalidations does not grow for view SELECT
--let $assert_cond= $prevalidations_after = $prevalidations_before
--source include/assert.inc

--let $assert_text= Cached_plan_invalidations does not grow for view SELECT
--let $assert_cond= $invalidations_after = $invalidations_before
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt;

SET @@session.session_plan_cache = DEFAULT;

DROP VIEW pc_view_boundary;
DROP TABLE pc_view_base;
