include/assert.inc [profiled DISTINCT range increments range hit counter]
include/assert.inc [profiled DISTINCT range records post setup time]
include/assert.inc [profiled DISTINCT range exposes ref array setup time]
include/assert.inc [profiled DISTINCT range records aggregate setup time]
include/assert.inc [profiled DISTINCT range records fast aggregate setup time]
include/assert.inc [profiled DISTINCT range records hit explain time]
DEALLOCATE PREPARE stmt;
SET @@session.session_plan_cache_profile = @save_profile;
SET @@session.session_plan_cache_allow_change_ratio = @save_ratio;
SET @@session.session_plan_cache = DEFAULT;
DROP TABLE pc_distinct_range_profile;
