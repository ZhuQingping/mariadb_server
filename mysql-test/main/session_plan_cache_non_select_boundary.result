CREATE TABLE pc_non_select (
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO pc_non_select VALUES (1,10),(2,20);
SET @@session.session_plan_cache = ON;
# Prepared INSERT is not a plan-cache candidate
PREPARE stmt FROM 'INSERT INTO pc_non_select VALUES (?, ?)';
SET @id=3;
SET @v=30;
EXECUTE stmt USING @id, @v;
DEALLOCATE PREPARE stmt;
# Prepared UPDATE is not a plan-cache candidate
PREPARE stmt FROM 'UPDATE pc_non_select SET v = ? WHERE id = ?';
SET @v=40;
SET @id=3;
EXECUTE stmt USING @v, @id;
DEALLOCATE PREPARE stmt;
# Prepared DELETE is not a plan-cache candidate
PREPARE stmt FROM 'DELETE FROM pc_non_select WHERE id = ?';
SET @id=3;
EXECUTE stmt USING @id;
DEALLOCATE PREPARE stmt;
include/assert.inc [Cached_plan_count does not grow for prepared non-SELECT statements]
include/assert.inc [Cached_plan_hits does not grow for prepared non-SELECT statements]
include/assert.inc [Cached_plan_prevalidations does not grow for prepared non-SELECT statements]
include/assert.inc [Cached_plan_invalidations does not grow for prepared non-SELECT statements]
SET @@session.session_plan_cache = DEFAULT;
DROP TABLE pc_non_select;
