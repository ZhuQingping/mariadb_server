--source include/have_innodb.inc

CREATE TABLE pc_ref_profile (
  id INT NOT NULL,
  c CHAR(10) NOT NULL,
  KEY id_key(id)
) ENGINE=InnoDB;

INSERT INTO pc_ref_profile VALUES
  (1, 'a'), (1, 'b'), (2, 'c'), (3, 'd');

SET @@session.session_plan_cache = ON;
SET @save_ratio=@@session.session_plan_cache_allow_change_ratio;
SET @save_profile=@@session.session_plan_cache_profile;
SET @@session.session_plan_cache_allow_change_ratio = 0;
SET @@session.session_plan_cache_profile = ON;

--disable_query_log
let $hits_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $ref_hits_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_profile_hit_ref_count', Value, 1);
let $ref_build_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_profile_hit_ref_build_us', Value, 1);
let $ref_alloc_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_profile_hit_ref_alloc_us', Value, 1);
let $ref_setup_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_profile_hit_ref_setup_us', Value, 1);
--enable_query_log

PREPARE stmt FROM 'SELECT c FROM pc_ref_profile WHERE id = ?';

--echo # First execution creates the state; later executions are profiled ref hits
SET @id=1;
--disable_result_log
--disable_query_log
EXECUTE stmt USING @id;

let $i= 50;
while ($i)
{
  SET @id=2;
  EXECUTE stmt USING @id;
  SET @id=3;
  EXECUTE stmt USING @id;
  dec $i;
}
--enable_query_log
--enable_result_log

--disable_query_log
let $hits_after= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $ref_hits_after= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_profile_hit_ref_count', Value, 1);
let $ref_build_after= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_profile_hit_ref_build_us', Value, 1);
let $ref_alloc_after= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_profile_hit_ref_alloc_us', Value, 1);
let $ref_setup_after= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_profile_hit_ref_setup_us', Value, 1);

--let $assert_text= profiled ref lookup records repeated cache hits
--let $assert_cond= $hits_after >= $hits_before + 50
--source include/assert.inc

--let $assert_text= profiled ref lookup increments ref hit counter
--let $assert_cond= $ref_hits_after >= $ref_hits_before + 50
--source include/assert.inc

--let $assert_text= profiled ref lookup records aggregate build time
--let $assert_cond= $ref_build_after > $ref_build_before
--source include/assert.inc

--let $assert_text= profiled ref lookup records allocation time
--let $assert_cond= $ref_alloc_after > $ref_alloc_before
--source include/assert.inc

--let $assert_text= profiled ref lookup records setup time
--let $assert_cond= $ref_setup_after > $ref_setup_before
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt;

SET @@session.session_plan_cache_profile = @save_profile;
SET @@session.session_plan_cache_allow_change_ratio = @save_ratio;
SET @@session.session_plan_cache = DEFAULT;
DROP TABLE pc_ref_profile;
