--source include/have_innodb.inc

CREATE TABLE pc_change_user_count (
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;

INSERT INTO pc_change_user_count VALUES (1,10),(2,20);

SET @@session.session_plan_cache = ON;

--disable_query_log
let $count_before= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $invalidations_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_invalidations', Value, 1);
--enable_query_log

PREPARE stmt FROM 'SELECT id FROM pc_change_user_count WHERE id = ?';
SET @p=1;
EXECUTE stmt USING @p;

--disable_query_log
let $count_after_execute= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);

--let $assert_text= Cached_plan_count grows before change_user
--let $assert_cond= $count_after_execute = $count_before + 1
--source include/assert.inc
--enable_query_log

--change_user

--disable_query_log
let $count_after_change_user= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $invalidations_after_change_user= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_invalidations', Value, 1);

--let $assert_text= Cached_plan_count returns to baseline after change_user destroys prepared statements
--let $assert_cond= $count_after_change_user = $count_before
--source include/assert.inc

--let $assert_text= Cached_plan_invalidations does not grow after change_user destroys prepared statements
--let $assert_cond= $invalidations_after_change_user = $invalidations_before
--source include/assert.inc
--enable_query_log

SET @@session.session_plan_cache = DEFAULT;
DROP TABLE pc_change_user_count;
