CREATE TABLE pc_rh_boundary (
id INT NOT NULL PRIMARY KEY,
u INT NOT NULL,
pad CHAR(10),
UNIQUE KEY u_key(u)
) ENGINE=InnoDB;
CREATE TABLE pc_rh_nullable_ddl (
id INT NOT NULL PRIMARY KEY,
u INT NOT NULL,
pad CHAR(10),
UNIQUE KEY u_key(u)
) ENGINE=InnoDB;
CREATE TABLE pc_rh_charset_ddl (
c VARCHAR(20) NOT NULL,
pad CHAR(10),
UNIQUE KEY c_key(c)
) ENGINE=InnoDB DEFAULT CHARSET latin1 COLLATE latin1_swedish_ci;
CREATE TABLE pc_rh_type_boundary (
id INT NOT NULL PRIMARY KEY,
pad CHAR(10)
) ENGINE=InnoDB;
CREATE TABLE pc_rh_secondary_mutation (
id INT NOT NULL PRIMARY KEY,
u INT NOT NULL,
pad CHAR(10),
UNIQUE KEY u_key(u)
) ENGINE=InnoDB;
CREATE TABLE pc_rh_promote_ddl (
id INT NOT NULL PRIMARY KEY,
u INT NOT NULL,
pad CHAR(10),
KEY u_key(u)
) ENGINE=InnoDB;
INSERT INTO pc_rh_boundary VALUES (1, 10, 'a'), (2, 20, 'b');
INSERT INTO pc_rh_nullable_ddl VALUES (1, 100, 'n1'), (2, 200, 'n2');
INSERT INTO pc_rh_charset_ddl VALUES ('m', 'cm'), ('n', 'cn');
INSERT INTO pc_rh_type_boundary VALUES (7, 'seven'), (8, 'eight');
INSERT INTO pc_rh_secondary_mutation VALUES
(1, 1000, 's1'), (2, 2000, 's2');
INSERT INTO pc_rh_promote_ddl VALUES (1, 111, 'p1'), (2, 222, 'p2');
SET @@session.session_plan_cache = ON;
SET @save_ratio= @@session.session_plan_cache_allow_change_ratio;
SET @@session.session_plan_cache_allow_change_ratio = 0;
PREPARE stmt_empty FROM 'SELECT pad FROM pc_rh_boundary WHERE id = ?';
# First execute creates a zero-result state
SET @p=42;
EXECUTE stmt_empty USING @p;
pad
# Inserting the missing row should not reuse the zero-result shape as a hit
INSERT INTO pc_rh_boundary VALUES (42, 420, 'z');
EXECUTE stmt_empty USING @p;
pad
z
# The replacement non-empty state can hit on the next execute
EXECUTE stmt_empty USING @p;
pad
z
include/assert.inc [Cached_plan_count keeps one replacement state after zero-result boundary]
include/assert.inc [Cached_plan_hits grows only after zero-result state replacement]
include/assert.inc [Cached_plan_prevalidations grows only after zero-result replacement]
include/assert.inc [Cached_plan_invalidations does not grow for zero-result no-state boundary]
DEALLOCATE PREPARE stmt_empty;
include/assert.inc [Cached_plan_count returns to baseline after zero-result boundary deallocate]
PREPARE stmt_mutation FROM 'SELECT pad FROM pc_rh_boundary WHERE id = ?';
# Real hits must read current row contents, not stale cached record data
SET @p=1;
EXECUTE stmt_mutation USING @p;
pad
a
UPDATE pc_rh_boundary SET pad='aa' WHERE id=1;
EXECUTE stmt_mutation USING @p;
pad
aa
DELETE FROM pc_rh_boundary WHERE id=1;
EXECUTE stmt_mutation USING @p;
pad
INSERT INTO pc_rh_boundary VALUES (1, 10, 'aaa');
EXECUTE stmt_mutation USING @p;
pad
aaa
UPDATE pc_rh_boundary SET id=3 WHERE id=1;
EXECUTE stmt_mutation USING @p;
pad
SET @p=3;
EXECUTE stmt_mutation USING @p;
pad
aaa
include/assert.inc [Cached_plan_count keeps one state across row mutations when ratio is zero]
include/assert.inc [Cached_plan_hits grows across update delete insert and key-change row-boundary hits]
include/assert.inc [Cached_plan_prevalidations grows across row-boundary hits]
DEALLOCATE PREPARE stmt_mutation;
include/assert.inc [Cached_plan_count returns to baseline after row mutation deallocate]
PREPARE stmt_ddl FROM 'SELECT pad FROM pc_rh_boundary WHERE u = ?';
# Replacing a unique key with a non-unique key should invalidate and rebuild a ref state
SET @p=20;
EXECUTE stmt_ddl USING @p;
pad
b
ALTER TABLE pc_rh_boundary DROP INDEX u_key, ADD INDEX u_key(u);
EXECUTE stmt_ddl USING @p;
pad
b
EXECUTE stmt_ddl USING @p;
pad
b
include/assert.inc [Cached_plan_count keeps a ref state after unique key is replaced by non-unique key]
include/assert.inc [Cached_plan_hits grows after unique key is replaced by non-unique key]
include/assert.inc [Cached_plan_prevalidations grows after unique key is replaced by non-unique key]
include/assert.inc [Cached_plan_invalidations grows after DDL reprepare]
DEALLOCATE PREPARE stmt_ddl;
include/assert.inc [Cached_plan_count returns to baseline after unique-to-ref DDL deallocate]
PREPARE stmt_nullable_ddl FROM
'SELECT pad FROM pc_rh_nullable_ddl WHERE u = ?';
# Making a unique key nullable should invalidate and avoid recipe-less replacement state
SET @p=200;
EXECUTE stmt_nullable_ddl USING @p;
pad
n2
EXECUTE stmt_nullable_ddl USING @p;
pad
n2
ALTER TABLE pc_rh_nullable_ddl MODIFY u INT NULL;
EXECUTE stmt_nullable_ddl USING @p;
pad
n2
EXECUTE stmt_nullable_ddl USING @p;
pad
n2
include/assert.inc [Cached_plan_count returns to baseline after nullable-key DDL]
include/assert.inc [Cached_plan_hits grows only before nullable-key DDL]
include/assert.inc [Cached_plan_prevalidations grows only before nullable-key DDL]
include/assert.inc [Cached_plan_invalidations grows after nullable-key DDL reprepare]
DEALLOCATE PREPARE stmt_nullable_ddl;
PREPARE stmt_charset_ddl FROM
'SELECT pad FROM pc_rh_charset_ddl WHERE c = ?';
# Character metadata DDL should invalidate old string-key state before a new hit is possible
SET @p='m';
EXECUTE stmt_charset_ddl USING @p;
pad
cm
EXECUTE stmt_charset_ddl USING @p;
pad
cm
ALTER TABLE pc_rh_charset_ddl
MODIFY c VARCHAR(30) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci
NOT NULL;
EXECUTE stmt_charset_ddl USING @p;
pad
cm
EXECUTE stmt_charset_ddl USING @p;
pad
cm
include/assert.inc [Cached_plan_count returns to baseline after character metadata DDL]
include/assert.inc [Cached_plan_hits grows only before character metadata DDL]
include/assert.inc [Cached_plan_prevalidations grows only before character metadata DDL]
include/assert.inc [Cached_plan_invalidations grows after character metadata DDL reprepare]
DEALLOCATE PREPARE stmt_charset_ddl;
PREPARE stmt_type FROM 'SELECT pad FROM pc_rh_type_boundary WHERE id = ?';
# Numeric string parameters invalidate the integer shape before a new stable hit
SET @p=7;
EXECUTE stmt_type USING @p;
pad
seven
EXECUTE stmt_type USING @p;
pad
seven
SET @p='7';
EXECUTE stmt_type USING @p;
pad
seven
EXECUTE stmt_type USING @p;
pad
seven
include/assert.inc [Cached_plan_count keeps replacement state after numeric string parameter shape]
include/assert.inc [Cached_plan_hits grows only before numeric string parameter shape]
include/assert.inc [Cached_plan_prevalidations grows only before numeric string parameter shape]
include/assert.inc [Cached_plan_invalidations grows after numeric string parameter shape change]
DEALLOCATE PREPARE stmt_type;
PREPARE stmt_secondary_mutation FROM
'SELECT pad FROM pc_rh_secondary_mutation WHERE u = ?';
# Secondary unique-key mutation must rebuild the lookup key on every hit
SET @p=1000;
EXECUTE stmt_secondary_mutation USING @p;
pad
s1
UPDATE pc_rh_secondary_mutation SET u=3000, pad='s3' WHERE u=1000;
EXECUTE stmt_secondary_mutation USING @p;
pad
SET @p=3000;
EXECUTE stmt_secondary_mutation USING @p;
pad
s3
EXECUTE stmt_secondary_mutation USING @p;
pad
s3
include/assert.inc [Cached_plan_count keeps one state across secondary unique-key mutation]
include/assert.inc [Cached_plan_hits grows across secondary unique old-key and new-key lookups]
include/assert.inc [Cached_plan_prevalidations grows across secondary unique-key mutation hits]
include/assert.inc [Cached_plan_invalidations does not grow for secondary unique-key row mutation]
DEALLOCATE PREPARE stmt_secondary_mutation;
PREPARE stmt_promote_ddl FROM
'SELECT pad FROM pc_rh_promote_ddl WHERE u = ?';
# Promoting a non-unique key to UNIQUE should invalidate ref state and rebuild unique state
SET @p=111;
EXECUTE stmt_promote_ddl USING @p;
pad
p1
EXECUTE stmt_promote_ddl USING @p;
pad
p1
ALTER TABLE pc_rh_promote_ddl DROP INDEX u_key, ADD UNIQUE KEY u_key(u);
EXECUTE stmt_promote_ddl USING @p;
pad
p1
SET @p=222;
EXECUTE stmt_promote_ddl USING @p;
pad
p2
SET @p=111;
EXECUTE stmt_promote_ddl USING @p;
pad
p1
include/assert.inc [Cached_plan_count keeps replacement state after non-unique key is promoted to unique]
include/assert.inc [Cached_plan_hits grows across ref and unique states after promotion DDL]
include/assert.inc [Cached_plan_prevalidations grows across ref and unique states after promotion DDL]
include/assert.inc [Cached_plan_invalidations grows after non-unique key is promoted to unique]
DEALLOCATE PREPARE stmt_promote_ddl;
include/assert.inc [Cached_plan_count returns to baseline after boundary tests]
SET @@session.session_plan_cache_allow_change_ratio = @save_ratio;
SET @@session.session_plan_cache = DEFAULT;
DROP TABLE pc_rh_boundary;
DROP TABLE pc_rh_nullable_ddl;
DROP TABLE pc_rh_charset_ddl;
DROP TABLE pc_rh_type_boundary;
DROP TABLE pc_rh_secondary_mutation;
DROP TABLE pc_rh_promote_ddl;
