--source include/have_innodb.inc

CREATE TABLE pc_real_hit_pk (
  id INT NOT NULL PRIMARY KEY,
  uq INT NOT NULL,
  pad CHAR(10),
  UNIQUE KEY uq_key(uq)
) ENGINE=InnoDB;
INSERT INTO pc_real_hit_pk VALUES (1, 10, 'a'), (2, 20, 'b');

CREATE TABLE pc_real_hit_nullable (
  id INT,
  pad CHAR(10),
  UNIQUE KEY id_uq(id)
) ENGINE=InnoDB;
INSERT INTO pc_real_hit_nullable VALUES (1, 'a'), (NULL, 'n');

CREATE TABLE pc_real_hit_nonunique (
  id INT NOT NULL,
  pad CHAR(10),
  KEY id_key(id)
) ENGINE=InnoDB;
INSERT INTO pc_real_hit_nonunique VALUES (1, 'a'), (1, 'a2'), (2, 'b');

CREATE TABLE pc_real_hit_multi (
  tenant_id INT NOT NULL,
  id INT NOT NULL,
  pad CHAR(10),
  UNIQUE KEY tenant_id_uq(tenant_id, id)
) ENGINE=InnoDB;
INSERT INTO pc_real_hit_multi VALUES (10, 1, 'a'), (10, 2, 'b');

CREATE TABLE pc_real_hit_char (
  c VARCHAR(20) NOT NULL,
  pad CHAR(10),
  UNIQUE KEY c_uq(c)
) ENGINE=InnoDB DEFAULT CHARSET latin1 COLLATE latin1_swedish_ci;
INSERT INTO pc_real_hit_char VALUES ('a', 'ca'), ('b', 'cb');

SET @@session.session_plan_cache = ON;
SET @save_ratio=@@session.session_plan_cache_allow_change_ratio;
SET @@session.session_plan_cache_allow_change_ratio = 0;

--disable_query_log
let $count_before= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);
let $handler_read_key_before= query_get_value(SHOW SESSION STATUS LIKE 'Handler_read_key', Value, 1);
let $handler_read_next_before= query_get_value(SHOW SESSION STATUS LIKE 'Handler_read_next', Value, 1);
let $handler_read_rnd_next_before= query_get_value(SHOW SESSION STATUS LIKE 'Handler_read_rnd_next', Value, 1);
--enable_query_log

PREPARE stmt_pk FROM 'SELECT pad FROM pc_real_hit_pk WHERE id = ?';

--echo # First execute creates state but does not count a cache hit
SET @p=1;
EXECUTE stmt_pk USING @p;

--echo # Later eligible executes should use the real unique-equality hit path
SET @p=2;
EXECUTE stmt_pk USING @p;
SET @p=42;
EXECUTE stmt_pk USING @p;
SET @p=1;
EXECUTE stmt_pk USING @p;

--disable_query_log
let $count_after_pk= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_pk= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_pk= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);
let $handler_read_key_after_pk= query_get_value(SHOW SESSION STATUS LIKE 'Handler_read_key', Value, 1);
let $handler_read_next_after_pk= query_get_value(SHOW SESSION STATUS LIKE 'Handler_read_next', Value, 1);
let $handler_read_rnd_next_after_pk= query_get_value(SHOW SESSION STATUS LIKE 'Handler_read_rnd_next', Value, 1);

--let $assert_text= Cached_plan_count keeps one real-hit state for primary-key lookup
--let $assert_cond= $count_after_pk = $count_before + 1
--source include/assert.inc

--let $assert_text= Cached_plan_prevalidations grows before primary-key real hits
--let $assert_cond= $prevalidations_after_pk = $prevalidations_before + 3
--source include/assert.inc

--let $assert_text= Cached_plan_hits grows for repeated primary-key real hits
--let $assert_cond= $hits_after_pk = $hits_before + 3
--source include/assert.inc

--let $assert_text= Handler_read_key grows for primary-key point lookups
--let $assert_cond= $handler_read_key_after_pk >= $handler_read_key_before + 4
--source include/assert.inc

--let $assert_text= Handler_read_next does not grow for primary-key point lookups
--let $assert_cond= $handler_read_next_after_pk = $handler_read_next_before
--source include/assert.inc

--let $assert_text= Handler_read_rnd_next does not grow for primary-key point lookups
--let $assert_cond= $handler_read_rnd_next_after_pk = $handler_read_rnd_next_before
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt_pk;

PREPARE stmt_unique FROM 'SELECT pad FROM pc_real_hit_pk WHERE uq = ?';

--echo # Non-null unique secondary lookup should use the same real hit path
SET @p=10;
EXECUTE stmt_unique USING @p;
SET @p=20;
EXECUTE stmt_unique USING @p;
SET @p=99;
EXECUTE stmt_unique USING @p;

--disable_query_log
let $count_after_unique= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_unique= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_unique= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= Cached_plan_count keeps one real-hit state for unique secondary lookup
--let $assert_cond= $count_after_unique = $count_before + 1
--source include/assert.inc

--let $assert_text= Cached_plan_prevalidations grows before unique secondary real hits
--let $assert_cond= $prevalidations_after_unique = $prevalidations_after_pk + 2
--source include/assert.inc

--let $assert_text= Cached_plan_hits grows for repeated unique secondary real hits
--let $assert_cond= $hits_after_unique = $hits_after_pk + 2
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt_unique;

PREPARE stmt_reverse FROM 'SELECT pad FROM pc_real_hit_pk WHERE ? = id';

--echo # Reversed equality is eligible for real hits
SET @p=1;
EXECUTE stmt_reverse USING @p;
SET @p=2;
EXECUTE stmt_reverse USING @p;

--disable_query_log
let $hits_after_reverse= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_reverse= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= Cached_plan_prevalidations grows before reversed real hit
--let $assert_cond= $prevalidations_after_reverse = $prevalidations_after_unique + 1
--source include/assert.inc

--let $assert_text= Cached_plan_hits grows for reversed real hit
--let $assert_cond= $hits_after_reverse = $hits_after_unique + 1
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt_reverse;

PREPARE stmt_char FROM 'SELECT pad FROM pc_real_hit_char WHERE c = ?';

--echo # Stable string unique lookup should use the real hit path
SET @p='a';
EXECUTE stmt_char USING @p;
SET @p='b';
EXECUTE stmt_char USING @p;

--disable_query_log
let $hits_after_char= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_char= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= Cached_plan_prevalidations grows before string unique real hit
--let $assert_cond= $prevalidations_after_char = $prevalidations_after_reverse + 1
--source include/assert.inc

--let $assert_text= Cached_plan_hits grows for string unique real hit
--let $assert_cond= $hits_after_char = $hits_after_reverse + 1
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt_char;

--disable_query_log
let $invalidations_before_select_param= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_invalidations', Value, 1);
--enable_query_log

PREPARE stmt_select_param FROM
  'SELECT pad, ? AS marker FROM pc_real_hit_pk WHERE id = ?';

--echo # SELECT-list parameters must refresh on each real hit
SET @m='m1';
SET @p=1;
EXECUTE stmt_select_param USING @m, @p;
SET @m='m2';
SET @p=2;
EXECUTE stmt_select_param USING @m, @p;
SET @m='m3';
SET @p=1;
EXECUTE stmt_select_param USING @m, @p;

--echo # Non-WHERE parameter shape changes invalidate and stay off stale hits
SET @m=100;
SET @p=2;
EXECUTE stmt_select_param USING @m, @p;
SET @m=200;
SET @p=1;
EXECUTE stmt_select_param USING @m, @p;
SET @m=300;
SET @p=2;
EXECUTE stmt_select_param USING @m, @p;

--disable_query_log
let $count_after_select_param= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_select_param= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_select_param= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);
let $invalidations_after_select_param= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_invalidations', Value, 1);

--let $assert_text= Cached_plan_count keeps one replacement state for SELECT-list parameter refresh
--let $assert_cond= $count_after_select_param = $count_before + 1
--source include/assert.inc

--let $assert_text= Cached_plan_hits grows for same-shape SELECT-list parameter refresh and replacement recache
--let $assert_cond= $hits_after_select_param = $hits_after_char + 3
--source include/assert.inc

--let $assert_text= Cached_plan_prevalidations grows for same-shape SELECT-list parameter refresh and replacement recache
--let $assert_cond= $prevalidations_after_select_param = $prevalidations_after_char + 3
--source include/assert.inc

--let $assert_text= Cached_plan_invalidations grows after SELECT-list parameter shape change
--let $assert_cond= $invalidations_after_select_param = $invalidations_before_select_param + 1
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt_select_param;

PREPARE stmt_output_shapes FROM
  'SELECT *, id AS id_alias, pad AS pad_alias, id + 10 AS id_plus, CAST(pad AS CHAR(10)) AS pad_cast, ''tag'' AS tag FROM pc_real_hit_pk WHERE id = ?';

--echo # Real hits must preserve current row output for star, aliases, constants, and expressions
SET @p=1;
EXECUTE stmt_output_shapes USING @p;
UPDATE pc_real_hit_pk SET pad='aa' WHERE id=1;
SET @p=2;
EXECUTE stmt_output_shapes USING @p;
SET @p=1;
EXECUTE stmt_output_shapes USING @p;
UPDATE pc_real_hit_pk SET pad='a' WHERE id=1;

--disable_query_log
let $count_after_output_shapes= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_output_shapes= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_output_shapes= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);
let $invalidations_after_output_shapes= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_invalidations', Value, 1);

--let $assert_text= Cached_plan_count keeps one state for expanded SELECT output shapes
--let $assert_cond= $count_after_output_shapes = $count_before + 1
--source include/assert.inc

--let $assert_text= Cached_plan_hits grows for expanded SELECT output shapes
--let $assert_cond= $hits_after_output_shapes = $hits_after_select_param + 2
--source include/assert.inc

--let $assert_text= Cached_plan_prevalidations grows for expanded SELECT output shapes
--let $assert_cond= $prevalidations_after_output_shapes = $prevalidations_after_select_param + 2
--source include/assert.inc

--let $assert_text= Cached_plan_invalidations does not grow for expanded SELECT output shapes
--let $assert_cond= $invalidations_after_output_shapes = $invalidations_after_select_param
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt_output_shapes;

PREPARE stmt_null FROM 'SELECT pad FROM pc_real_hit_pk WHERE id = ?';

--echo # NULL parameter remains fail-closed and must not count as a hit
SET @p=1;
EXECUTE stmt_null USING @p;
SET @p=NULL;
EXECUTE stmt_null USING @p;

--disable_query_log
let $hits_after_null= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_null= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= Cached_plan_hits does not grow for NULL real-hit candidate
--let $assert_cond= $hits_after_null = $hits_after_output_shapes
--source include/assert.inc

--let $assert_text= Cached_plan_prevalidations does not grow for NULL real-hit candidate
--let $assert_cond= $prevalidations_after_null = $prevalidations_after_output_shapes
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt_null;

PREPARE stmt_nullable FROM
  'SELECT pad FROM pc_real_hit_nullable WHERE id = ?';

--echo # Nullable unique key remains fail-closed for real hits
SET @p=1;
EXECUTE stmt_nullable USING @p;
SET @p=1;
EXECUTE stmt_nullable USING @p;

--disable_query_log
let $hits_after_nullable= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_nullable= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= Cached_plan_hits does not grow for nullable unique real-hit candidate
--let $assert_cond= $hits_after_nullable = $hits_after_null
--source include/assert.inc

--let $assert_text= Cached_plan_prevalidations does not grow for nullable unique real-hit candidate
--let $assert_cond= $prevalidations_after_nullable = $prevalidations_after_null
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt_nullable;

PREPARE stmt_nonunique FROM
  'SELECT pad FROM pc_real_hit_nonunique WHERE id = ?';

--echo # Non-unique key is now covered by the ref real-hit path
SET @p=1;
EXECUTE stmt_nonunique USING @p;
SET @p=2;
EXECUTE stmt_nonunique USING @p;

--disable_query_log
let $hits_after_nonunique= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_nonunique= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= Cached_plan_hits grows for non-unique ref real-hit candidate
--let $assert_cond= $hits_after_nonunique = $hits_after_nullable + 1
--source include/assert.inc

--let $assert_text= Cached_plan_prevalidations grows for non-unique ref real-hit candidate
--let $assert_cond= $prevalidations_after_nonunique = $prevalidations_after_nullable + 1
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt_nonunique;

PREPARE stmt_multi_full FROM
  'SELECT pad FROM pc_real_hit_multi WHERE tenant_id = ? AND id = ?';

--echo # Full multi-part unique equality remains fail-closed for real hits
SET @p=10;
SET @q=1;
EXECUTE stmt_multi_full USING @p, @q;
SET @p=10;
SET @q=2;
EXECUTE stmt_multi_full USING @p, @q;

--disable_query_log
let $hits_after_multi_full= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_multi_full= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= Cached_plan_hits does not grow for full multi-part real-hit candidate
--let $assert_cond= $hits_after_multi_full = $hits_after_nonunique
--source include/assert.inc

--let $assert_text= Cached_plan_prevalidations does not grow for full multi-part real-hit candidate
--let $assert_cond= $prevalidations_after_multi_full = $prevalidations_after_nonunique
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt_multi_full;

PREPARE stmt_multi_first_partial FROM
  'SELECT pad FROM pc_real_hit_multi WHERE tenant_id = ?';

--echo # First keypart of multi-part unique equality remains fail-closed for real hits
SET @p=10;
EXECUTE stmt_multi_first_partial USING @p;
SET @p=20;
EXECUTE stmt_multi_first_partial USING @p;

--disable_query_log
let $hits_after_multi_first_partial= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
