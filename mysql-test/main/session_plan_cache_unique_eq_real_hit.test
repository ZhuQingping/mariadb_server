PREPARE stmt_subquery FROM
  'SELECT pad, (SELECT MAX(uq) FROM pc_real_hit_pk) FROM pc_real_hit_pk WHERE id = ?';

--echo # Scalar subquery remains fail-closed for real hits
SET @p=1;
EXECUTE stmt_subquery USING @p;
SET @p=2;
EXECUTE stmt_subquery USING @p;

--disable_query_log
