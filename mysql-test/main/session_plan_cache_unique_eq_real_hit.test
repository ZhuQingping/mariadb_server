SET @p=1;
EXECUTE stmt_having USING @p;
SET @p=2;
EXECUTE stmt_having USING @p;

--disable_query_log
let $hits_after_having= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_having= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= Cached_plan_hits does not grow for HAVING real-hit candidate
--let $assert_cond= $hits_after_having = $hits_after_limit_comma_zero
--source include/assert.inc

--let $assert_text= Cached_plan_prevalidations does not grow for HAVING real-hit candidate
--let $assert_cond= $prevalidations_after_having = $prevalidations_after_limit_comma_zero
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt_having;

SET @save_character_set_client= @@session.character_set_client;
SET @save_character_set_connection= @@session.character_set_connection;
SET @save_character_set_results= @@session.character_set_results;

SET NAMES latin1;
PREPARE stmt_charset FROM
  'SELECT pad FROM pc_real_hit_char WHERE c = ?';

--echo # Charset change invalidates an otherwise eligible string unique lookup
SET @p='a';
EXECUTE stmt_charset USING @p;
SET NAMES utf8;
SET @p='b';
EXECUTE stmt_charset USING @p;

--disable_query_log
let $hits_after_charset= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_charset= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= Cached_plan_hits does not grow across charset invalidation
--let $assert_cond= $hits_after_charset = $hits_after_having
--source include/assert.inc

--let $assert_text= Cached_plan_prevalidations does not grow across charset invalidation
--let $assert_cond= $prevalidations_after_charset = $prevalidations_after_having
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt_charset;
SET @@session.character_set_client= @save_character_set_client;
SET @@session.character_set_connection= @save_character_set_connection;
SET @@session.character_set_results= @save_character_set_results;

--disable_query_log
let $count_after_deallocate= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);

--let $assert_text= Cached_plan_count returns to baseline after real-hit deallocates
--let $assert_cond= $count_after_deallocate = $count_before
--source include/assert.inc
--enable_query_log

SET @@session.session_plan_cache_allow_change_ratio = @save_ratio;
SET @@session.session_plan_cache = DEFAULT;

DROP TABLE pc_real_hit_pk;
DROP TABLE pc_real_hit_nullable;
DROP TABLE pc_real_hit_nonunique;
DROP TABLE pc_real_hit_multi;
DROP TABLE pc_real_hit_char;
