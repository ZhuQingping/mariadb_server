--let $assert_cond= $hits_after_multi_const_param = $hits_after_multi_first_partial
--source include/assert.inc

--let $assert_text= Cached_plan_prevalidations does not grow for const-param multi-part real-hit candidate
--let $assert_cond= $prevalidations_after_multi_const_param = $prevalidations_after_multi_first_partial
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt_multi_const_param;

PREPARE stmt_range FROM 'SELECT pad FROM pc_real_hit_pk WHERE id > ?';

