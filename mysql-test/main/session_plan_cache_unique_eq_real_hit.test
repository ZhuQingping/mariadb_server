--let $assert_text= Cached_plan_hits does not grow for first-keypart multi-part real-hit candidate
--let $assert_cond= $hits_after_multi_first_partial = $hits_after_multi_full
--source include/assert.inc

--let $assert_text= Cached_plan_prevalidations does not grow for first-keypart multi-part real-hit candidate
--let $assert_cond= $prevalidations_after_multi_first_partial = $prevalidations_after_multi_full
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt_multi_first_partial;

