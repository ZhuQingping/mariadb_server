include/assert.inc [Cached_plan_hits grows for string unique real hit]
DEALLOCATE PREPARE stmt_char;
PREPARE stmt_select_param FROM
'SELECT pad, ? AS marker FROM pc_real_hit_pk WHERE id = ?';
# SELECT-list parameters must refresh on each real hit
SET @m='m1';
SET @p=1;
EXECUTE stmt_select_param USING @m, @p;
pad	marker
a	m1
SET @m='m2';
SET @p=2;
EXECUTE stmt_select_param USING @m, @p;
pad	marker
b	m2
SET @m='m3';
SET @p=1;
EXECUTE stmt_select_param USING @m, @p;
pad	marker
a	m3
# Non-WHERE parameter shape changes invalidate and stay off stale hits
SET @m=100;
SET @p=2;
EXECUTE stmt_select_param USING @m, @p;
pad	marker
b	100
SET @m=200;
SET @p=1;
EXECUTE stmt_select_param USING @m, @p;
pad	marker
a	200
SET @m=300;
SET @p=2;
EXECUTE stmt_select_param USING @m, @p;
pad	marker
b	300
include/assert.inc [Cached_plan_count keeps one replacement state for SELECT-list parameter refresh]
include/assert.inc [Cached_plan_hits grows for same-shape SELECT-list parameter refresh and replacement recache]
include/assert.inc [Cached_plan_prevalidations grows for same-shape SELECT-list parameter refresh and replacement recache]
include/assert.inc [Cached_plan_invalidations grows after SELECT-list parameter shape change]
DEALLOCATE PREPARE stmt_select_param;
PREPARE stmt_output_shapes FROM
'SELECT *, id AS id_alias, pad AS pad_alias, id + 10 AS id_plus, CAST(pad AS CHAR(10)) AS pad_cast, ''tag'' AS tag FROM pc_real_hit_pk WHERE id = ?';
# Real hits must preserve current row output for star, aliases, constants, and expressions
SET @p=1;
EXECUTE stmt_output_shapes USING @p;
id	uq	pad	id_alias	pad_alias	id_plus	pad_cast	tag
1	10	a	1	a	11	a	tag
UPDATE pc_real_hit_pk SET pad='aa' WHERE id=1;
SET @p=2;
EXECUTE stmt_output_shapes USING @p;
id	uq	pad	id_alias	pad_alias	id_plus	pad_cast	tag
2	20	b	2	b	12	b	tag
SET @p=1;
EXECUTE stmt_output_shapes USING @p;
id	uq	pad	id_alias	pad_alias	id_plus	pad_cast	tag
1	10	aa	1	aa	11	aa	tag
UPDATE pc_real_hit_pk SET pad='a' WHERE id=1;
include/assert.inc [Cached_plan_count keeps one state for expanded SELECT output shapes]
include/assert.inc [Cached_plan_hits grows for expanded SELECT output shapes]
include/assert.inc [Cached_plan_prevalidations grows for expanded SELECT output shapes]
include/assert.inc [Cached_plan_invalidations does not grow for expanded SELECT output shapes]
DEALLOCATE PREPARE stmt_output_shapes;
