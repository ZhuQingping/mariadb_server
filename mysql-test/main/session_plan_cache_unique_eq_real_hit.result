CREATE TABLE pc_real_hit_pk (
id INT NOT NULL PRIMARY KEY,
uq INT NOT NULL,
pad CHAR(10),
UNIQUE KEY uq_key(uq)
) ENGINE=InnoDB;
INSERT INTO pc_real_hit_pk VALUES (1, 10, 'a'), (2, 20, 'b');
CREATE TABLE pc_real_hit_nullable (
id INT,
pad CHAR(10),
UNIQUE KEY id_uq(id)
) ENGINE=InnoDB;
INSERT INTO pc_real_hit_nullable VALUES (1, 'a'), (NULL, 'n');
CREATE TABLE pc_real_hit_nonunique (
id INT NOT NULL,
pad CHAR(10),
KEY id_key(id)
) ENGINE=InnoDB;
INSERT INTO pc_real_hit_nonunique VALUES (1, 'a'), (1, 'a2'), (2, 'b');
CREATE TABLE pc_real_hit_multi (
tenant_id INT NOT NULL,
id INT NOT NULL,
pad CHAR(10),
UNIQUE KEY tenant_id_uq(tenant_id, id)
) ENGINE=InnoDB;
INSERT INTO pc_real_hit_multi VALUES (10, 1, 'a'), (10, 2, 'b');
CREATE TABLE pc_real_hit_char (
c VARCHAR(20) NOT NULL,
pad CHAR(10),
UNIQUE KEY c_uq(c)
) ENGINE=InnoDB DEFAULT CHARSET latin1 COLLATE latin1_swedish_ci;
INSERT INTO pc_real_hit_char VALUES ('a', 'ca'), ('b', 'cb');
SET @@session.session_plan_cache = ON;
SET @save_ratio=@@session.session_plan_cache_allow_change_ratio;
SET @@session.session_plan_cache_allow_change_ratio = 0;
PREPARE stmt_pk FROM 'SELECT pad FROM pc_real_hit_pk WHERE id = ?';
# First execute creates state but does not count a cache hit
SET @p=1;
EXECUTE stmt_pk USING @p;
pad
a
# Later eligible executes should use the real unique-equality hit path
SET @p=2;
EXECUTE stmt_pk USING @p;
pad
b
SET @p=42;
EXECUTE stmt_pk USING @p;
pad
SET @p=1;
EXECUTE stmt_pk USING @p;
pad
a
include/assert.inc [Cached_plan_count keeps one real-hit state for primary-key lookup]
include/assert.inc [Cached_plan_prevalidations grows before primary-key real hits]
include/assert.inc [Cached_plan_hits grows for repeated primary-key real hits]
include/assert.inc [Handler_read_key grows for primary-key point lookups]
include/assert.inc [Handler_read_next does not grow for primary-key point lookups]
include/assert.inc [Handler_read_rnd_next does not grow for primary-key point lookups]
DEALLOCATE PREPARE stmt_pk;
PREPARE stmt_unique FROM 'SELECT pad FROM pc_real_hit_pk WHERE uq = ?';
# Non-null unique secondary lookup should use the same real hit path
SET @p=10;
EXECUTE stmt_unique USING @p;
pad
a
SET @p=20;
EXECUTE stmt_unique USING @p;
pad
b
SET @p=99;
EXECUTE stmt_unique USING @p;
pad
include/assert.inc [Cached_plan_count keeps one real-hit state for unique secondary lookup]
include/assert.inc [Cached_plan_prevalidations grows before unique secondary real hits]
include/assert.inc [Cached_plan_hits grows for repeated unique secondary real hits]
DEALLOCATE PREPARE stmt_unique;
PREPARE stmt_reverse FROM 'SELECT pad FROM pc_real_hit_pk WHERE ? = id';
# Reversed equality is eligible for real hits
SET @p=1;
EXECUTE stmt_reverse USING @p;
pad
a
SET @p=2;
EXECUTE stmt_reverse USING @p;
pad
b
include/assert.inc [Cached_plan_prevalidations grows before reversed real hit]
include/assert.inc [Cached_plan_hits grows for reversed real hit]
DEALLOCATE PREPARE stmt_reverse;
PREPARE stmt_char FROM 'SELECT pad FROM pc_real_hit_char WHERE c = ?';
# Stable string unique lookup should use the real hit path
