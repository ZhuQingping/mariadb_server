include/assert.inc [Cached_plan_prevalidations does not grow for LIMIT ROWS EXAMINED real-hit candidate]
DEALLOCATE PREPARE stmt_limit_rows_examined;
PREPARE stmt_limit_rows_examined_param FROM
'SELECT pad FROM pc_real_hit_pk WHERE id = ? LIMIT ROWS EXAMINED ?';
# Parameterized LIMIT ROWS EXAMINED remains fail-closed for real hits
SET @p=1;
SET @q=1000;
EXECUTE stmt_limit_rows_examined_param USING @p, @q;
pad
a
SET @p=2;
EXECUTE stmt_limit_rows_examined_param USING @p, @q;
pad
b
include/assert.inc [Cached_plan_hits does not grow for parameterized LIMIT ROWS EXAMINED real-hit candidate]
include/assert.inc [Cached_plan_prevalidations does not grow for parameterized LIMIT ROWS EXAMINED real-hit candidate]
DEALLOCATE PREPARE stmt_limit_rows_examined_param;
PREPARE stmt_limit_one_rows_examined FROM
'SELECT pad FROM pc_real_hit_pk WHERE id = ? LIMIT 1 ROWS EXAMINED 1000';
# LIMIT 1 ROWS EXAMINED remains fail-closed for real hits
SET @p=1;
EXECUTE stmt_limit_one_rows_examined USING @p;
pad
a
SET @p=2;
EXECUTE stmt_limit_one_rows_examined USING @p;
pad
b
include/assert.inc [Cached_plan_hits does not grow for LIMIT 1 ROWS EXAMINED real-hit candidate]
include/assert.inc [Cached_plan_prevalidations does not grow for LIMIT 1 ROWS EXAMINED real-hit candidate]
DEALLOCATE PREPARE stmt_limit_one_rows_examined;
PREPARE stmt_limit_comma_zero FROM
'SELECT pad FROM pc_real_hit_pk WHERE id = ? LIMIT 0, 1';
# Zero comma-offset syntax remains fail-closed for real hits
SET @p=1;
EXECUTE stmt_limit_comma_zero USING @p;
pad
a
SET @p=2;
EXECUTE stmt_limit_comma_zero USING @p;
pad
b
include/assert.inc [Cached_plan_hits does not grow for LIMIT zero comma-offset real-hit candidate]
include/assert.inc [Cached_plan_prevalidations does not grow for LIMIT zero comma-offset real-hit candidate]
DEALLOCATE PREPARE stmt_limit_comma_zero;
PREPARE stmt_having FROM
'SELECT pad FROM pc_real_hit_pk WHERE id = ? HAVING pad IS NOT NULL';
# HAVING remains fail-closed for real hits
SET @p=1;
EXECUTE stmt_having USING @p;
pad
a
SET @p=2;
EXECUTE stmt_having USING @p;
pad
b
include/assert.inc [Cached_plan_hits does not grow for HAVING real-hit candidate]
include/assert.inc [Cached_plan_prevalidations does not grow for HAVING real-hit candidate]
DEALLOCATE PREPARE stmt_having;
SET @save_character_set_client= @@session.character_set_client;
SET @save_character_set_connection= @@session.character_set_connection;
SET @save_character_set_results= @@session.character_set_results;
SET NAMES latin1;
PREPARE stmt_charset FROM
'SELECT pad FROM pc_real_hit_char WHERE c = ?';
# Charset change invalidates an otherwise eligible string unique lookup
SET @p='a';
EXECUTE stmt_charset USING @p;
pad
ca
SET NAMES utf8;
SET @p='b';
EXECUTE stmt_charset USING @p;
pad
cb
include/assert.inc [Cached_plan_hits does not grow across charset invalidation]
include/assert.inc [Cached_plan_prevalidations does not grow across charset invalidation]
DEALLOCATE PREPARE stmt_charset;
SET @@session.character_set_client= @save_character_set_client;
SET @@session.character_set_connection= @save_character_set_connection;
SET @@session.character_set_results= @save_character_set_results;
include/assert.inc [Cached_plan_count returns to baseline after real-hit deallocates]
SET @@session.session_plan_cache_allow_change_ratio = @save_ratio;
SET @@session.session_plan_cache = DEFAULT;
DROP TABLE pc_real_hit_pk;
DROP TABLE pc_real_hit_nullable;
DROP TABLE pc_real_hit_nonunique;
DROP TABLE pc_real_hit_multi;
DROP TABLE pc_real_hit_char;
