--source include/assert.inc

--let $assert_text= Cached_plan_prevalidations grows after table info hook is cleared
--let $assert_cond= $prevalidations_after_table_info_recovery = $prevalidations_after_table_info_fail + 1
--source include/assert.inc

--let $assert_text= Cached_plan_invalidations does not grow after table info hook is cleared
--let $assert_cond= $invalidations_after_table_info_recovery = $invalidations_after_table_info_fail
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt_table_info_fail;

--disable_query_log
let $count_after_table_info_deallocate= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);

--let $assert_text= Cached_plan_count returns to baseline after table info fault test
--let $assert_cond= $count_after_table_info_deallocate = $count_before
--source include/assert.inc
--enable_query_log

SET @@session.debug_dbug=@save_debug;
SET @@session.session_plan_cache_allow_change_ratio = @save_ratio;
SET @@session.session_plan_cache = DEFAULT;
DROP TABLE pc_debug_distinct;
DROP TABLE pc_debug_fault;
