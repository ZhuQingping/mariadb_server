--source include/have_debug.inc
--source include/have_innodb.inc

CREATE TABLE pc_debug_fault (
  id INT NOT NULL PRIMARY KEY,
  pad CHAR(10)
) ENGINE=InnoDB;
INSERT INTO pc_debug_fault VALUES (1, 'a'), (2, 'b'), (3, 'c');

CREATE TABLE pc_debug_distinct (
  id INT NOT NULL PRIMARY KEY,
  c CHAR(10)
) ENGINE=InnoDB;
INSERT INTO pc_debug_distinct VALUES
  (1, 'c3'), (2, 'c1'), (3, 'c2'), (4, 'c1');

SET @@session.session_plan_cache = ON;
SET @save_ratio=@@session.session_plan_cache_allow_change_ratio;
SET @@session.session_plan_cache_allow_change_ratio = 0;
SET @save_debug=@@session.debug_dbug;

--disable_query_log
let $count_before= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);
--enable_query_log

--echo # Injected state allocation failure should execute normally without caching
PREPARE stmt_state_fail FROM 'SELECT pad FROM pc_debug_fault WHERE id = ?';
SET @p=1;
SET @@session.debug_dbug='+d,session_plan_cache_state_alloc_fail';
EXECUTE stmt_state_fail USING @p;
SET @@session.debug_dbug=@save_debug;

--disable_query_log
let $count_after_state_fail= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_state_fail= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_state_fail= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= Cached_plan_count does not grow after injected state allocation failure
--let $assert_cond= $count_after_state_fail = $count_before
--source include/assert.inc

--let $assert_text= Cached_plan_hits does not grow after injected state allocation failure
--let $assert_cond= $hits_after_state_fail = $hits_before
--source include/assert.inc

--let $assert_text= Cached_plan_prevalidations does not grow before state exists
--let $assert_cond= $prevalidations_after_state_fail = $prevalidations_before
--source include/assert.inc
--enable_query_log

--echo # Clearing the hook should allow the same shape to cache and hit normally
SET @p=2;
EXECUTE stmt_state_fail USING @p;
SET @p=3;
EXECUTE stmt_state_fail USING @p;

--disable_query_log
let $count_after_state_recovery= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_state_recovery= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_state_recovery= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= Cached_plan_count grows after state allocation hook is cleared
--let $assert_cond= $count_after_state_recovery = $count_before + 1
--source include/assert.inc

--let $assert_text= Cached_plan_hits grows after state allocation hook is cleared
--let $assert_cond= $hits_after_state_recovery = $hits_after_state_fail + 1
--source include/assert.inc

--let $assert_text= Cached_plan_prevalidations grows after state allocation hook is cleared
--let $assert_cond= $prevalidations_after_state_recovery = $prevalidations_after_state_fail + 1
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt_state_fail;

--disable_query_log
let $count_after_first_deallocate= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);

--let $assert_text= Cached_plan_count returns to baseline after state allocation fault test
--let $assert_cond= $count_after_first_deallocate = $count_before
--source include/assert.inc
--enable_query_log

--echo # Injected hit-path failure should fall back without counting a hit
PREPARE stmt_hit_fail FROM 'SELECT pad FROM pc_debug_fault WHERE id = ?';
SET @p=1;
EXECUTE stmt_hit_fail USING @p;
SET @p=2;
EXECUTE stmt_hit_fail USING @p;

--disable_query_log
let $count_before_hit_fail= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_before_hit_fail= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_before_hit_fail= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= Cached_plan_count has one state before hit-path fault injection
--let $assert_cond= $count_before_hit_fail = $count_before + 1
--source include/assert.inc
--enable_query_log

SET @p=3;
SET @@session.debug_dbug='+d,session_plan_cache_hit_path_fail';
EXECUTE stmt_hit_fail USING @p;
SET @@session.debug_dbug=@save_debug;

--disable_query_log
let $count_after_hit_fail= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_hit_fail= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_hit_fail= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= Cached_plan_count remains stable after injected hit-path failure
--let $assert_cond= $count_after_hit_fail = $count_before_hit_fail
--source include/assert.inc

--let $assert_text= Cached_plan_hits does not grow for injected hit-path failure
--let $assert_cond= $hits_after_hit_fail = $hits_before_hit_fail
--source include/assert.inc

--let $assert_text= Cached_plan_prevalidations records the attempted hit-path fallback
--let $assert_cond= $prevalidations_after_hit_fail = $prevalidations_before_hit_fail + 1
--source include/assert.inc
--enable_query_log

--echo # Clearing the hit-path hook should restore normal hits
SET @p=1;
EXECUTE stmt_hit_fail USING @p;

--disable_query_log
let $count_after_hit_recovery= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_hit_recovery= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_hit_recovery= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= Cached_plan_count remains stable after hit-path hook is cleared
--let $assert_cond= $count_after_hit_recovery = $count_before_hit_fail
--source include/assert.inc

--let $assert_text= Cached_plan_hits grows after hit-path hook is cleared
--let $assert_cond= $hits_after_hit_recovery = $hits_after_hit_fail + 1
--source include/assert.inc

--let $assert_text= Cached_plan_prevalidations grows after hit-path hook is cleared
--let $assert_cond= $prevalidations_after_hit_recovery = $prevalidations_after_hit_fail + 1
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt_hit_fail;

--disable_query_log
let $count_after_final_deallocate= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);

--let $assert_text= Cached_plan_count returns to baseline after hit-path fault test
--let $assert_cond= $count_after_final_deallocate = $count_before
--source include/assert.inc
--enable_query_log

