CREATE TABLE pc_env (
  id INT PRIMARY KEY,
  c VARCHAR(20),
  KEY(c)
) ENGINE=MyISAM;

INSERT INTO pc_env VALUES (1,'a'),(2,'b'),(3,'c');

SET @save_optimizer_switch= @@session.optimizer_switch;
SET @save_character_set_client= @@session.character_set_client;
SET @save_character_set_connection= @@session.character_set_connection;
SET @save_character_set_results= @@session.character_set_results;

SET @@session.session_plan_cache = ON;

--disable_query_log
let $count_before= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $invalidations_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_invalidations', Value, 1);
--enable_query_log

--echo # optimizer_switch change invalidates existing state without recipe-less replacement
PREPARE stmt FROM 'SELECT id, c FROM pc_env WHERE id = ?';
SET @p=1;
EXECUTE stmt USING @p;
SET @@session.optimizer_switch='index_condition_pushdown=off';
SET @p=2;
EXECUTE stmt USING @p;

--disable_query_log
let $count_after_optimizer= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_optimizer= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $invalidations_after_optimizer= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_invalidations', Value, 1);

--let $assert_text= Cached_plan_count returns to baseline after optimizer_switch change
--let $assert_cond= $count_after_optimizer = $count_before
--source include/assert.inc

--let $assert_text= Cached_plan_hits remains unchanged after optimizer_switch invalidation
--let $assert_cond= $hits_after_optimizer = $hits_before
--source include/assert.inc

--let $assert_text= Cached_plan_invalidations grows after optimizer_switch change
--let $assert_cond= $invalidations_after_optimizer = $invalidations_before + 1
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt;
SET @@session.optimizer_switch= @save_optimizer_switch;

--disable_query_log
let $count_after_optimizer_deallocate= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);

--let $assert_text= Cached_plan_count returns to baseline after optimizer test deallocate
--let $assert_cond= $count_after_optimizer_deallocate = $count_before
--source include/assert.inc
--enable_query_log

--echo # character_set_client change invalidates existing state without recipe-less replacement
SET NAMES latin1;
PREPARE stmt FROM 'SELECT id, c FROM pc_env WHERE c = ?';
SET @p='a';
EXECUTE stmt USING @p;
SET NAMES utf8;
SET @p='b';
EXECUTE stmt USING @p;

--disable_query_log
let $count_after_charset= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_charset= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $invalidations_after_charset= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_invalidations', Value, 1);

--let $assert_text= Cached_plan_count returns to baseline after character_set_client change
--let $assert_cond= $count_after_charset = $count_before
--source include/assert.inc

--let $assert_text= Cached_plan_hits remains unchanged after character_set_client invalidation
--let $assert_cond= $hits_after_charset = $hits_before
--source include/assert.inc

--let $assert_text= Cached_plan_invalidations grows after character_set_client change
--let $assert_cond= $invalidations_after_charset = $invalidations_before + 1
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt;
SET @@session.character_set_client= @save_character_set_client;
SET @@session.character_set_connection= @save_character_set_connection;
SET @@session.character_set_results= @save_character_set_results;

--disable_query_log
let $count_after_charset_deallocate= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);

--let $assert_text= Cached_plan_count returns to baseline after charset test deallocate
--let $assert_cond= $count_after_charset_deallocate = $count_before
--source include/assert.inc
--enable_query_log

--echo # sharp table row-count change invalidates only when ratio is positive
SET @@session.session_plan_cache_allow_change_ratio = 0.2;
PREPARE stmt FROM 'SELECT id, c FROM pc_env WHERE id = ?';
SET @p=1;
EXECUTE stmt USING @p;
INSERT INTO pc_env VALUES (4,'d'),(5,'e'),(6,'f'),(7,'g');
SET @p=2;
EXECUTE stmt USING @p;

--disable_query_log
let $count_after_records= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_records= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $invalidations_after_records= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_invalidations', Value, 1);

--let $assert_text= Cached_plan_count returns to baseline after row-count invalidation
--let $assert_cond= $count_after_records = $count_before
--source include/assert.inc

--let $assert_text= Cached_plan_hits remains unchanged after row-count invalidation
--let $assert_cond= $hits_after_records = $hits_before
--source include/assert.inc

--let $assert_text= Cached_plan_invalidations grows after sharp row-count change
--let $assert_cond= $invalidations_after_records = $invalidations_before + 2
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt;

--echo # ratio 0 disables row-count invalidation
SET @@session.session_plan_cache_allow_change_ratio = 0;
PREPARE stmt FROM 'SELECT id, c FROM pc_env WHERE id = ?';
SET @p=1;
EXECUTE stmt USING @p;
INSERT INTO pc_env VALUES (8,'h'),(9,'i'),(10,'j'),(11,'k'),(12,'l'),(13,'m');
SET @p=3;
EXECUTE stmt USING @p;

--disable_query_log
let $count_after_ratio_zero= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_ratio_zero= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $invalidations_after_ratio_zero= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_invalidations', Value, 1);

--let $assert_text= Cached_plan_count keeps one state when ratio zero ignores row-count change
--let $assert_cond= $count_after_ratio_zero = $count_before + 1
--source include/assert.inc

--let $assert_text= Cached_plan_hits grows when ratio zero allows stable real hit
--let $assert_cond= $hits_after_ratio_zero = $hits_before + 1
--source include/assert.inc

--let $assert_text= Cached_plan_invalidations does not grow when ratio zero ignores row-count change
--let $assert_cond= $invalidations_after_ratio_zero = $invalidations_before + 2
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt;

--echo # disabling plan cache destroys state without counting an invalidation
SET @@session.session_plan_cache_allow_change_ratio = DEFAULT;
PREPARE stmt FROM 'SELECT id, c FROM pc_env WHERE id = ?';
SET @p=1;
EXECUTE stmt USING @p;
SET @@session.session_plan_cache = OFF;
SET @p=2;
EXECUTE stmt USING @p;

--disable_query_log
let $count_after_disable= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_disable= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $invalidations_after_disable= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_invalidations', Value, 1);

--let $assert_text= Cached_plan_count returns to baseline when plan cache is disabled
--let $assert_cond= $count_after_disable = $count_before
--source include/assert.inc

--let $assert_text= Cached_plan_hits remains unchanged when plan cache is disabled
--let $assert_cond= $hits_after_disable = $hits_before + 1
--source include/assert.inc

--let $assert_text= Cached_plan_invalidations does not grow when plan cache is disabled
--let $assert_cond= $invalidations_after_disable = $invalidations_before + 2
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt;

--echo # disabling plan cache before metadata reprepare also avoids invalidation count
SET @@session.session_plan_cache = ON;
PREPARE stmt FROM 'SELECT id, c FROM pc_env WHERE id = ?';
SET @p=1;
EXECUTE stmt USING @p;
SET @@session.session_plan_cache = OFF;
ALTER TABLE pc_env ADD COLUMN extra INT DEFAULT 0;
SET @p=2;
EXECUTE stmt USING @p;

--disable_query_log
let $count_after_disable_reprepare= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_disable_reprepare= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $invalidations_after_disable_reprepare= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_invalidations', Value, 1);

--let $assert_text= Cached_plan_count returns to baseline when disabled before reprepare
--let $assert_cond= $count_after_disable_reprepare = $count_before
--source include/assert.inc

--let $assert_text= Cached_plan_hits remains unchanged when disabled before reprepare
--let $assert_cond= $hits_after_disable_reprepare = $hits_before + 1
--source include/assert.inc

--let $assert_text= Cached_plan_invalidations does not grow when disabled before reprepare
--let $assert_cond= $invalidations_after_disable_reprepare = $invalidations_before + 2
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt;

--disable_query_log
let $count_after_final_deallocate= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);

--let $assert_text= Cached_plan_count returns to baseline after final deallocate
--let $assert_cond= $count_after_final_deallocate = $count_before
--source include/assert.inc
--enable_query_log

SET @@session.session_plan_cache_allow_change_ratio = DEFAULT;
SET @@session.session_plan_cache = DEFAULT;
DROP TABLE pc_env;
