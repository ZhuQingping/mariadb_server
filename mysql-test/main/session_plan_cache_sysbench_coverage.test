--source include/have_innodb.inc

CREATE TABLE sbtest1 (
  id INTEGER NOT NULL AUTO_INCREMENT,
  k INTEGER DEFAULT 0 NOT NULL,
  c CHAR(120) DEFAULT '' NOT NULL,
  pad CHAR(60) DEFAULT '' NOT NULL,
  PRIMARY KEY(id),
  KEY k_1(k)
) ENGINE=InnoDB;

CREATE TABLE sbtest_secondary (
  id INTEGER NOT NULL,
  k INTEGER DEFAULT 0 NOT NULL,
  c CHAR(120) DEFAULT '' NOT NULL,
  pad CHAR(60) DEFAULT '' NOT NULL,
  KEY xid(id),
  KEY k_secondary(k)
) ENGINE=InnoDB;

INSERT INTO sbtest1(k, c, pad) VALUES
  (10, 'c3', 'p1'), (20, 'c1', 'p2'), (30, 'c2', 'p3'), (40, 'c1', 'p4');
INSERT INTO sbtest_secondary(id, k, c, pad) VALUES
  (1, 10, 's1', 'p1'), (1, 11, 's1b', 'p1b'), (2, 20, 's2', 'p2');

SET @@session.session_plan_cache = ON;
SET @save_ratio=@@session.session_plan_cache_allow_change_ratio;
SET @@session.session_plan_cache_allow_change_ratio = 0;

--disable_query_log
let $count_before= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);
let $invalidations_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_invalidations', Value, 1);
--enable_query_log

--echo # sysbench point_selects on PRIMARY KEY(id) is currently covered
PREPARE stmt FROM 'SELECT c FROM sbtest1 WHERE id=?';
SET @id=1;
--disable_result_log
EXECUTE stmt USING @id;
SET @id=2;
EXECUTE stmt USING @id;
SET @id=3;
EXECUTE stmt USING @id;
--enable_result_log

--disable_query_log
let $count_after_point= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_point= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_point= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= sysbench primary-key point_selects creates one cached state
--let $assert_cond= $count_after_point = $count_before + 1
--source include/assert.inc

--let $assert_text= sysbench primary-key point_selects has repeated cache hits
--let $assert_cond= $hits_after_point = $hits_before + 2
--source include/assert.inc

--let $assert_text= sysbench primary-key point_selects has prevalidations before hits
--let $assert_cond= $prevalidations_after_point = $prevalidations_before + 2
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt;

--disable_query_log
let $count_after_point_close= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
--let $assert_text= sysbench primary-key point_selects releases cached state on deallocate
--let $assert_cond= $count_after_point_close = $count_before
--source include/assert.inc
--enable_query_log

--echo # sysbench point_selects with --secondary is a non-unique ref query and is now covered
PREPARE stmt FROM 'SELECT c FROM sbtest_secondary WHERE id=?';
SET @id=1;
--disable_result_log
EXECUTE stmt USING @id;
EXECUTE stmt USING @id;
--enable_result_log

--disable_query_log
let $count_after_ref= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_ref= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_ref= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= sysbench secondary point_selects creates one cached ref state
--let $assert_cond= $count_after_ref = $count_before + 1
--source include/assert.inc

--let $assert_text= sysbench secondary point_selects has one cache hit
--let $assert_cond= $hits_after_ref = $hits_after_point + 1
--source include/assert.inc

--let $assert_text= sysbench secondary point_selects has one prevalidation before hit
--let $assert_cond= $prevalidations_after_ref = $prevalidations_after_point + 1
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt;

--disable_query_log
let $count_after_ref_close= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
--let $assert_text= sysbench secondary point_selects releases cached state on deallocate
--let $assert_cond= $count_after_ref_close = $count_before
--source include/assert.inc
--enable_query_log

--echo # sysbench simple_ranges is now covered by the range recipe
PREPARE stmt FROM 'SELECT c FROM sbtest1 WHERE id BETWEEN ? AND ?';
SET @lo=1;
SET @hi=3;
EXECUTE stmt USING @lo, @hi;
SET @lo=2;
SET @hi=4;
EXECUTE stmt USING @lo, @hi;
SET @lo=1;
SET @hi=2;
EXECUTE stmt USING @lo, @hi;

--disable_query_log
let $count_after_range= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_range= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_range= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= sysbench simple_ranges creates one cached range state
--let $assert_cond= $count_after_range = $count_before + 1
--source include/assert.inc

--let $assert_text= sysbench simple_ranges has repeated cache hits
--let $assert_cond= $hits_after_range = $hits_after_ref + 2
--source include/assert.inc

--let $assert_text= sysbench simple_ranges has prevalidations before hits
--let $assert_cond= $prevalidations_after_range = $prevalidations_after_ref + 2
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt;

--disable_query_log
let $count_after_range_close= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
--let $assert_text= sysbench simple_ranges releases cached state on deallocate
--let $assert_cond= $count_after_range_close = $count_before
--source include/assert.inc
--enable_query_log

--echo # sysbench sum_ranges is now covered by the aggregate range recipe
PREPARE stmt FROM 'SELECT SUM(k) FROM sbtest1 WHERE id BETWEEN ? AND ?';
SET @lo=1;
SET @hi=3;
EXECUTE stmt USING @lo, @hi;
SET @lo=2;
SET @hi=4;
EXECUTE stmt USING @lo, @hi;
SET @lo=5;
SET @hi=6;
EXECUTE stmt USING @lo, @hi;
SET @lo=1;
SET @hi=2;
EXECUTE stmt USING @lo, @hi;

--disable_query_log
let $count_after_sum= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_sum= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_sum= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= sysbench sum_ranges creates one cached aggregate range state
--let $assert_cond= $count_after_sum = $count_before + 1
--source include/assert.inc

--let $assert_text= sysbench sum_ranges has repeated cache hits
--let $assert_cond= $hits_after_sum = $hits_after_range + 3
--source include/assert.inc

--let $assert_text= sysbench sum_ranges has prevalidations before hits
--let $assert_cond= $prevalidations_after_sum = $prevalidations_after_range + 3
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt;

--disable_query_log
let $count_after_sum_close= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
--let $assert_text= sysbench sum_ranges releases cached state on deallocate
--let $assert_cond= $count_after_sum_close = $count_before
--source include/assert.inc
--enable_query_log

--echo # non-sysbench SUM expressions remain outside the aggregate range boundary
PREPARE stmt FROM 'SELECT SUM(k + 1) FROM sbtest1 WHERE id BETWEEN ? AND ?';
--disable_result_log
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;
--enable_result_log
DEALLOCATE PREPARE stmt;

--echo # sysbench order_ranges is now covered by the ORDER BY range recipe
PREPARE stmt FROM 'SELECT c FROM sbtest1 WHERE id BETWEEN ? AND ? ORDER BY c';
SET @lo=1;
SET @hi=4;
EXECUTE stmt USING @lo, @hi;
SET @lo=2;
SET @hi=4;
EXECUTE stmt USING @lo, @hi;
SET @lo=1;
SET @hi=3;
EXECUTE stmt USING @lo, @hi;

--disable_query_log
let $count_after_order= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_order= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_order= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= sysbench order_ranges creates one cached ORDER BY range state
--let $assert_cond= $count_after_order = $count_before + 1
--source include/assert.inc

--let $assert_text= sysbench order_ranges has repeated cache hits
--let $assert_cond= $hits_after_order = $hits_after_sum + 2
--source include/assert.inc

--let $assert_text= sysbench order_ranges has prevalidations before hits
--let $assert_cond= $prevalidations_after_order = $prevalidations_after_sum + 2
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt;

--disable_query_log
let $count_after_order_close= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
--let $assert_text= sysbench order_ranges releases cached state on deallocate
--let $assert_cond= $count_after_order_close = $count_before
--source include/assert.inc
--enable_query_log

--echo # non-sysbench ORDER BY projection remains outside the range boundary
PREPARE stmt FROM 'SELECT pad FROM sbtest1 WHERE id BETWEEN ? AND ? ORDER BY c';
--disable_result_log
SET @lo=1;
SET @hi=4;
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;
--enable_result_log

--disable_query_log
let $count_after_order_projection= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_order_projection= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_order_projection= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= non-sysbench ORDER BY projection does not create cached state
--let $assert_cond= $count_after_order_projection = $count_before
--source include/assert.inc

--let $assert_text= non-sysbench ORDER BY projection does not add hits
--let $assert_cond= $hits_after_order_projection = $hits_after_order
--source include/assert.inc

--let $assert_text= non-sysbench ORDER BY projection does not add prevalidations
--let $assert_cond= $prevalidations_after_order_projection = $prevalidations_after_order
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt;

--echo # sysbench distinct_ranges is now covered by the DISTINCT ORDER BY range recipe
PREPARE stmt FROM 'SELECT DISTINCT c FROM sbtest1 WHERE id BETWEEN ? AND ? ORDER BY c';
SET @lo=1;
SET @hi=4;
EXECUTE stmt USING @lo, @hi;
SET @lo=2;
SET @hi=4;
EXECUTE stmt USING @lo, @hi;
SET @lo=1;
SET @hi=3;
EXECUTE stmt USING @lo, @hi;

--disable_query_log
let $count_after_distinct= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_distinct= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_distinct= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= sysbench distinct_ranges creates one cached DISTINCT range state
--let $assert_cond= $count_after_distinct = $count_before + 1
--source include/assert.inc

--let $assert_text= sysbench distinct_ranges has repeated cache hits
--let $assert_cond= $hits_after_distinct = $hits_after_order + 2
--source include/assert.inc

--let $assert_text= sysbench distinct_ranges has prevalidations before hits
--let $assert_cond= $prevalidations_after_distinct = $prevalidations_after_order + 2
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt;

--disable_query_log
let $count_after_distinct_close= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
--let $assert_text= sysbench distinct_ranges releases cached state on deallocate
--let $assert_cond= $count_after_distinct_close = $count_before
--source include/assert.inc
--enable_query_log

--echo # literal LIMIT 1 remains outside ref/range/order/distinct sysbench recipes
PREPARE stmt FROM 'SELECT c FROM sbtest_secondary WHERE id=? LIMIT 1';
SET @id=1;
--disable_result_log
EXECUTE stmt USING @id;
EXECUTE stmt USING @id;
--enable_result_log
DEALLOCATE PREPARE stmt;

PREPARE stmt FROM 'SELECT c FROM sbtest1 WHERE id BETWEEN ? AND ? LIMIT 1';
SET @lo=1;
SET @hi=4;
--disable_result_log
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;
--enable_result_log
DEALLOCATE PREPARE stmt;

PREPARE stmt FROM 'SELECT c FROM sbtest1 WHERE id BETWEEN ? AND ? ORDER BY c LIMIT 1';
--disable_result_log
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;
--enable_result_log
DEALLOCATE PREPARE stmt;

PREPARE stmt FROM 'SELECT DISTINCT c FROM sbtest1 WHERE id BETWEEN ? AND ? ORDER BY c LIMIT 1';
--disable_result_log
EXECUTE stmt USING @lo, @hi;
EXECUTE stmt USING @lo, @hi;
--enable_result_log
DEALLOCATE PREPARE stmt;

--disable_query_log
let $count_after_limit_boundary= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_limit_boundary= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_limit_boundary= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);

--let $assert_text= ref/range/order/distinct LIMIT 1 sysbench variants do not create cached state
--let $assert_cond= $count_after_limit_boundary = $count_before
--source include/assert.inc

--let $assert_text= ref/range/order/distinct LIMIT 1 sysbench variants do not add hits
--let $assert_cond= $hits_after_limit_boundary = $hits_after_distinct
--source include/assert.inc

--let $assert_text= ref/range/order/distinct LIMIT 1 sysbench variants do not add prevalidations
--let $assert_cond= $prevalidations_after_limit_boundary = $prevalidations_after_distinct
--source include/assert.inc
--enable_query_log

--echo # sysbench transaction control and write templates are not cached
PREPARE stmt_begin FROM 'BEGIN';
PREPARE stmt_commit FROM 'COMMIT';
PREPARE stmt_update_index FROM 'UPDATE sbtest1 SET k=k+1 WHERE id=?';
PREPARE stmt_update_non_index FROM 'UPDATE sbtest1 SET c=? WHERE id=?';
PREPARE stmt_delete FROM 'DELETE FROM sbtest1 WHERE id=?';
PREPARE stmt_insert FROM 'INSERT INTO sbtest1 (id, k, c, pad) VALUES (?, ?, ?, ?)';

SET @id=4;
SET @c='updated';
SET @k=50;
SET @pad='inserted';
EXECUTE stmt_begin;
EXECUTE stmt_update_index USING @id;
EXECUTE stmt_update_non_index USING @c, @id;
EXECUTE stmt_delete USING @id;
EXECUTE stmt_insert USING @id, @k, @c, @pad;
EXECUTE stmt_commit;

DEALLOCATE PREPARE stmt_begin;
DEALLOCATE PREPARE stmt_commit;
DEALLOCATE PREPARE stmt_update_index;
DEALLOCATE PREPARE stmt_update_non_index;
DEALLOCATE PREPARE stmt_delete;
DEALLOCATE PREPARE stmt_insert;

--echo # sysbench oltp_insert uses text INSERT in the MySQL branch, not prepared SELECT
INSERT INTO sbtest1 (id, k, c, pad) VALUES (100, 100, 'literal insert', 'literal pad');

--echo # sysbench write templates still execute normally while remaining uncached
SELECT id, k, c, pad FROM sbtest1 WHERE id IN (4, 100) ORDER BY id;

--disable_query_log
let $count_after_all= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_all= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_all= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);
let $invalidations_after_all= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_invalidations', Value, 1);

--let $assert_text= unsupported sysbench templates do not leave cached state
--let $assert_cond= $count_after_all = $count_before
--source include/assert.inc

--let $assert_text= transaction control and write templates do not add hits beyond covered SELECT templates
--let $assert_cond= $hits_after_all = $hits_after_distinct
--source include/assert.inc

--let $assert_text= transaction control and write templates do not add prevalidations beyond covered SELECT templates
--let $assert_cond= $prevalidations_after_all = $prevalidations_after_distinct
--source include/assert.inc

--let $assert_text= unsupported sysbench templates do not add invalidations
--let $assert_cond= $invalidations_after_all = $invalidations_before
--source include/assert.inc
--enable_query_log

SET @@session.session_plan_cache_allow_change_ratio = @save_ratio;
SET @@session.session_plan_cache = DEFAULT;

DROP TABLE sbtest_secondary;
DROP TABLE sbtest1;
