CREATE TABLE pc_disconnect_count (
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO pc_disconnect_count VALUES (1,10),(2,20);
# A secondary connection creates one live cached-plan state
connect  con_plan_cache_disconnect,localhost,root,,;
SET @@session.session_plan_cache = ON;
PREPARE stmt FROM 'SELECT id, v FROM pc_disconnect_count WHERE id = ?';
SET @p=1;
EXECUTE stmt USING @p;
id	v
1	10
connection default;
include/assert.inc [Cached_plan_count grows while secondary connection owns a live state]
# Disconnect releases prepared statements and cached-plan state
disconnect con_plan_cache_disconnect;
connection default;
include/assert.inc [Cached_plan_count returns to baseline after connection disconnect]
DROP TABLE pc_disconnect_count;
