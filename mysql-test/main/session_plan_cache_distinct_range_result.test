--source include/have_innodb.inc

CREATE TABLE pc_distinct_range_result (
  id INT NOT NULL PRIMARY KEY,
  c CHAR(10) NOT NULL
) ENGINE=InnoDB;

INSERT INTO pc_distinct_range_result VALUES
  (1, 'c3'), (2, 'c1'), (3, 'c2'),
  (4, 'c1'), (5, 'c4'), (6, 'c2');

SET @@session.session_plan_cache = ON;
SET @save_ratio=@@session.session_plan_cache_allow_change_ratio;
SET @@session.session_plan_cache_allow_change_ratio = 0;

--disable_query_log
let $count_before= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);
let $invalidations_before= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_invalidations', Value, 1);
--enable_query_log

PREPARE stmt FROM
  'SELECT DISTINCT c FROM pc_distinct_range_result WHERE id BETWEEN ? AND ? ORDER BY c';

--echo # First execution creates the cached exact DISTINCT range state
SET @lo=1;
SET @hi=4;
EXECUTE stmt USING @lo, @hi;

--echo # Different bounds preserve DISTINCT and ORDER BY on a cache hit
SET @lo=2;
SET @hi=6;
EXECUTE stmt USING @lo, @hi;

--echo # A wider range also preserves DISTINCT and ORDER BY on a cache hit
SET @lo=1;
SET @hi=6;
EXECUTE stmt USING @lo, @hi;

--echo # Empty ranges remain empty on a cache hit
SET @lo=7;
SET @hi=8;
EXECUTE stmt USING @lo, @hi;

--echo # Single-row ranges remain correct on a cache hit
SET @lo=4;
SET @hi=4;
EXECUTE stmt USING @lo, @hi;

--disable_query_log
let $count_after_hits= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);
let $hits_after_hits= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_hits', Value, 1);
let $prevalidations_after_hits= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_prevalidations', Value, 1);
let $invalidations_after_hits= query_get_value(SHOW SESSION STATUS LIKE 'Cached_plan_invalidations', Value, 1);

--let $assert_text= exact DISTINCT range creates one cached state
--let $assert_cond= $count_after_hits = $count_before + 1
--source include/assert.inc

--let $assert_text= exact DISTINCT range repeated executions are hits
--let $assert_cond= $hits_after_hits = $hits_before + 4
--source include/assert.inc

--let $assert_text= exact DISTINCT range has prevalidations before hits
--let $assert_cond= $prevalidations_after_hits = $prevalidations_before + 4
--source include/assert.inc

--let $assert_text= exact DISTINCT range does not invalidate during stable execution
--let $assert_cond= $invalidations_after_hits = $invalidations_before
--source include/assert.inc
--enable_query_log

DEALLOCATE PREPARE stmt;

--disable_query_log
let $count_after_deallocate= query_get_value(SHOW GLOBAL STATUS LIKE 'Cached_plan_count', Value, 1);

--let $assert_text= exact DISTINCT range releases cached state on deallocate
--let $assert_cond= $count_after_deallocate = $count_before
--source include/assert.inc
--enable_query_log

SET @@session.session_plan_cache_allow_change_ratio = @save_ratio;
SET @@session.session_plan_cache = DEFAULT;
DROP TABLE pc_distinct_range_result;
