CREATE TABLE pc_explain_analyze (
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO pc_explain_analyze VALUES (1,10),(2,20);
SET @@session.session_plan_cache = ON;
# Prepared EXPLAIN SELECT is not a plan-cache candidate
PREPARE stmt FROM
'EXPLAIN SELECT id, v FROM pc_explain_analyze WHERE id = ?';
SET @p=1;
EXECUTE stmt USING @p;
SET @p=2;
EXECUTE stmt USING @p;
include/assert.inc [Cached_plan_count does not grow for prepared EXPLAIN SELECT]
include/assert.inc [Cached_plan_hits does not grow for prepared EXPLAIN SELECT]
include/assert.inc [Cached_plan_prevalidations does not grow for prepared EXPLAIN SELECT]
include/assert.inc [Cached_plan_invalidations does not grow for prepared EXPLAIN SELECT]
DEALLOCATE PREPARE stmt;
# Prepared ANALYZE SELECT is not a plan-cache candidate
PREPARE stmt FROM
'ANALYZE SELECT id, v FROM pc_explain_analyze WHERE id = ?';
SET @p=1;
EXECUTE stmt USING @p;
SET @p=2;
EXECUTE stmt USING @p;
include/assert.inc [Cached_plan_count does not grow for prepared ANALYZE SELECT]
include/assert.inc [Cached_plan_hits does not grow for prepared ANALYZE SELECT]
include/assert.inc [Cached_plan_prevalidations does not grow for prepared ANALYZE SELECT]
include/assert.inc [Cached_plan_invalidations does not grow for prepared ANALYZE SELECT]
DEALLOCATE PREPARE stmt;
SET @@session.session_plan_cache = DEFAULT;
DROP TABLE pc_explain_analyze;
