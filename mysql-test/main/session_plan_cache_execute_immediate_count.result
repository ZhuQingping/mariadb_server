CREATE TABLE pc_exec_immediate (
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO pc_exec_immediate VALUES (1,10),(2,20);
SET @@session.session_plan_cache = ON;
# EXECUTE IMMEDIATE releases any transient cached state after execution
SET @p=1;
EXECUTE IMMEDIATE
'SELECT id, v FROM pc_exec_immediate WHERE id = ?'
  USING @p;
id	v
1	10
include/assert.inc [Cached_plan_count returns to baseline after first EXECUTE IMMEDIATE]
# Repeating EXECUTE IMMEDIATE does not reuse a persistent cached state
SET @p=2;
EXECUTE IMMEDIATE
'SELECT id, v FROM pc_exec_immediate WHERE id = ?'
  USING @p;
id	v
2	20
include/assert.inc [Cached_plan_count remains at baseline after repeated EXECUTE IMMEDIATE]
include/assert.inc [Cached_plan_hits does not grow for EXECUTE IMMEDIATE]
include/assert.inc [Cached_plan_prevalidations does not grow for EXECUTE IMMEDIATE]
include/assert.inc [Cached_plan_invalidations does not grow for EXECUTE IMMEDIATE cleanup]
SET @@session.session_plan_cache = DEFAULT;
DROP TABLE pc_exec_immediate;
