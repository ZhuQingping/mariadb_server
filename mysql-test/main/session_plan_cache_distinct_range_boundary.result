CREATE TABLE pc_distinct_range_boundary (
id INT NOT NULL PRIMARY KEY,
c CHAR(10) NOT NULL,
pad CHAR(10) NOT NULL
) ENGINE=InnoDB;
INSERT INTO pc_distinct_range_boundary VALUES
(1, 'c3', 'p1'), (2, 'c1', 'p2'), (3, 'c2', 'p3'),
(4, 'c1', 'p4'), (5, 'c4', 'p5'), (6, 'c2', 'p6');
SET @@session.session_plan_cache = ON;
SET @save_ratio=@@session.session_plan_cache_allow_change_ratio;
SET @@session.session_plan_cache_allow_change_ratio = 0;
# DISTINCT range with an extra selected column remains fail-closed
PREPARE stmt FROM
'SELECT DISTINCT c, pad FROM pc_distinct_range_boundary WHERE id BETWEEN ? AND ? ORDER BY c';
SET @lo=1;
SET @hi=4;
EXECUTE stmt USING @lo, @hi;
SET @lo=2;
SET @hi=6;
EXECUTE stmt USING @lo, @hi;
DEALLOCATE PREPARE stmt;
include/assert.inc [DISTINCT range extra-column boundary does not create cached state]
include/assert.inc [DISTINCT range extra-column boundary does not add hits]
include/assert.inc [DISTINCT range extra-column boundary does not add prevalidations]
# DISTINCT range with GROUP BY remains fail-closed
PREPARE stmt FROM
'SELECT DISTINCT c FROM pc_distinct_range_boundary WHERE id BETWEEN ? AND ? GROUP BY c ORDER BY c';
SET @lo=1;
SET @hi=4;
EXECUTE stmt USING @lo, @hi;
SET @lo=2;
SET @hi=6;
EXECUTE stmt USING @lo, @hi;
DEALLOCATE PREPARE stmt;
include/assert.inc [DISTINCT range GROUP BY boundary does not create cached state]
include/assert.inc [DISTINCT range GROUP BY boundary does not add hits]
include/assert.inc [DISTINCT range GROUP BY boundary does not add prevalidations]
# DISTINCT range with HAVING remains fail-closed
PREPARE stmt FROM
'SELECT DISTINCT c FROM pc_distinct_range_boundary WHERE id BETWEEN ? AND ? HAVING c IS NOT NULL ORDER BY c';
SET @lo=1;
SET @hi=4;
EXECUTE stmt USING @lo, @hi;
SET @lo=2;
SET @hi=6;
EXECUTE stmt USING @lo, @hi;
DEALLOCATE PREPARE stmt;
include/assert.inc [DISTINCT range HAVING boundary does not create cached state]
include/assert.inc [DISTINCT range HAVING boundary does not add hits]
include/assert.inc [DISTINCT range HAVING boundary does not add prevalidations]
# DISTINCT range with a window function remains fail-closed
PREPARE stmt FROM
'SELECT DISTINCT c, ROW_NUMBER() OVER (ORDER BY c) AS rn FROM pc_distinct_range_boundary WHERE id BETWEEN ? AND ? ORDER BY c';
SET @lo=1;
SET @hi=4;
EXECUTE stmt USING @lo, @hi;
SET @lo=2;
SET @hi=6;
EXECUTE stmt USING @lo, @hi;
DEALLOCATE PREPARE stmt;
include/assert.inc [DISTINCT range window boundary does not create cached state]
include/assert.inc [DISTINCT range window boundary does not add hits]
include/assert.inc [DISTINCT range window boundary does not add prevalidations]
# Aggregate GROUP BY range remains fail-closed
PREPARE stmt FROM
'SELECT c, COUNT(*) FROM pc_distinct_range_boundary WHERE id BETWEEN ? AND ? GROUP BY c ORDER BY c';
SET @lo=1;
SET @hi=4;
EXECUTE stmt USING @lo, @hi;
SET @lo=2;
SET @hi=6;
EXECUTE stmt USING @lo, @hi;
DEALLOCATE PREPARE stmt;
include/assert.inc [aggregate GROUP BY range boundary does not create cached state]
include/assert.inc [aggregate GROUP BY range boundary does not add hits]
include/assert.inc [aggregate GROUP BY range boundary does not add prevalidations]
SET @@session.session_plan_cache_allow_change_ratio = @save_ratio;
SET @@session.session_plan_cache = DEFAULT;
DROP TABLE pc_distinct_range_boundary;
