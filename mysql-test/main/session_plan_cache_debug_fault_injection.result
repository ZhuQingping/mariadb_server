include/assert.inc [Cached_plan_hits does not grow for injected const lookup failure]
include/assert.inc [Cached_plan_prevalidations records the attempted const lookup fallback]
# Clearing the const lookup hook should restore normal hits
SET @p=1;
EXECUTE stmt_const_lookup_fail USING @p;
pad
a
include/assert.inc [Cached_plan_count remains stable after const lookup hook is cleared]
include/assert.inc [Cached_plan_hits grows after const lookup hook is cleared]
