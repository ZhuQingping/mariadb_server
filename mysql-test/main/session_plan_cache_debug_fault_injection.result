CREATE TABLE pc_debug_fault (
id INT NOT NULL PRIMARY KEY,
pad CHAR(10)
) ENGINE=InnoDB;
INSERT INTO pc_debug_fault VALUES (1, 'a'), (2, 'b'), (3, 'c');
CREATE TABLE pc_debug_distinct (
id INT NOT NULL PRIMARY KEY,
c CHAR(10)
) ENGINE=InnoDB;
INSERT INTO pc_debug_distinct VALUES
(1, 'c3'), (2, 'c1'), (3, 'c2'), (4, 'c1');
SET @@session.session_plan_cache = ON;
SET @save_ratio=@@session.session_plan_cache_allow_change_ratio;
SET @@session.session_plan_cache_allow_change_ratio = 0;
SET @save_debug=@@session.debug_dbug;
# Injected state allocation failure should execute normally without caching
PREPARE stmt_state_fail FROM 'SELECT pad FROM pc_debug_fault WHERE id = ?';
SET @p=1;
SET @@session.debug_dbug='+d,session_plan_cache_state_alloc_fail';
EXECUTE stmt_state_fail USING @p;
pad
a
SET @@session.debug_dbug=@save_debug;
include/assert.inc [Cached_plan_count does not grow after injected state allocation failure]
include/assert.inc [Cached_plan_hits does not grow after injected state allocation failure]
include/assert.inc [Cached_plan_prevalidations does not grow before state exists]
# Clearing the hook should allow the same shape to cache and hit normally
SET @p=2;
EXECUTE stmt_state_fail USING @p;
pad
b
SET @p=3;
EXECUTE stmt_state_fail USING @p;
pad
c
include/assert.inc [Cached_plan_count grows after state allocation hook is cleared]
include/assert.inc [Cached_plan_hits grows after state allocation hook is cleared]
include/assert.inc [Cached_plan_prevalidations grows after state allocation hook is cleared]
DEALLOCATE PREPARE stmt_state_fail;
include/assert.inc [Cached_plan_count returns to baseline after state allocation fault test]
# Injected hit-path failure should fall back without counting a hit
PREPARE stmt_hit_fail FROM 'SELECT pad FROM pc_debug_fault WHERE id = ?';
SET @p=1;
EXECUTE stmt_hit_fail USING @p;
pad
a
SET @p=2;
EXECUTE stmt_hit_fail USING @p;
pad
b
include/assert.inc [Cached_plan_count has one state before hit-path fault injection]
SET @p=3;
SET @@session.debug_dbug='+d,session_plan_cache_hit_path_fail';
EXECUTE stmt_hit_fail USING @p;
pad
c
SET @@session.debug_dbug=@save_debug;
include/assert.inc [Cached_plan_count remains stable after injected hit-path failure]
include/assert.inc [Cached_plan_hits does not grow for injected hit-path failure]
include/assert.inc [Cached_plan_prevalidations records the attempted hit-path fallback]
# Clearing the hit-path hook should restore normal hits
SET @p=1;
EXECUTE stmt_hit_fail USING @p;
pad
a
include/assert.inc [Cached_plan_count remains stable after hit-path hook is cleared]
include/assert.inc [Cached_plan_hits grows after hit-path hook is cleared]
include/assert.inc [Cached_plan_prevalidations grows after hit-path hook is cleared]
DEALLOCATE PREPARE stmt_hit_fail;
include/assert.inc [Cached_plan_count returns to baseline after hit-path fault test]
