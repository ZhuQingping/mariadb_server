include/assert.inc [Cached_plan_hits grows after distinct range setup hook is cleared]
include/assert.inc [Cached_plan_prevalidations grows after distinct range setup hook is cleared]
DEALLOCATE PREPARE stmt_distinct_setup_fail;
include/assert.inc [Cached_plan_count returns to baseline after distinct range setup fault test]
