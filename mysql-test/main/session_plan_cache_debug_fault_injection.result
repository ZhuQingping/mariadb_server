# Injected table info failure should invalidate instead of trusting stale row counts
SET @@session.session_plan_cache_allow_change_ratio = 0.2;
PREPARE stmt_table_info_fail FROM 'SELECT pad FROM pc_debug_fault WHERE id = ?';
SET @p=1;
EXECUTE stmt_table_info_fail USING @p;
pad
a
include/assert.inc [Cached_plan_count has one state before table info fault injection]
SET @p=2;
SET @@session.debug_dbug='+d,session_plan_cache_table_info_fail';
EXECUTE stmt_table_info_fail USING @p;
pad
b
SET @@session.debug_dbug=@save_debug;
include/assert.inc [Cached_plan_count keeps one replacement state after table info refresh failure]
include/assert.inc [Cached_plan_hits does not grow after table info refresh failure]
include/assert.inc [Cached_plan_prevalidations does not grow before failed table info validation]
include/assert.inc [Cached_plan_invalidations grows after table info refresh failure]
# Clearing the table info hook should restore normal hits
SET @p=3;
EXECUTE stmt_table_info_fail USING @p;
pad
c
include/assert.inc [Cached_plan_hits grows after table info hook is cleared]
include/assert.inc [Cached_plan_prevalidations grows after table info hook is cleared]
include/assert.inc [Cached_plan_invalidations does not grow after table info hook is cleared]
DEALLOCATE PREPARE stmt_table_info_fail;
include/assert.inc [Cached_plan_count returns to baseline after table info fault test]
SET @@session.debug_dbug=@save_debug;
SET @@session.session_plan_cache_allow_change_ratio = @save_ratio;
SET @@session.session_plan_cache = DEFAULT;
DROP TABLE pc_debug_distinct;
DROP TABLE pc_debug_fault;
