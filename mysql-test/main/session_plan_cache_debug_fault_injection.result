# Injected distinct aggregate setup failure should return an error after JOIN commit
PREPARE stmt_distinct_aggr_fail FROM 'SELECT DISTINCT c FROM pc_debug_distinct WHERE id BETWEEN ? AND ? ORDER BY c';
SET @lo=1;
SET @hi=4;
EXECUTE stmt_distinct_aggr_fail USING @lo, @hi;
c
c1
c2
c3
include/assert.inc [Cached_plan_count has one state before distinct aggregate setup fault injection]
SET @lo=2;
SET @hi=4;
SET @@session.debug_dbug='+d,session_plan_cache_distinct_range_aggr_setup_fail';
EXECUTE stmt_distinct_aggr_fail USING @lo, @hi;
ERROR HY000: Out of memory.
SET @@session.debug_dbug=@save_debug;
include/assert.inc [Cached_plan_count remains stable after injected distinct aggregate setup failure]
include/assert.inc [Cached_plan_hits does not grow for injected distinct aggregate setup failure]
