# Injected distinct range setup failure should roll back upper JOIN state
PREPARE stmt_distinct_setup_fail FROM 'SELECT DISTINCT c FROM pc_debug_distinct WHERE id BETWEEN ? AND ? ORDER BY c';
SET @lo=1;
SET @hi=4;
EXECUTE stmt_distinct_setup_fail USING @lo, @hi;
c
c1
c2
c3
include/assert.inc [Cached_plan_count has one state before distinct range setup fault injection]
SET @lo=2;
SET @hi=4;
SET @@session.debug_dbug='+d,session_plan_cache_distinct_range_setup_fail';
EXECUTE stmt_distinct_setup_fail USING @lo, @hi;
c
c1
c2
SET @@session.debug_dbug=@save_debug;
include/assert.inc [Cached_plan_count remains stable after injected distinct range setup failure]
include/assert.inc [Cached_plan_hits does not grow for injected distinct range setup failure]
include/assert.inc [Cached_plan_prevalidations records the attempted distinct range setup fallback]
# Clearing the distinct range setup hook should restore normal hits
SET @lo=1;
SET @hi=3;
EXECUTE stmt_distinct_setup_fail USING @lo, @hi;
c
c1
c2
c3
