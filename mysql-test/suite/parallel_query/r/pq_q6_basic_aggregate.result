# Q6 HAVING can filter away the aggregate row after PQ execution.
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_extendedprice * l_discount) AS q6_having_filtered_revenue
FROM lineitem_q6
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
AND l_quantity < 24
