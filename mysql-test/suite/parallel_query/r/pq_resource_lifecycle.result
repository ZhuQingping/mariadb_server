SHOW GLOBAL STATUS LIKE 'PQ_threads_running';
Variable_name	Value
Pq_threads_running	0
SHOW GLOBAL STATUS LIKE 'PQ_memory_used';
Variable_name	Value
Pq_memory_used	0
#
# Worker open failures preserve non-KILL diagnostics.
#
connect  pq_mdl_leader, localhost, root,,test;
connect  pq_mdl_ddl, localhost, root,,test;
connection pq_mdl_leader;
SET debug_sync= 'after_pq_create_snapshot SIGNAL pq_mdl_snapshot WAIT_FOR pq_mdl_release';
SELECT /*+ PQ(4) */ COUNT(*) AS pq_mdl_worker_error_count FROM lineitem WHERE l_shipdate > '1980-01-01';
connection pq_mdl_ddl;
SET debug_sync= 'now WAIT_FOR pq_mdl_snapshot TIMEOUT 30';
ALTER TABLE lineitem ADD COLUMN pq_mdl_guard INT DEFAULT 0;
connection default;
SET debug_sync= 'now SIGNAL pq_mdl_release';
connection pq_mdl_leader;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET debug_sync= 'RESET';
disconnect pq_mdl_leader;
connection pq_mdl_ddl;
ALTER TABLE lineitem DROP COLUMN pq_mdl_guard;
disconnect pq_mdl_ddl;
connection default;
SET debug_sync= 'RESET';
#
# Projection worker open failures preserve non-KILL diagnostics.
#
connect  pq_projection_mdl_leader, localhost, root,,test;
connect  pq_projection_mdl_ddl, localhost, root,,test;
connection pq_projection_mdl_leader;
SET debug_sync= 'after_pq_create_snapshot SIGNAL pq_projection_mdl_snapshot WAIT_FOR pq_projection_mdl_release';
SELECT /*+ PQ(4) */ l_orderkey, l_quantity FROM lineitem WHERE l_shipdate > '1980-01-01' ORDER BY l_orderkey;
connection pq_projection_mdl_ddl;
SET debug_sync= 'now WAIT_FOR pq_projection_mdl_snapshot TIMEOUT 30';
ALTER TABLE lineitem ADD COLUMN pq_projection_mdl_guard INT DEFAULT 0;
connection default;
SET debug_sync= 'now SIGNAL pq_projection_mdl_release';
connection pq_projection_mdl_leader;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SHOW GLOBAL STATUS LIKE 'PQ_threads_running';
Variable_name	Value
Pq_threads_running	0
SHOW GLOBAL STATUS LIKE 'PQ_memory_used';
Variable_name	Value
Pq_memory_used	0
SET debug_sync= 'RESET';
disconnect pq_projection_mdl_leader;
connection pq_projection_mdl_ddl;
ALTER TABLE lineitem DROP COLUMN pq_projection_mdl_guard;
disconnect pq_projection_mdl_ddl;
connection default;
SET debug_sync= 'RESET';
SET @pq_memory_refused_before= (
SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME= 'PQ_MEMORY_REFUSED'
);
SET GLOBAL parallel_memory_limit= 4096;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS pq_memory_fallback_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
pq_memory_fallback_count
5
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SHOW GLOBAL STATUS LIKE 'PQ_memory_used';
Variable_name	Value
Pq_memory_used	0
SELECT CAST(VARIABLE_VALUE AS UNSIGNED) > @pq_memory_refused_before AS pq_memory_refused_increased
FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME= 'PQ_MEMORY_REFUSED';
pq_memory_refused_increased
1
SET GLOBAL parallel_memory_limit= 104857600;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET parallel_queue_timeout= @save_parallel_queue_timeout;
SET parallel_fail_retry= @save_parallel_fail_retry;
SET parallel_graceful_fallback= @save_parallel_graceful_fallback;
SET optimizer_switch= @save_optimizer_switch;
SET optimizer_trace= @save_optimizer_trace;
SET SESSION debug_dbug= @save_debug_dbug;
SET GLOBAL pq_master_enable= @save_pq_master_enable;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
DROP TABLE lineitem;
