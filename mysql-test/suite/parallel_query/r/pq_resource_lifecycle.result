#
# Parallel Query resource lifecycle coverage.
#
CREATE TABLE lineitem (
l_orderkey INT NOT NULL PRIMARY KEY,
l_shipdate DATE NOT NULL,
l_quantity INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem VALUES
(1, '1979-12-31', 10),
(2, '1980-01-01', 20),
(3, '1980-01-02', 30),
(4, '1981-05-10', 40),
(5, '1992-07-15', 50),
(6, '1978-03-20', 60),
(7, '1980-06-01', 70),
(8, '1985-09-09', 80);
SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_parallel_queue_timeout= @@parallel_queue_timeout;
SET @save_parallel_fail_retry= @@parallel_fail_retry;
SET @save_parallel_graceful_fallback= @@parallel_graceful_fallback;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_optimizer_switch= @@optimizer_switch;
SET @save_debug_dbug= @@debug_dbug;
SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET optimizer_trace= 1;
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
SET parallel_queue_timeout= 0;
SET parallel_fail_retry= ON;
SET parallel_graceful_fallback= ON;
#
# TaurusDB-style worker thread resource governance.
#
SET GLOBAL parallel_max_threads= 4;
SET GLOBAL parallel_memory_limit= 104857600;
SET @pq_stmt_executed_before= (
SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME= 'PQ_STMT_EXECUTED'
);
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS pq_resource_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
pq_resource_count
5
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
SHOW GLOBAL STATUS LIKE 'PQ_threads_running';
Variable_name	Value
Pq_threads_running	0
SHOW GLOBAL STATUS LIKE 'PQ_memory_used';
Variable_name	Value
Pq_memory_used	0
SELECT CAST(VARIABLE_VALUE AS UNSIGNED) > @pq_stmt_executed_before AS pq_stmt_executed_increased
FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME= 'PQ_STMT_EXECUTED';
pq_stmt_executed_increased
1
SET @pq_refused_before= (
SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME= 'PQ_THREADS_REFUSED'
);
SET GLOBAL parallel_max_threads= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS pq_resource_fallback_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
pq_resource_fallback_count
5
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SHOW GLOBAL STATUS LIKE 'PQ_threads_running';
Variable_name	Value
Pq_threads_running	0
SELECT CAST(VARIABLE_VALUE AS UNSIGNED) > @pq_refused_before AS pq_threads_refused_increased
FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME= 'PQ_THREADS_REFUSED';
pq_threads_refused_increased
1
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 0;
SET parallel_fail_retry= OFF;
SELECT /*+ PQ(4) */ COUNT(*) AS pq_resource_no_fail_retry_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
ERROR HY000: Parallel Query setup failed (parallel_memory_exhausted) and retry/fallback is disabled
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "parallel_memory_exhausted",
        "execution_reason": "parallel_memory_exhausted"
    }
]
SET parallel_fail_retry= ON;
SET parallel_fail_retry= OFF;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey
LIMIT 2;
ERROR HY000: Parallel Query setup failed (parallel_memory_exhausted) and retry/fallback is disabled
SET parallel_fail_retry= ON;
SET parallel_graceful_fallback= OFF;
SELECT /*+ PQ(4) */ COUNT(*) AS pq_resource_no_graceful_fallback_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
ERROR HY000: Parallel Query setup failed (parallel_memory_exhausted) and retry/fallback is disabled
SET parallel_graceful_fallback= ON;
SET parallel_graceful_fallback= OFF;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey
LIMIT 2;
ERROR HY000: Parallel Query setup failed (parallel_memory_exhausted) and retry/fallback is disabled
SET parallel_graceful_fallback= ON;
SET GLOBAL parallel_memory_limit= 104857600;
# PQ does not fall back after partial worker thread launch failure.
SET SESSION debug_dbug='d,pq_fail_worker_create_after_first';
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS pq_partial_launch_failure_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
