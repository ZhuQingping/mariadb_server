SET GLOBAL parallel_memory_limit= 104857600;
DROP TABLE pq_memory_materialized;
#
# Materialized result memory stays reserved until leader consumption.
#
connect  pq_memory_leader, localhost, root,,test;
SET debug_sync= 'after_pq_materialized_result_ready SIGNAL pq_materialized_ready WAIT_FOR pq_materialized_release';
SELECT /*+ PQ(4) */ l_orderkey, l_quantity FROM lineitem WHERE l_shipdate > '1980-01-01' ORDER BY l_orderkey;
connection default;
SET debug_sync= 'now WAIT_FOR pq_materialized_ready TIMEOUT 30';
SELECT CAST(VARIABLE_VALUE AS UNSIGNED) > 0 AS pq_materialized_memory_held
FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME= 'PQ_MEMORY_USED';
pq_materialized_memory_held
1
SET debug_sync= 'now SIGNAL pq_materialized_release';
connection pq_memory_leader;
l_orderkey	l_quantity
3	30
4	40
5	50
7	70
8	80
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
SET debug_sync= 'RESET';
disconnect pq_memory_leader;
connection default;
SHOW GLOBAL STATUS LIKE 'PQ_memory_used';
Variable_name	Value
Pq_memory_used	0
SET debug_sync= 'RESET';
#
# parallel_queue_timeout waits for worker thread admission.
#
SET GLOBAL parallel_max_threads= 4;
connect  con1, localhost, root,,test;
connect  con2, localhost, root,,test;
SET @pq_refused_before= (
SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME= 'PQ_THREADS_REFUSED'
);
connection con1;
SET debug_sync= 'after_pq_thread_reserve SIGNAL pq_reserved WAIT_FOR pq_release';
SELECT /*+ PQ(4) */ COUNT(*) AS pq_queue_holder_count FROM lineitem WHERE l_shipdate > '1980-01-01';
connection con2;
SET parallel_queue_timeout= 0;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS pq_queue_no_wait_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
pq_queue_no_wait_count
5
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SELECT CAST(VARIABLE_VALUE AS UNSIGNED) > @pq_refused_before AS pq_queue_no_wait_refused
FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME= 'PQ_THREADS_REFUSED';
pq_queue_no_wait_refused
1
SET parallel_queue_timeout= 5000;
SET debug_sync= 'before_pq_thread_wait SIGNAL pq_waiting';
SELECT /*+ PQ(4) */ COUNT(*) AS pq_queue_wait_count FROM lineitem WHERE l_shipdate > '1980-01-01';
connection default;
SET debug_sync= 'now WAIT_FOR pq_reserved TIMEOUT 30';
SET debug_sync= 'now WAIT_FOR pq_waiting TIMEOUT 30';
SET debug_sync= 'now SIGNAL pq_release';
connection con1;
pq_queue_holder_count
5
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
SET debug_sync= 'RESET';
connection con2;
pq_queue_wait_count
5
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
SET debug_sync= 'RESET';
SET parallel_queue_timeout= 0;
disconnect con1;
disconnect con2;
connection default;
SET debug_sync= 'RESET';
#
# KILL QUERY after worker launch must abort PQ and release resources.
#
connect  pq_kill_leader, localhost, root,,test;
SET debug_sync= 'after_pq_workers_launched SIGNAL pq_workers_launched WAIT_FOR pq_kill_release';
SELECT /*+ PQ(4) */ COUNT(*) AS pq_killed_count FROM lineitem WHERE l_shipdate > '1980-01-01';
connection default;
SET debug_sync= 'now WAIT_FOR pq_workers_launched TIMEOUT 30';
SET debug_sync= 'now SIGNAL pq_kill_release';
connection pq_kill_leader;
ERROR 70100: Query execution was interrupted
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET debug_sync= 'RESET';
disconnect pq_kill_leader;
connection default;
