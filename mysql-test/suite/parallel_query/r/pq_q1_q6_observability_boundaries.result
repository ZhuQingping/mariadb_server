#
# Q1/Q6 observability boundaries for EXPLAIN and runtime fallback.
#
SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_optimizer_switch= @@optimizer_switch;
SET @save_debug_dbug= @@debug_dbug;
SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET optimizer_trace= 1;
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
CREATE TABLE lineitem_q6_observe (
l_orderkey INT NOT NULL,
l_linenumber INT NOT NULL,
l_shipdate DATE NOT NULL,
l_quantity DECIMAL(15,2) NOT NULL,
l_extendedprice DECIMAL(15,2) NOT NULL,
l_discount DECIMAL(15,2) NOT NULL,
PRIMARY KEY (l_orderkey, l_linenumber),
KEY idx_q6_shipdate (l_shipdate)
) ENGINE=InnoDB;
INSERT INTO lineitem_q6_observe VALUES
(1, 1, '1993-12-31', 10.00, 100.00, 0.06),
(2, 1, '1994-01-01', 12.00, 200.00, 0.05),
(3, 1, '1994-06-15', 23.00, 300.00, 0.06),
(4, 1, '1994-12-31', 24.00, 400.00, 0.07),
(5, 1, '1995-01-01', 20.00, 500.00, 0.06);
CREATE TABLE lineitem_q1_observe (
l_orderkey INT NOT NULL,
l_linenumber INT NOT NULL,
l_shipdate DATE NOT NULL,
l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
l_quantity DECIMAL(15,2) NOT NULL,
l_extendedprice DECIMAL(15,2) NOT NULL,
l_discount DECIMAL(15,2) NOT NULL,
l_tax DECIMAL(15,2) NOT NULL,
PRIMARY KEY (l_orderkey, l_linenumber)
) ENGINE=InnoDB;
INSERT INTO lineitem_q1_observe VALUES
(1, 1, '1998-09-01', 'A', 'F', 10.00, 100.00, 0.05, 0.10),
(2, 1, '1998-09-02', 'A', 'F', 20.00, 200.00, 0.10, 0.08),
(3, 1, '1998-09-03', 'A', 'F', 30.00, 300.00, 0.02, 0.04),
(4, 1, '1998-08-30', 'N', 'O', 40.00, 400.00, 0.07, 0.05),
(5, 1, '1998-08-31', 'N', 'O', 50.00, 500.00, 0.06, 0.03);
# Q6 EXPLAIN is plan-shape based and exposes gather before runtime admission.
EXPLAIN FORMAT=JSON SELECT /*+ PQ(4) */
SUM(l_extendedprice * l_discount) AS q6_observe_revenue
FROM lineitem_q6_observe FORCE INDEX(idx_q6_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
AND l_quantity < 24;
EXPLAIN
{
  "query_block": {
    "select_id": 1,
    "cost": #,
    "nested_loop": [
      {
        "parallel_execute": {
          "parallel_degree": 4,
          "divided_table": "lineitem_q6_observe",
          "cut_table": "lineitem_q6_observe",
          "table": {
            "table_name": "<gather1>",
            "access_type": "ALL",
            "rows": #
          }
        }
      },
      {
        "table": {
          "table_name": "lineitem_q6_observe",
          "access_type": "range",
          "possible_keys": ["idx_q6_shipdate"],
          "key": "idx_q6_shipdate",
          "key_length": "3",
          "used_key_parts": ["l_shipdate"],
          "loops": 1,
          "rows": #,
          "cost": #,
          "filtered": 100,
          "index_condition": "lineitem_q6_observe.l_shipdate >= DATE'1994-01-01' and lineitem_q6_observe.l_shipdate < DATE'1995-01-01'",
          "attached_condition": "lineitem_q6_observe.l_discount between 0.05 and 0.07 and lineitem_q6_observe.l_quantity < 24"
        }
      }
    ]
  }
}
# Q6 runtime trace records the current SQL-layer scan provider boundary.
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_extendedprice * l_discount) AS q6_provider_revenue
FROM lineitem_q6_observe FORCE INDEX(idx_q6_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
AND l_quantity < 24;
q6_provider_revenue
28.0000
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].scan_provider') AS q6_scan_provider
FROM information_schema.optimizer_trace;
q6_scan_provider
["sql_primary_key_range"]
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].handler_scan_available') AS q6_handler_scan_available
FROM information_schema.optimizer_trace;
q6_handler_scan_available
[false]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
# Runtime fallback before worker launch does not advertise a chosen scan provider.
SET optimizer_trace= 0;
SET optimizer_trace= 1;
SET SESSION debug_dbug= 'd,pq_fail_worker_create_first';
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_extendedprice * l_discount) AS q6_worker_create_fallback_revenue
FROM lineitem_q6_observe FORCE INDEX(idx_q6_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
AND l_quantity < 24;
q6_worker_create_fallback_revenue
28.0000
SELECT json_contains(json_extract(trace,
'$**.not_apply_pq_plan[0].execution_reason'),
'"parallel_threads_exhausted"') AS q6_has_thread_exhausted_reason
FROM information_schema.optimizer_trace;
q6_has_thread_exhausted_reason
1
SELECT json_extract(trace,
'$**.parallel_query_scan_provider') AS q6_failed_scan_provider
FROM information_schema.optimizer_trace;
q6_failed_scan_provider
NULL
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET SESSION debug_dbug= @save_debug_dbug;
SET GLOBAL parallel_memory_limit= 4096;
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_extendedprice * l_discount) AS q6_memory_fallback_revenue
FROM lineitem_q6_observe
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
AND l_quantity < 24;
q6_memory_fallback_revenue
28.0000
SELECT json_contains(json_extract(trace,
'$**.not_apply_pq_plan[0].execution_reason'),
'"parallel_memory_exhausted"') AS q6_has_memory_exhausted_reason
FROM information_schema.optimizer_trace;
q6_has_memory_exhausted_reason
1
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SHOW GLOBAL STATUS LIKE 'PQ_memory_used';
Variable_name	Value
Pq_memory_used	0
SET GLOBAL parallel_memory_limit= 104857600;
# Q1 EXPLAIN is plan-shape based and exposes gather before runtime admission.
EXPLAIN FORMAT=JSON SELECT /*+ PQ(4) */
l_returnflag,
l_linestatus,
COUNT(*) AS count_order,
SUM(l_quantity) AS sum_qty
FROM lineitem_q1_observe
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
EXPLAIN
{
  "query_block": {
    "select_id": 1,
    "cost": #,
    "filesort": {
      "sort_key": "lineitem_q1_observe.l_returnflag, lineitem_q1_observe.l_linestatus",
      "temporary_table": {
        "nested_loop": [
          {
            "parallel_execute": {
              "parallel_degree": 4,
              "divided_table": "lineitem_q1_observe",
              "cut_table": "lineitem_q1_observe",
              "table": {
                "table_name": "<gather1>",
                "access_type": "ALL",
                "rows": #
              }
            }
          },
          {
            "table": {
              "table_name": "lineitem_q1_observe",
              "access_type": "ALL",
              "loops": 1,
              "rows": #,
              "cost": #,
              "filtered": 100,
              "attached_condition": "lineitem_q1_observe.l_shipdate <= DATE'1998-09-02'"
            }
          }
        ]
      }
    }
  }
}
# Q1 runtime trace records the current SQL-layer scan provider boundary.
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
COUNT(*) AS count_order,
SUM(l_quantity) AS sum_qty
FROM lineitem_q1_observe
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	count_order	sum_qty
A	F	2	30.00
N	O	2	90.00
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].scan_provider') AS q1_scan_provider
FROM information_schema.optimizer_trace;
q1_scan_provider
["innodb_clustered_primary"]
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].handler_scan_available') AS q1_handler_scan_available
FROM information_schema.optimizer_trace;
q1_handler_scan_available
[true]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
SET GLOBAL parallel_memory_limit= 4096;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
COUNT(*) AS count_order,
SUM(l_quantity) AS sum_qty
FROM lineitem_q1_observe
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	count_order	sum_qty
A	F	2	30.00
N	O	2	90.00
SELECT json_contains(json_extract(trace,
'$**.not_apply_pq_plan[0].execution_reason'),
'"parallel_memory_exhausted"') AS q1_has_memory_exhausted_reason
FROM information_schema.optimizer_trace;
q1_has_memory_exhausted_reason
1
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SHOW GLOBAL STATUS LIKE 'PQ_memory_used';
Variable_name	Value
Pq_memory_used	0
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
SET optimizer_trace= @save_optimizer_trace;
SET optimizer_switch= @save_optimizer_switch;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET SESSION debug_dbug= @save_debug_dbug;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL pq_master_enable= @save_pq_master_enable;
DROP TABLE lineitem_q1_observe;
DROP TABLE lineitem_q6_observe;
