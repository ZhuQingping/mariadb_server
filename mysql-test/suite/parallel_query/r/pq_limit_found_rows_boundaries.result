#
# Parallel Query LIMIT, OFFSET, and FOUND_ROWS boundary coverage.
#
CREATE TABLE lineitem (
l_orderkey INT NOT NULL PRIMARY KEY,
l_shipdate DATE NOT NULL,
l_quantity INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem VALUES
(1, '1979-12-31', 10),
(2, '1980-01-01', 20),
(3, '1980-01-02', 30),
(4, '1981-05-10', 40),
(5, '1992-07-15', 50),
(6, '1978-03-20', 60),
(7, '1980-06-01', 70),
(8, '1985-09-09', 80);
CREATE TABLE lineitem_q1_group (
l_orderkey INT NOT NULL,
l_linenumber INT NOT NULL,
l_shipdate DATE NOT NULL,
l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
l_quantity DECIMAL(15,2) NOT NULL,
l_extendedprice DECIMAL(15,2) NOT NULL,
l_discount DECIMAL(15,2) NOT NULL,
l_tax DECIMAL(15,2) NOT NULL,
l_comment BLOB NOT NULL,
PRIMARY KEY (l_orderkey, l_linenumber)
) ENGINE=InnoDB;
INSERT INTO lineitem_q1_group VALUES
(1, 1, '1998-09-01', 'A', 'F', 10.00, 100.00, 0.05, 0.10, 'aa'),
(2, 1, '1998-09-02', 'A', 'F', 20.00, 200.00, 0.10, 0.08, 'bbb'),
(3, 1, '1998-09-03', 'A', 'F', 30.00, 300.00, 0.02, 0.04, 'cccc'),
(4, 1, '1998-08-30', 'N', 'O', 40.00, 400.00, 0.07, 0.05, 'dd'),
(5, 1, '1998-08-31', 'N', 'O', 50.00, 500.00, 0.06, 0.03, 'eee'),
(6, 1, '1998-07-15', 'R', 'F', 60.00, 600.00, 0.08, 0.07, 'ffff');
SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_op_over_pq_offset_threshold= @@op_over_pq_offset_threshold;
SET @save_parallel_limit_no_order_by= @@parallel_limit_no_order_by;
SET @save_pq_support_features_switch= @@pq_support_features_switch;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_optimizer_switch= @@optimizer_switch;
SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
SET op_over_pq_offset_threshold= 2048;
SET parallel_limit_no_order_by= ON;
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=on,correlated_subquery=on,hash_join_spill_to_disk=on,insert_select=on';
SET optimizer_trace= 1;
SET parallel_limit_no_order_by= OFF;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
LIMIT 1;
l_orderkey	l_quantity
3	30
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_limit_without_order"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus, COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
LIMIT 1;
l_returnflag	l_linestatus	count_order
A	F	2
