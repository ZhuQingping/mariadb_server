CREATE TABLE pq_group_ties (
l_orderkey INT NOT NULL PRIMARY KEY,
g1 CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
g2 CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
l_quantity INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO pq_group_ties VALUES
(1, 'A', 'F', 10),
(2, 'A', 'F', 20),
(3, 'A', 'O', 30),
(4, 'B', 'F', 40),
(5, 'B', 'O', 50);
FLUSH STATUS;
SELECT /*+ PQ(4) */ g1, g2, COUNT(*) AS tie_count
FROM pq_group_ties
GROUP BY g1, g2
ORDER BY g1
FETCH FIRST 1 ROWS WITH TIES;
g1	g2	tie_count
A	F	2
A	O	1
