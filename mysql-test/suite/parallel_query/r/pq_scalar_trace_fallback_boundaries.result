SET @pq_save_sql_mode= @@sql_mode;
SET SESSION sql_mode= CONCAT(@@sql_mode, IF(@@sql_mode = '', '', ','), 'ONLY_FULL_GROUP_BY');
SELECT /*+ PQ(4) */ SUM(l_extendedprice * l_discount) AS q6_only_full_group_by_revenue
FROM lineitem_q6
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
AND l_quantity < 24;
