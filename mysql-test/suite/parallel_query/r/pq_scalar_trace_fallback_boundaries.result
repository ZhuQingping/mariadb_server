        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_isolation_or_locking"
    }
]
UNLOCK TABLES;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
LOCK TABLES lineitem_q1_group READ;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	count_order
A	F	2
N	O	2
R	F	1
