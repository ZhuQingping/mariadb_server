Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	count_order
A	F	2
N	O	2
R	F	1
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_sql_mode"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET SESSION sql_mode= @pq_save_sql_mode;
FLUSH STATUS;
LOCK TABLES lineitem_q6 READ;
SELECT /*+ PQ(4) */ SUM(l_extendedprice * l_discount) AS q6_lock_tables_revenue
FROM lineitem_q6
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
AND l_quantity < 24;
q6_lock_tables_revenue
