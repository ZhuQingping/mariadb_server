#
# Parallel Query projection gather-merge boundary coverage.
#
SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_optimizer_switch= @@optimizer_switch;
SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET optimizer_trace= 1;
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
CREATE TABLE pq_projection_gather_t (
id INT NOT NULL,
qty INT NOT NULL,
payload VARCHAR(16) NOT NULL,
PRIMARY KEY (id),
KEY idx_qty (qty)
) ENGINE=InnoDB;
INSERT INTO pq_projection_gather_t VALUES
(-100, 3, 'a'), (-30, 2, 'b'), (-7, 5, 'c'), (0, 4, 'd'),
(5, 1, 'e'), (8, 9, 'f'), (13, 8, 'g'), (21, 7, 'h'),
(34, 6, 'i'), (55, 5, 'j'), (89, 4, 'k'), (144, 3, 'l');
# Primary-key ASC projection can gather-merge naturally ordered worker streams.
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ id
FROM pq_projection_gather_t
ORDER BY id;
id
-100
-30
-7
0
5
8
13
21
34
55
89
144
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].scan_provider') AS pk_asc_scan_provider
FROM information_schema.optimizer_trace;
pk_asc_scan_provider
["innodb_clustered_primary"]
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].projection_order_strategy') AS pk_asc_order_strategy
FROM information_schema.optimizer_trace;
pk_asc_order_strategy
["gather_merge"]
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].projection_order_natural') AS pk_asc_order_natural
FROM information_schema.optimizer_trace;
pk_asc_order_natural
[true]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
# ORDER BY primary key can gather-merge when the key is not returned.
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ payload
FROM pq_projection_gather_t
ORDER BY id
LIMIT 4;
payload
a
b
c
d
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].projection_order_strategy') AS hidden_pk_order_strategy
FROM information_schema.optimizer_trace;
hidden_pk_order_strategy
["gather_merge"]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
# Primary-key DESC projection can gather-merge reverse worker streams.
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ id
FROM pq_projection_gather_t
WHERE id >= -30 AND id < 90
ORDER BY id DESC;
id
89
55
34
21
13
8
5
0
-7
-30
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].scan_provider') AS pk_desc_scan_provider
FROM information_schema.optimizer_trace;
pk_desc_scan_provider
["innodb_clustered_primary_reverse"]
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].projection_order_strategy') AS pk_desc_order_strategy
FROM information_schema.optimizer_trace;
pk_desc_order_strategy
["gather_merge"]
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].projection_order_natural') AS pk_desc_order_natural
FROM information_schema.optimizer_trace;
pk_desc_order_natural
[true]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
# Non-primary ORDER BY remains PQ but uses the existing leader sort fallback.
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ id, qty
FROM pq_projection_gather_t
ORDER BY qty, id;
id	qty
5	1
-30	2
-100	3
144	3
0	4
89	4
-7	5
55	5
34	6
21	7
13	8
8	9
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].projection_order_strategy') AS non_pk_order_strategy
FROM information_schema.optimizer_trace;
non_pk_order_strategy
["leader_sort"]
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].projection_order_natural') AS non_pk_order_natural
FROM information_schema.optimizer_trace;
non_pk_order_natural
[false]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
CREATE TABLE pq_projection_gather_composite_t (
grp INT NOT NULL,
seq INT NOT NULL,
payload VARCHAR(16) NOT NULL,
PRIMARY KEY (grp, seq)
) ENGINE=InnoDB;
INSERT INTO pq_projection_gather_composite_t VALUES
(-4, 2, 'a'), (-4, 4, 'b'), (-1, 1, 'c'), (-1, 3, 'd'),
(0, 1, 'e'), (0, 2, 'f'), (3, 1, 'g'), (3, 4, 'h'),
(8, 1, 'i'), (8, 3, 'j'), (13, 2, 'k'), (21, 1, 'l');
# Full composite primary-key ASC projection can gather-merge worker streams.
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ grp, seq
FROM pq_projection_gather_composite_t
ORDER BY grp, seq;
grp	seq
-4	2
-4	4
-1	1
-1	3
0	1
0	2
3	1
3	4
8	1
8	3
13	2
21	1
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].scan_provider') AS composite_pk_asc_scan_provider
FROM information_schema.optimizer_trace;
composite_pk_asc_scan_provider
["innodb_clustered_primary"]
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].projection_order_strategy') AS composite_pk_asc_order_strategy
FROM information_schema.optimizer_trace;
composite_pk_asc_order_strategy
["gather_merge"]
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].projection_order_natural') AS composite_pk_asc_order_natural
FROM information_schema.optimizer_trace;
composite_pk_asc_order_natural
[true]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
# Full composite primary-key ASC gather-merge works when key fields are hidden.
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ payload
FROM pq_projection_gather_composite_t
ORDER BY grp, seq
LIMIT 5;
payload
a
b
c
d
e
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].projection_order_strategy') AS composite_hidden_pk_order_strategy
FROM information_schema.optimizer_trace;
composite_hidden_pk_order_strategy
["gather_merge"]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
# Partial composite primary-key ORDER BY remains PQ but uses leader sort.
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ grp
FROM pq_projection_gather_composite_t
ORDER BY grp
LIMIT 6;
grp
