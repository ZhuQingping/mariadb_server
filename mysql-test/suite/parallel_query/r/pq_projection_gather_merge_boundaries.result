composite_pk_partial_order_strategy
["leader_sort"]
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].projection_order_natural') AS composite_pk_partial_order_natural
FROM information_schema.optimizer_trace;
composite_pk_partial_order_natural
[false]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
# Composite primary-key DESC remains PQ but uses leader sort.
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ grp, seq
FROM pq_projection_gather_composite_t
ORDER BY grp DESC, seq DESC;
