#
# Parallel Query control-surface boundary coverage.
#
CREATE TABLE lineitem_q6 (
l_orderkey INT NOT NULL,
l_linenumber INT NOT NULL,
l_shipdate DATE NOT NULL,
l_quantity DECIMAL(15,2) NOT NULL,
l_extendedprice DECIMAL(15,2) NOT NULL,
l_discount DECIMAL(15,2) NOT NULL,
PRIMARY KEY (l_orderkey, l_linenumber),
KEY idx_q6_shipdate (l_shipdate)
) ENGINE=InnoDB;
INSERT INTO lineitem_q6 VALUES
(1, 1, '1993-12-31', 10.00, 100.00, 0.06),
(2, 1, '1994-01-01', 12.00, 200.00, 0.05),
(3, 1, '1994-06-15', 23.00, 300.00, 0.06),
(3, 2, '1994-06-16', 18.00, 1000.00, 0.06),
(4, 1, '1994-12-31', 24.00, 400.00, 0.07),
(5, 1, '1995-01-01', 20.00, 500.00, 0.06),
(6, 1, '1994-03-20', 20.00, 600.00, 0.04),
(7, 1, '1994-08-08', 21.00, 700.00, 0.08),
(8, 1, '1994-09-09', 22.00, 800.00, 0.07);
CREATE TABLE lineitem_q1_group (
l_orderkey INT NOT NULL,
l_linenumber INT NOT NULL,
l_shipdate DATE NOT NULL,
l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
l_quantity DECIMAL(15,2) NOT NULL,
l_extendedprice DECIMAL(15,2) NOT NULL,
l_discount DECIMAL(15,2) NOT NULL,
l_tax DECIMAL(15,2) NOT NULL,
l_comment BLOB NOT NULL,
PRIMARY KEY (l_orderkey, l_linenumber)
) ENGINE=InnoDB;
INSERT INTO lineitem_q1_group VALUES
(1, 1, '1998-09-01', 'A', 'F', 10.00, 100.00, 0.05, 0.10, 'aa'),
(2, 1, '1998-09-02', 'A', 'F', 20.00, 200.00, 0.10, 0.08, 'bbb'),
(3, 1, '1998-09-03', 'A', 'F', 30.00, 300.00, 0.02, 0.04, 'cccc'),
(4, 1, '1998-08-30', 'N', 'O', 40.00, 400.00, 0.07, 0.05, 'dd'),
(5, 1, '1998-08-31', 'N', 'O', 50.00, 500.00, 0.06, 0.03, 'eee'),
(6, 1, '1998-07-15', 'R', 'F', 60.00, 600.00, 0.08, 0.07, 'ffff');
SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_parallel_cost_threshold= @@parallel_cost_threshold;
SET @save_parallel_rows_threshold= @@parallel_rows_threshold;
SET @save_parallel_setup_cost= @@parallel_setup_cost;
SET @save_parallel_tuple_cost= @@parallel_tuple_cost;
SET @save_pq_support_features_switch= @@pq_support_features_switch;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_optimizer_switch= @@optimizer_switch;
SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=off';
# PQ status variables are visible through SHOW STATUS surfaces.
FLUSH STATUS;
SHOW STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SHOW GLOBAL STATUS LIKE 'PQ_stmt_executed';
Variable_name	Value
Pq_stmt_executed	#
SHOW GLOBAL STATUS LIKE 'PQ_threads_refused';
Variable_name	Value
Pq_threads_refused	#
SHOW GLOBAL STATUS LIKE 'PQ_memory_refused';
Variable_name	Value
Pq_memory_refused	#
SHOW GLOBAL STATUS LIKE 'PQ_threads_running';
Variable_name	Value
Pq_threads_running	#
SHOW GLOBAL STATUS LIKE 'PQ_memory_used';
Variable_name	Value
Pq_memory_used	#
# Global thread cap limits an explicit high-DOP PQ hint.
SET GLOBAL parallel_max_threads= 4;
EXPLAIN SELECT /*+ PQ(16) */ SUM(l_extendedprice * l_discount) AS q6_capped_dop_revenue
FROM lineitem_q6
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
AND l_quantity < 24;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	<gather1>	ALL	NULL	NULL	NULL	NULL	#	Parallel execute (4 workers, test.lineitem_q6)
1	SIMPLE	lineitem_q6	range	idx_q6_shipdate	idx_q6_shipdate	3	NULL	#	Using index condition; Using where
SET GLOBAL parallel_max_threads= 64;
# Explicit PQ requests bypass the automatic RBO threshold gates.
SET parallel_cost_threshold= 0;
SET parallel_rows_threshold= 18446744073709551615;
SET parallel_setup_cost= 999999.25;
SET parallel_tuple_cost= 999999.25;
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_extendedprice * l_discount) AS q6_cost_policy_revenue
FROM lineitem_q6
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
AND l_quantity < 24;
q6_cost_policy_revenue
144.0000
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	count_order
A	F	2
N	O	2
R	F	1
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
# Automatic RBO honors parallel setup and tuple cost overhead.
SET force_parallel_execute= OFF;
SET parallel_cost_threshold= 0;
SET parallel_rows_threshold= 0;
SET parallel_setup_cost= 999999.25;
SET parallel_tuple_cost= 999999.25;
FLUSH STATUS;
SELECT SUM(l_extendedprice * l_discount) AS q6_high_parallel_cost_revenue
FROM lineitem_q6
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
AND l_quantity < 24;
q6_high_parallel_cost_revenue
144.0000
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET force_parallel_execute= ON;
SET parallel_cost_threshold= @save_parallel_cost_threshold;
SET parallel_rows_threshold= @save_parallel_rows_threshold;
SET parallel_setup_cost= @save_parallel_setup_cost;
SET parallel_tuple_cost= @save_parallel_tuple_cost;
SET GLOBAL pq_master_enable= OFF;
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	count_order
A	F	2
N	O	2
R	F	1
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "pq_master_disabled"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET GLOBAL pq_master_enable= ON;
SET pq_support_features_switch= 'simple_aggregate=off';
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	count_order
A	F	2
N	O	2
R	F	1
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "disabled_in_pq_support_features"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET pq_support_features_switch= 'simple_aggregate=on';
SET optimizer_switch= @save_optimizer_switch;
SET pq_support_features_switch= @save_pq_support_features_switch;
SET parallel_cost_threshold= @save_parallel_cost_threshold;
SET parallel_rows_threshold= @save_parallel_rows_threshold;
SET parallel_setup_cost= @save_parallel_setup_cost;
SET parallel_tuple_cost= @save_parallel_tuple_cost;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL pq_master_enable= @save_pq_master_enable;
DROP TABLE lineitem_q1_group;
DROP TABLE lineitem_q6;
