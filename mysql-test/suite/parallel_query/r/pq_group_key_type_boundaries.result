INSERT INTO pq_group_key_types VALUES
(10, NULL, NULL, NULL, NULL, NULL, 1),
(100, NULL, NULL, NULL, NULL, NULL, 1);
FLUSH STATUS;
SELECT /*+ PQ(4) */ g_int, COUNT(*) AS count_order, SUM(qty) AS sum_qty
FROM pq_group_key_types
GROUP BY g_int
HAVING g_int IS NULL
ORDER BY g_int;
g_int	count_order	sum_qty
NULL	3	3
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ g_int, COUNT(*) AS count_order
FROM pq_group_key_types
GROUP BY g_int
ORDER BY g_int DESC;
g_int	count_order
256	1
255	1
2	1
1	2
0	1
-1	1
-2	1
NULL	3
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
#
# Optimizer trace covers supported TIME predicates and fallback reasons.
#
SET optimizer_trace=1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS time_predicate_count
FROM pq_group_key_types
WHERE g_time > TIME '00:00:00';
time_predicate_count
4
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
NULL
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
SET optimizer_trace= @save_optimizer_trace;
SET optimizer_switch= @save_optimizer_switch;
SET pq_support_features_switch= @save_pq_support_features_switch;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL pq_master_enable= @save_pq_master_enable;
DROP TABLE pq_group_key_types;
