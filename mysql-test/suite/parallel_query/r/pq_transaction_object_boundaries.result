#
# Parallel Query transaction and object boundary coverage.
#
CREATE TABLE lineitem (
l_orderkey INT NOT NULL PRIMARY KEY,
l_shipdate DATE NOT NULL,
l_quantity INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem VALUES
(1, '1979-12-31', 10),
(2, '1980-01-01', 20),
(3, '1980-01-02', 30),
(4, '1981-05-10', 40),
(5, '1992-07-15', 50),
(6, '1978-03-20', 60),
(7, '1980-06-01', 70),
(8, '1985-09-09', 80);
SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_support_features_switch= @@pq_support_features_switch;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_transaction_isolation= @@transaction_isolation;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_optimizer_switch= @@optimizer_switch;
SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=on,correlated_subquery=on,hash_join_spill_to_disk=on,insert_select=on';
SET optimizer_trace= 1;
SET SESSION TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS read_uncommitted_trace_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
read_uncommitted_trace_count
5
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_isolation_or_locking"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET SESSION TRANSACTION ISOLATION LEVEL SERIALIZABLE;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS serializable_trace_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
serializable_trace_count
5
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_isolation_or_locking"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET SESSION transaction_isolation= @save_transaction_isolation;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey
FOR UPDATE;
l_orderkey
3
4
5
7
8
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_isolation_or_locking"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey
LOCK IN SHARE MODE;
l_orderkey
3
4
5
7
8
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_isolation_or_locking"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
START TRANSACTION;
INSERT INTO lineitem VALUES (100, '1984-01-01', 100);
SELECT /*+ PQ(4) */ COUNT(*) AS active_transaction_trace_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
active_transaction_trace_count
6
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_transaction"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
ROLLBACK;
CREATE TEMPORARY TABLE lineitem (
l_orderkey INT NOT NULL PRIMARY KEY,
l_shipdate DATE NOT NULL,
l_quantity INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem VALUES
(200, '1984-01-01', 200),
(201, '1985-01-01', 201);
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS temporary_table_trace_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
temporary_table_trace_count
2
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_temporary_table"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
DROP TEMPORARY TABLE lineitem;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) > 0 AS information_schema_tables_trace_exists
FROM information_schema.tables
WHERE table_schema = 'test';
information_schema_tables_trace_exists
1
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_storage_engine"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET SESSION transaction_isolation= @save_transaction_isolation;
SET optimizer_trace= @save_optimizer_trace;
SET optimizer_switch= @save_optimizer_switch;
SET pq_support_features_switch= @save_pq_support_features_switch;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL pq_master_enable= @save_pq_master_enable;
DROP TABLE lineitem;
