#
# Parallel Query scalar aggregate ORDER BY boundary coverage.
#
CREATE TABLE lineitem (
l_orderkey INT NOT NULL PRIMARY KEY,
l_shipdate DATE NOT NULL,
l_quantity INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem VALUES
(1, '1979-12-31', 10),
(2, '1980-01-01', 20),
(3, '1980-01-02', 30),
(4, '1981-05-10', 40),
(5, '1992-07-15', 50),
(6, '1978-03-20', 60),
(7, '1980-06-01', 70),
(8, '1985-09-09', 80);
SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_support_features_switch= @@pq_support_features_switch;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_transaction_isolation= @@transaction_isolation;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_optimizer_switch= @@optimizer_switch;
SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=on,correlated_subquery=on,hash_join_spill_to_disk=on,insert_select=on';
#
# Scalar aggregate ORDER BY on the single aggregate row is PQ-safe.
#
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS order_count
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY COUNT(*)
LIMIT 1;
order_count
5
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_quantity) AS order_sum
FROM lineitem
WHERE l_shipdate > '1980-01-01'
HAVING SUM(l_quantity) > 0
ORDER BY SUM(l_quantity) DESC
LIMIT 1;
order_sum
270
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
SET optimizer_trace=1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS scalar_order_subquery_count
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY COUNT(*) + (SELECT 1) DESC
LIMIT 1;
scalar_order_subquery_count
5
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
NULL
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS scalar_order_abs_count
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY ABS(COUNT(*) - 6) DESC
LIMIT 1;
scalar_order_abs_count
5
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS scalar_order_subquery_count
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY COUNT(*) + (SELECT 1) DESC
LIMIT 1;
scalar_order_subquery_count
5
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_aggregate_order"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS scalar_order_union_subquery_count
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY COUNT(*) + (SELECT 1 UNION SELECT 1) DESC
LIMIT 1;
scalar_order_union_subquery_count
5
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_aggregate_order"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS scalar_order_base_field_count
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY COUNT(*) + l_quantity DESC
LIMIT 1;
scalar_order_base_field_count
5
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS scalar_order_dependent_subquery_count
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY COUNT(*) + (SELECT lineitem.l_orderkey) DESC
LIMIT 1;
scalar_order_dependent_subquery_count
5
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_aggregate_order"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS order_base_count
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY RAND()
LIMIT 1;
order_base_count
5
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_aggregate_order"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS scalar_order_other_aggregate_count
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY COUNT(*) + MAX(l_quantity) DESC
LIMIT 1;
scalar_order_other_aggregate_count
5
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_aggregate_order"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET optimizer_trace= @save_optimizer_trace;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(NULL) AS null_const_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
null_const_count
0
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET optimizer_trace= @save_optimizer_trace;
SET optimizer_switch= @save_optimizer_switch;
SET SESSION transaction_isolation= @save_transaction_isolation;
SET pq_support_features_switch= @save_pq_support_features_switch;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL pq_master_enable= @save_pq_master_enable;
DROP TABLE lineitem;
