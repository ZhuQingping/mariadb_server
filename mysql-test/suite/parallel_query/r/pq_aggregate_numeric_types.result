#
# Parallel Query numeric aggregate type coverage.
#
SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_optimizer_switch= @@optimizer_switch;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_pq_support_features_switch= @@pq_support_features_switch;
SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=off';
# SUM(base unsigned integer field) uses worker partial sums and leader aggregation.
#
CREATE TABLE lineitem_unsigned_sum (
l_orderkey INT NOT NULL PRIMARY KEY,
l_shipdate DATE NOT NULL,
l_uquantity INT UNSIGNED NULL,
l_ubigquantity BIGINT UNSIGNED NULL
) ENGINE=InnoDB;
INSERT INTO lineitem_unsigned_sum VALUES
(1, '1979-12-31', 10, 9007199254740993),
(2, '1980-01-01', NULL, NULL),
(3, '1980-01-02', 30, 9223372036854775807),
(4, '1981-05-10', 40, 9223372036854775808),
(5, '1992-07-15', 50, 18446744073709551615),
(6, '1978-03-20', 60, 7),
(7, '1980-06-01', NULL, NULL),
(8, '1985-09-09', 80, 11);
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_uquantity) AS sum_unsigned_quantity
FROM lineitem_unsigned_sum
WHERE l_shipdate > '1980-01-01';
sum_unsigned_quantity
200
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_uquantity) AS sum_unsigned_quantity_empty
FROM lineitem_unsigned_sum
WHERE l_shipdate > '2100-01-01';
sum_unsigned_quantity_empty
NULL
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ AVG(l_uquantity) AS avg_unsigned_quantity
FROM lineitem_unsigned_sum
WHERE l_shipdate > '1980-01-01';
avg_unsigned_quantity
50.0000
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS unsigned_quantity_ge_count
FROM lineitem_unsigned_sum
WHERE l_uquantity >= 40;
unsigned_quantity_ge_count
4
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_ubigquantity) AS sum_unsigned_bigint
FROM lineitem_unsigned_sum
WHERE l_shipdate > '1980-01-01';
sum_unsigned_bigint
36893488147419103241
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS unsigned_bigint_ge_count
FROM lineitem_unsigned_sum
WHERE l_ubigquantity >= 9223372036854775808;
unsigned_bigint_ge_count
2
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS unsigned_bigint_reversed_count
FROM lineitem_unsigned_sum
WHERE 9223372036854775808 <= l_ubigquantity;
unsigned_bigint_reversed_count
2
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_ubigquantity) AS sum_unsigned_bigint_no_where
FROM lineitem_unsigned_sum;
sum_unsigned_bigint_no_where
36902495346673844241
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_ubigquantity) AS sum_unsigned_bigint_having
FROM lineitem_unsigned_sum
WHERE l_shipdate > '1980-01-01'
HAVING sum_unsigned_bigint_having = 36893488147419103241;
sum_unsigned_bigint_having
36893488147419103241
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_ubigquantity) AS sum_unsigned_bigint_empty
FROM lineitem_unsigned_sum
WHERE l_shipdate > '2100-01-01';
sum_unsigned_bigint_empty
NULL
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
#
# SUM(base FLOAT/DOUBLE field) uses worker partial sums and leader aggregation.
#
CREATE TABLE lineitem_real_sum (
l_orderkey INT NOT NULL PRIMARY KEY,
l_shipdate DATE NOT NULL,
l_fquantity FLOAT NULL,
l_dquantity DOUBLE NULL
) ENGINE=InnoDB;
INSERT INTO lineitem_real_sum VALUES
(1, '1979-12-31', 0.5, 10.5),
(2, '1980-01-01', NULL, NULL),
(3, '1980-01-02', 1.5, 30.5),
(4, '1981-05-10', 2.0, 40.0),
(5, '1992-07-15', 3.0, 50.0),
(6, '1978-03-20', 4.0, 60.0),
(7, '1980-06-01', NULL, NULL),
(8, '1985-09-09', 5.5, 80.5);
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_fquantity) AS sum_float_quantity
FROM lineitem_real_sum
WHERE l_shipdate > '1980-01-01';
sum_float_quantity
12
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_dquantity) AS sum_double_quantity
FROM lineitem_real_sum
WHERE l_shipdate > '1980-01-01';
sum_double_quantity
201
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_dquantity) AS sum_double_quantity_empty
FROM lineitem_real_sum
WHERE l_shipdate > '2100-01-01';
sum_double_quantity_empty
NULL
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS double_ge_count
FROM lineitem_real_sum
WHERE l_dquantity >= 40.0;
double_ge_count
4
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS double_reversed_count
FROM lineitem_real_sum
WHERE 40.0 <= l_dquantity;
double_reversed_count
4
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS float_lt_count
FROM lineitem_real_sum
WHERE l_fquantity < 2.0;
float_lt_count
2
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_fquantity, l_dquantity
FROM lineitem_real_sum
WHERE l_dquantity >= 40.0
ORDER BY l_orderkey
LIMIT 3;
l_orderkey	l_fquantity	l_dquantity
4	2	40
5	3	50
6	4	60
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
#
# AVG(base FLOAT/DOUBLE field) uses worker partial sums/counts and leader aggregation.
#
FLUSH STATUS;
SELECT /*+ PQ(4) */ AVG(l_fquantity) AS avg_float_quantity
FROM lineitem_real_sum
WHERE l_shipdate > '1980-01-01';
avg_float_quantity
3
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ AVG(l_dquantity) AS avg_double_quantity
FROM lineitem_real_sum
WHERE l_shipdate > '1980-01-01';
avg_double_quantity
50.25
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ AVG(l_dquantity) AS avg_double_quantity_empty
FROM lineitem_real_sum
WHERE l_shipdate > '2100-01-01';
avg_double_quantity_empty
NULL
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=on';
FLUSH STATUS;
SET optimizer_trace=1;
SELECT /*+ PQ(4) */ COUNT(DISTINCT l_dquantity) AS distinct_double_count
FROM lineitem_real_sum
WHERE l_shipdate > '1980-01-01';
distinct_double_count
4
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_distinct_aggregate"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET optimizer_trace= @save_optimizer_trace;
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=off';
#
# SUM(base DECIMAL field) uses worker partial sums and leader aggregation.
#
CREATE TABLE lineitem_decimal_sum (
l_orderkey INT NOT NULL PRIMARY KEY,
l_shipdate DATE NOT NULL,
l_amount DECIMAL(10,2) NULL
) ENGINE=InnoDB;
INSERT INTO lineitem_decimal_sum VALUES
(1, '1979-12-31', 10.25),
(2, '1980-01-01', NULL),
(3, '1980-01-02', 30.50),
(4, '1981-05-10', 40.75),
(5, '1992-07-15', 50.25),
(6, '1978-03-20', 60.00),
(7, '1980-06-01', NULL),
(8, '1985-09-09', 80.50);
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_amount) AS sum_decimal_amount
FROM lineitem_decimal_sum
WHERE l_shipdate > '1980-01-01';
sum_decimal_amount
202.00
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_amount) AS sum_decimal_amount_no_where
FROM lineitem_decimal_sum;
sum_decimal_amount_no_where
272.25
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_amount) AS sum_decimal_amount_empty
FROM lineitem_decimal_sum
WHERE l_shipdate > '2100-01-01';
sum_decimal_amount_empty
NULL
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS decimal_ge_count
FROM lineitem_decimal_sum
WHERE l_amount >= 40.75;
