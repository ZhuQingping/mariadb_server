# DECIMAL expression overflow on the PQ aggregate path is reported as an error.
CREATE TABLE lineitem_decimal_overflow (
l_orderkey INT NOT NULL PRIMARY KEY,
l_shipdate DATE NOT NULL,
l_group INT NOT NULL,
l_amount DECIMAL(65,0) NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem_decimal_overflow VALUES
(1, '1980-01-02', 1, 99999999999999999999999999999999999999999999999999999999999999999),
(100, '1980-01-03', 1, 99999999999999999999999999999999999999999999999999999999999999999);
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_amount * l_amount) AS sum_decimal_expr_overflow
FROM lineitem_decimal_overflow
WHERE l_shipdate > '1980-01-01';
ERROR 22003: DECIMAL value is out of range in '`test`.`lineitem_decimal_overflow`.`l_amount` * `test`.`lineitem_decimal_overflow`.`l_amount`'
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SHOW GLOBAL STATUS LIKE 'PQ_threads_running';
Variable_name	Value
Pq_threads_running	0
SHOW GLOBAL STATUS LIKE 'PQ_memory_used';
Variable_name	Value
Pq_memory_used	0
# DECIMAL grouped merge overflow on the PQ path is reported as an error.
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_group, SUM(l_amount * l_amount) AS group_decimal_expr_overflow
FROM lineitem_decimal_overflow
GROUP BY l_group
ORDER BY l_group;
ERROR 22003: DECIMAL value is out of range in '`test`.`lineitem_decimal_overflow`.`l_amount` * `test`.`lineitem_decimal_overflow`.`l_amount`'
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SHOW GLOBAL STATUS LIKE 'PQ_threads_running';
Variable_name	Value
Pq_threads_running	0
SHOW GLOBAL STATUS LIKE 'PQ_memory_used';
Variable_name	Value
Pq_memory_used	0
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET optimizer_switch= @save_optimizer_switch;
SET optimizer_trace= @save_optimizer_trace;
SET pq_support_features_switch= @save_pq_support_features_switch;
SET GLOBAL pq_master_enable= @save_pq_master_enable;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
DROP TABLE lineitem_decimal_overflow;
DROP TABLE lineitem_decimal_sum;
DROP TABLE lineitem_real_sum;
DROP TABLE lineitem_unsigned_sum;
