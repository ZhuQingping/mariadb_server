#
# Parallel Query storage engine and join fallback coverage.
#
CREATE TABLE lineitem (
l_orderkey INT NOT NULL PRIMARY KEY,
l_shipdate DATE NOT NULL,
l_quantity INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem VALUES
(1, '1979-12-31', 10),
(2, '1980-01-01', 20),
(3, '1980-01-02', 30),
(4, '1981-05-10', 40),
(5, '1992-07-15', 50),
(6, '1978-03-20', 60),
(7, '1980-06-01', 70),
(8, '1985-09-09', 80);
CREATE TABLE lineitem_q6 (
l_orderkey INT NOT NULL,
l_linenumber INT NOT NULL,
l_shipdate DATE NOT NULL,
l_quantity DECIMAL(15,2) NOT NULL,
l_extendedprice DECIMAL(15,2) NOT NULL,
l_discount DECIMAL(15,2) NOT NULL,
PRIMARY KEY (l_orderkey, l_linenumber),
KEY idx_q6_shipdate (l_shipdate)
) ENGINE=InnoDB;
INSERT INTO lineitem_q6 VALUES
(1, 1, '1993-12-31', 10.00, 100.00, 0.06),
(2, 1, '1994-01-01', 12.00, 200.00, 0.05),
(3, 1, '1994-06-15', 23.00, 300.00, 0.06),
(3, 2, '1994-06-16', 18.00, 1000.00, 0.06),
(4, 1, '1994-12-31', 24.00, 400.00, 0.07),
(5, 1, '1995-01-01', 20.00, 500.00, 0.06),
(6, 1, '1994-03-20', 20.00, 600.00, 0.04),
(7, 1, '1994-08-08', 21.00, 700.00, 0.08),
(8, 1, '1994-09-09', 22.00, 800.00, 0.07);
SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_pq_support_features_switch= @@pq_support_features_switch;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_optimizer_switch= @@optimizer_switch;
SET @save_join_cache_level= @@join_cache_level;
SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=on,correlated_subquery=on,hash_join_spill_to_disk=on';
SET optimizer_trace= 1;
CREATE TABLE lineitem_myisam (
l_orderkey INT NOT NULL PRIMARY KEY,
l_shipdate DATE NOT NULL,
l_quantity INT NOT NULL
) ENGINE=MyISAM;
INSERT INTO lineitem_myisam VALUES
(1, '1979-12-31', 10),
(3, '1980-01-02', 30),
(4, '1981-05-10', 40);
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS myisam_count
FROM lineitem_myisam
WHERE l_shipdate > '1980-01-01';
myisam_count
2
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET optimizer_trace=1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS myisam_trace_count
FROM lineitem_myisam
WHERE l_shipdate > '1980-01-01';
myisam_trace_count
2
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_storage_engine"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(q.l_orderkey) AS outer_join_count
FROM lineitem l LEFT JOIN lineitem_q6 q
ON q.l_orderkey = l.l_orderkey
WHERE l.l_shipdate > '1980-01-01';
outer_join_count
6
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_outer_join"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS semijoin_count
FROM lineitem
WHERE l_orderkey IN (
SELECT l_orderkey
FROM lineitem_q6
WHERE l_quantity > 0
);
semijoin_count
8
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_semijoin"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
CREATE TABLE pq_hash_join_left (
a INT NOT NULL,
b INT NOT NULL,
c INT NOT NULL
) ENGINE=InnoDB;
CREATE TABLE pq_hash_join_right (
a INT NOT NULL,
b INT NOT NULL,
c INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO pq_hash_join_left VALUES
(1, 1, 1),
(2, 1, 1),
(3, 2, 1),
(4, 2, 2);
INSERT INTO pq_hash_join_right VALUES
(1, 10, 1),
(2, 20, 1),
(3, 30, 2),
(4, 40, 2),
(5, 50, 3);
SET join_cache_level=6;
SET optimizer_switch='hash_join_cardinality=on,join_cache_hashed=on';
EXPLAIN SELECT /*+ PQ(4) */ COUNT(*) AS hash_join_count
FROM pq_hash_join_left l, pq_hash_join_right r
WHERE l.c = r.c;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	l	ALL	NULL	NULL	NULL	NULL	4	
1	SIMPLE	r	hash_ALL	NULL	#hash#$hj	4	test.l.c	5	Using where; Using join buffer (flat, BNLH join)
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS hash_join_count
FROM pq_hash_join_left l, pq_hash_join_right r
WHERE l.c = r.c;
hash_join_count
8
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_hash_join"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET join_cache_level= @save_join_cache_level;
SET optimizer_trace= @save_optimizer_trace;
SET optimizer_switch= @save_optimizer_switch;
SET pq_support_features_switch= @save_pq_support_features_switch;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL pq_master_enable= @save_pq_master_enable;
DROP TABLE pq_hash_join_right;
DROP TABLE pq_hash_join_left;
DROP TABLE lineitem_myisam;
DROP TABLE lineitem_q6;
DROP TABLE lineitem;
