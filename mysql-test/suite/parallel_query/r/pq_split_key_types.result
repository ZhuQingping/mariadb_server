        "reason": "unsupported_non_integer_split_key"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS varchar_pk_secondary_trace_count
FROM lineitem_varchar_pk FORCE INDEX (idx_varchar_shipdate)
WHERE l_shipdate > '1980-01-01';
varchar_pk_secondary_trace_count
2
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
