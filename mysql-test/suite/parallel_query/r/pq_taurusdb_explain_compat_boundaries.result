#
# TaurusDB EXPLAIN compatibility boundaries for MariaDB PQ v1.
#
SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_optimizer_switch= @@optimizer_switch;
SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
CREATE TABLE lineitem_pq_explain_boundary (
l_orderkey INT NOT NULL,
l_linenumber INT NOT NULL,
l_shipdate DATE NOT NULL,
l_quantity DECIMAL(15,2) NOT NULL,
l_extendedprice DECIMAL(15,2) NOT NULL,
l_discount DECIMAL(15,2) NOT NULL,
PRIMARY KEY (l_orderkey, l_linenumber),
KEY idx_pq_explain_shipdate (l_shipdate)
) ENGINE=InnoDB;
INSERT INTO lineitem_pq_explain_boundary VALUES
(1, 1, '1993-12-31', 10.00, 100.00, 0.06),
(2, 1, '1994-01-01', 12.00, 200.00, 0.05),
(3, 1, '1994-06-15', 23.00, 300.00, 0.06),
(4, 1, '1994-12-31', 24.00, 400.00, 0.07),
(5, 1, '1995-01-01', 20.00, 500.00, 0.06);
# Traditional EXPLAIN exposes the current MariaDB gather node.
EXPLAIN SELECT /*+ PQ(4) */
SUM(l_extendedprice * l_discount) AS revenue
FROM lineitem_pq_explain_boundary FORCE INDEX(idx_pq_explain_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
AND l_quantity < 24;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	<gather1>	ALL	NULL	NULL	NULL	NULL	#	Parallel execute (4 workers, test.lineitem_pq_explain_boundary)
1	SIMPLE	lineitem_pq_explain_boundary	range	idx_pq_explain_shipdate	idx_pq_explain_shipdate	3	NULL	#	Using index condition; Using where
# JSON EXPLAIN exposes parallel_execute for the current gather shape.
EXPLAIN FORMAT=JSON SELECT /*+ PQ(4) */
SUM(l_extendedprice * l_discount) AS revenue
FROM lineitem_pq_explain_boundary FORCE INDEX(idx_pq_explain_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
AND l_quantity < 24;
EXPLAIN
{
  "query_block": {
    "select_id": 1,
    "cost": #,
    "nested_loop": [
      {
        "parallel_execute": {
          "parallel_degree": 4,
          "divided_table": "lineitem_pq_explain_boundary",
          "cut_table": "lineitem_pq_explain_boundary",
          "table": {
            "table_name": "<gather1>",
            "access_type": "ALL",
            "rows": #
          }
        }
      },
      {
        "table": {
          "table_name": "lineitem_pq_explain_boundary",
          "access_type": "range",
          "possible_keys": ["idx_pq_explain_shipdate"],
          "key": "idx_pq_explain_shipdate",
          "key_length": "3",
          "used_key_parts": ["l_shipdate"],
          "loops": 1,
          "rows": #,
          "cost": #,
          "filtered": 100,
          "index_condition": "lineitem_pq_explain_boundary.l_shipdate >= DATE'1994-01-01' and lineitem_pq_explain_boundary.l_shipdate < DATE'1995-01-01'",
          "attached_condition": "lineitem_pq_explain_boundary.l_discount between 0.05 and 0.07 and lineitem_pq_explain_boundary.l_quantity < 24"
        }
      }
    ]
  }
}
# MariaDB ANALYZE FORMAT=JSON is supported at gather/plan level.
ANALYZE FORMAT=JSON SELECT /*+ PQ(4) */
SUM(l_extendedprice * l_discount) AS revenue
FROM lineitem_pq_explain_boundary FORCE INDEX(idx_pq_explain_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
AND l_quantity < 24;
ANALYZE
{
  "query_optimization": {
    "r_total_time_ms": #
  },
  "query_block": {
    "select_id": 1,
    "cost": #,
    "r_loops": 1,
    "r_total_time_ms": #,
    "nested_loop": [
      {
        "parallel_execute": {
          "parallel_degree": 4,
          "divided_table": "lineitem_pq_explain_boundary",
          "cut_table": "lineitem_pq_explain_boundary",
          "table": {
            "table_name": "<gather1>",
            "access_type": "ALL",
            "rows": 3
          }
        }
      },
      {
        "table": {
          "table_name": "lineitem_pq_explain_boundary",
          "access_type": "range",
          "possible_keys": ["idx_pq_explain_shipdate"],
          "key": "idx_pq_explain_shipdate",
          "key_length": "3",
          "used_key_parts": ["l_shipdate"],
          "loops": 1,
          "r_loops": 0,
          "rows": 3,
          "r_index_rows": 0,
          "r_rows": null,
          "cost": #,
          "r_table_time_ms": #,
          "r_other_time_ms": #,
          "r_engine_stats": {
            "pages_accessed": #
          },
          "filtered": 100,
          "r_total_filtered": null,
          "index_condition": "lineitem_pq_explain_boundary.l_shipdate >= DATE'1994-01-01' and lineitem_pq_explain_boundary.l_shipdate < DATE'1995-01-01'",
          "r_icp_filtered": 0,
          "attached_condition": "lineitem_pq_explain_boundary.l_discount between 0.05 and 0.07 and lineitem_pq_explain_boundary.l_quantity < 24",
          "r_filtered": null
        }
      }
    ]
  }
}
# The same query executes on the current PQ path.
FLUSH STATUS;
SELECT /*+ PQ(4) */
SUM(l_extendedprice * l_discount) AS revenue
FROM lineitem_pq_explain_boundary FORCE INDEX(idx_pq_explain_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
AND l_quantity < 24;
revenue
28.0000
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
# MariaDB does not claim MySQL/TaurusDB EXPLAIN FORMAT=TREE parity.
EXPLAIN FORMAT=TREE SELECT /*+ PQ(4) */
SUM(l_extendedprice * l_discount) AS revenue
FROM lineitem_pq_explain_boundary FORCE INDEX(idx_pq_explain_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
AND l_quantity < 24;
ERROR HY000: Unknown EXPLAIN/ANALYZE format name: 'TREE'
# MariaDB uses ANALYZE SELECT/ANALYZE FORMAT=JSON, not MySQL EXPLAIN ANALYZE worker timing.
EXPLAIN ANALYZE SELECT /*+ PQ(4) */
SUM(l_extendedprice * l_discount) AS revenue
FROM lineitem_pq_explain_boundary FORCE INDEX(idx_pq_explain_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
AND l_quantity < 24;
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near 'ANALYZE SELECT /*+ PQ(4) */
SUM(l_extendedprice * l_discount) AS revenue
FROM...' at line 1
SET optimizer_switch= @save_optimizer_switch;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL pq_master_enable= @save_pq_master_enable;
DROP TABLE lineitem_pq_explain_boundary;
