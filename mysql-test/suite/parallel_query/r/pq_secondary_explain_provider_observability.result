SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
# Runtime trace identifies the non-covering secondary scalar aggregate native provider.
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(extendedprice * discount) AS noncovering_revenue
FROM pq_secondary_observe FORCE INDEX(idx_shipdate)
WHERE shipdate >= DATE '1994-01-01'
  AND shipdate < DATE '1995-01-01';
noncovering_revenue
71.0000
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].scan_provider') AS noncovering_aggregate_provider
FROM information_schema.optimizer_trace;
noncovering_aggregate_provider
["innodb_secondary_range"]
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].handler_scan_available') AS noncovering_aggregate_handler_available
FROM information_schema.optimizer_trace;
noncovering_aggregate_handler_available
[true]
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].btree_descriptor_rejected_reason') AS noncovering_aggregate_descriptor_rejected_reason
FROM information_schema.optimizer_trace;
noncovering_aggregate_descriptor_rejected_reason
["secondary_index"]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
SET optimizer_trace= @save_optimizer_trace;
SET optimizer_switch= @save_optimizer_switch;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL pq_master_enable= @save_pq_master_enable;
DROP TABLE pq_secondary_observe;
