#
# Parallel Query secondary provider EXPLAIN and runtime observability.
#
SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_optimizer_switch= @@optimizer_switch;
SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on,index_condition_pushdown=off';
SET optimizer_trace= 1;
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
CREATE TABLE pq_secondary_observe (
id INT NOT NULL,
line_no INT NOT NULL,
shipdate DATE NOT NULL,
qty DECIMAL(15,2) NOT NULL,
extendedprice DECIMAL(15,2) NOT NULL,
discount DECIMAL(15,2) NOT NULL,
PRIMARY KEY (id, line_no),
KEY idx_shipdate (shipdate)
) ENGINE=InnoDB;
INSERT INTO pq_secondary_observe VALUES
(1, 1, '1993-12-31', 10.00, 100.00, 0.06),
(2, 1, '1994-01-01', 12.00, 200.00, 0.05),
(3, 1, '1994-02-15', 18.00, 250.00, 0.06),
(4, 1, '1994-06-15', 23.00, 300.00, 0.06),
(5, 1, '1994-12-31', 24.00, 400.00, 0.07),
(6, 1, '1995-01-01', 20.00, 500.00, 0.06);
# JSON EXPLAIN exposes gather for covering secondary projection.
EXPLAIN FORMAT=JSON SELECT /*+ PQ(4) */ shipdate AS covering_shipdate
FROM pq_secondary_observe FORCE INDEX(idx_shipdate)
WHERE shipdate >= DATE '1994-01-01'
  AND shipdate < DATE '1995-01-01'
ORDER BY shipdate;
EXPLAIN
{
  "query_block": {
    "select_id": 1,
    "cost": #,
    "nested_loop": [
      {
        "parallel_execute": {
          "parallel_degree": 4,
          "divided_table": "pq_secondary_observe",
          "cut_table": "pq_secondary_observe",
          "table": {
            "table_name": "<gather1>",
            "access_type": "ALL",
            "rows": #
          }
        }
      },
      {
        "table": {
          "table_name": "pq_secondary_observe",
          "access_type": "range",
          "possible_keys": ["idx_shipdate"],
          "key": "idx_shipdate",
          "key_length": "3",
          "used_key_parts": ["shipdate"],
          "loops": 1,
          "rows": #,
          "cost": #,
          "filtered": 100,
          "attached_condition": "pq_secondary_observe.shipdate >= DATE'1994-01-01' and pq_secondary_observe.shipdate < DATE'1995-01-01'",
          "using_index": true
        }
      }
    ]
  }
}
# ANALYZE FORMAT=JSON exposes gather for non-covering secondary projection.
ANALYZE FORMAT=JSON SELECT /*+ PQ(4) */ qty AS noncovering_qty
FROM pq_secondary_observe FORCE INDEX(idx_shipdate)
WHERE shipdate >= DATE '1994-01-01'
  AND shipdate < DATE '1995-01-01'
ORDER BY shipdate, qty;
ANALYZE
{
  "query_optimization": {
    "r_total_time_ms": #
  },
  "query_block": {
    "select_id": 1,
    "cost": #,
    "r_loops": 1,
    "r_total_time_ms": #,
    "nested_loop": [
      {
        "parallel_execute": {
          "parallel_degree": 4,
          "divided_table": "pq_secondary_observe",
          "cut_table": "pq_secondary_observe",
          "table": {
            "table_name": "<gather1>",
            "access_type": "ALL",
            "rows": 4
          }
        }
      },
      {
        "read_sorted_file": {
          "r_rows": null,
          "filesort": {
            "sort_key": "pq_secondary_observe.shipdate, pq_secondary_observe.qty",
            "r_loops": null,
            "r_limit": null,
            "r_used_priority_queue": null,
            "r_output_rows": null,
            "r_sort_mode": "sort_key,rowid",
            "table": {
              "table_name": "pq_secondary_observe",
              "access_type": "range",
              "possible_keys": ["idx_shipdate"],
              "key": "idx_shipdate",
              "key_length": "3",
              "used_key_parts": ["shipdate"],
              "loops": 1,
              "r_loops": 0,
              "rows": 4,
              "r_rows": null,
              "cost": #,
              "r_table_time_ms": #,
              "r_other_time_ms": #,
              "r_engine_stats": {
                "pages_accessed": #
              },
              "filtered": 100,
              "r_total_filtered": null,
              "attached_condition": "pq_secondary_observe.shipdate >= DATE'1994-01-01' and pq_secondary_observe.shipdate < DATE'1995-01-01'",
              "r_filtered": null
            }
          }
        }
      }
    ]
  }
}
# Runtime trace identifies the covering secondary native provider.
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ shipdate AS covering_shipdate
FROM pq_secondary_observe FORCE INDEX(idx_shipdate)
WHERE shipdate >= DATE '1994-01-01'
  AND shipdate < DATE '1995-01-01'
ORDER BY shipdate;
covering_shipdate
1994-01-01
1994-02-15
1994-06-15
1994-12-31
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].scan_provider') AS covering_projection_provider
FROM information_schema.optimizer_trace;
covering_projection_provider
["innodb_secondary_range"]
SELECT json_extract(trace,
'$**.parallel_query_scan_provider[0].handler_scan_available') AS covering_projection_handler_available
FROM information_schema.optimizer_trace;
covering_projection_handler_available
[true]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
# Runtime trace identifies the non-covering secondary native provider.
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ qty AS noncovering_qty
FROM pq_secondary_observe FORCE INDEX(idx_shipdate)
WHERE shipdate >= DATE '1994-01-01'
  AND shipdate < DATE '1995-01-01'
ORDER BY shipdate, qty;
