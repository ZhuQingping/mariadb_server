#
# Parallel Query Q1 split-range full aggregate merge coverage.
#
SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_optimizer_switch= @@optimizer_switch;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_transaction_isolation= @@transaction_isolation;
SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET optimizer_trace= 'enabled=on';
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
CREATE TABLE lineitem_q1_split_merge (
l_orderkey INT NOT NULL,
l_linenumber INT NOT NULL,
l_shipdate DATE NOT NULL,
l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
l_quantity DECIMAL(15,2) NOT NULL,
l_extendedprice DECIMAL(15,2) NOT NULL,
l_discount DECIMAL(15,2) NOT NULL,
l_tax DECIMAL(15,2) NOT NULL,
PRIMARY KEY (l_orderkey, l_linenumber)
) ENGINE=InnoDB;
# The same Q1 group keys are intentionally spread across primary-key ranges.
INSERT INTO lineitem_q1_split_merge VALUES
(1, 1, '1998-09-01', 'A', 'F', 10.00, 100.00, 0.05, 0.10),
(2, 1, '1998-08-30', 'N', 'O', 40.00, 400.00, 0.07, 0.05),
(300, 1, '1998-09-02', 'A', 'F', 20.00, 200.00, 0.10, 0.08),
(400, 1, '1998-08-31', 'N', 'O', 50.00, 500.00, 0.06, 0.03),
(700, 1, '1998-07-15', 'A', 'F', 60.00, 600.00, 0.08, 0.07),
(800, 1, '1998-07-16', 'N', 'O', 70.00, 700.00, 0.04, 0.02),
(1000, 1, '1998-09-03', 'R', 'F', 30.00, 300.00, 0.02, 0.04);
# Serial baseline with complete constrained Q1 aggregate list.
FLUSH STATUS;
SELECT /*+ NO_PQ */
l_returnflag,
l_linestatus,
SUM(l_quantity) AS sum_qty,
SUM(l_extendedprice) AS sum_base_price,
SUM(l_extendedprice * (1 - l_discount)) AS sum_disc_price,
SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax)) AS sum_charge,
AVG(l_quantity) AS avg_qty,
AVG(l_extendedprice) AS avg_price,
AVG(l_discount) AS avg_disc,
COUNT(*) AS count_order
FROM lineitem_q1_split_merge
WHERE l_shipdate <= DATE '1998-12-01' - INTERVAL '90' DAY
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	sum_qty	sum_base_price	sum_disc_price	sum_charge	avg_qty	avg_price	avg_disc	count_order
A	F	90.00	900.00	827.0000	889.540000	30.000000	300.000000	0.076667	3
N	O	160.00	1600.00	1514.0000	1560.140000	53.333333	533.333333	0.056667	3
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
# PQ path must merge partial rows for the same group from different workers.
FLUSH STATUS;
SELECT /*+ PQ(4) */
l_returnflag,
l_linestatus,
SUM(l_quantity) AS sum_qty,
SUM(l_extendedprice) AS sum_base_price,
SUM(l_extendedprice * (1 - l_discount)) AS sum_disc_price,
SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax)) AS sum_charge,
AVG(l_quantity) AS avg_qty,
AVG(l_extendedprice) AS avg_price,
AVG(l_discount) AS avg_disc,
COUNT(*) AS count_order
FROM lineitem_q1_split_merge
WHERE l_shipdate <= DATE '1998-12-01' - INTERVAL '90' DAY
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	sum_qty	sum_base_price	sum_disc_price	sum_charge	avg_qty	avg_price	avg_disc	count_order
A	F	90.00	900.00	827.0000	889.540000	30.000000	300.000000	0.076667	3
N	O	160.00	1600.00	1514.0000	1560.140000	53.333333	533.333333	0.056667	3
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
# Full Q1 list falls back under unsupported isolation and locking modes.
SET SESSION TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;
FLUSH STATUS;
SELECT /*+ PQ(4) */
l_returnflag,
l_linestatus,
SUM(l_quantity) AS sum_qty,
SUM(l_extendedprice) AS sum_base_price,
SUM(l_extendedprice * (1 - l_discount)) AS sum_disc_price,
SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax)) AS sum_charge,
AVG(l_quantity) AS avg_qty,
AVG(l_extendedprice) AS avg_price,
AVG(l_discount) AS avg_disc,
COUNT(*) AS count_order
FROM lineitem_q1_split_merge
WHERE l_shipdate <= DATE '1998-12-01' - INTERVAL '90' DAY
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	sum_qty	sum_base_price	sum_disc_price	sum_charge	avg_qty	avg_price	avg_disc	count_order
A	F	90.00	900.00	827.0000	889.540000	30.000000	300.000000	0.076667	3
N	O	160.00	1600.00	1514.0000	1560.140000	53.333333	533.333333	0.056667	3
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_isolation_or_locking"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET SESSION TRANSACTION ISOLATION LEVEL SERIALIZABLE;
FLUSH STATUS;
SELECT /*+ PQ(4) */
l_returnflag,
l_linestatus,
SUM(l_quantity) AS sum_qty,
SUM(l_extendedprice) AS sum_base_price,
SUM(l_extendedprice * (1 - l_discount)) AS sum_disc_price,
SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax)) AS sum_charge,
AVG(l_quantity) AS avg_qty,
AVG(l_extendedprice) AS avg_price,
AVG(l_discount) AS avg_disc,
COUNT(*) AS count_order
FROM lineitem_q1_split_merge
WHERE l_shipdate <= DATE '1998-12-01' - INTERVAL '90' DAY
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	sum_qty	sum_base_price	sum_disc_price	sum_charge	avg_qty	avg_price	avg_disc	count_order
A	F	90.00	900.00	827.0000	889.540000	30.000000	300.000000	0.076667	3
N	O	160.00	1600.00	1514.0000	1560.140000	53.333333	533.333333	0.056667	3
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_isolation_or_locking"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET SESSION transaction_isolation= @save_transaction_isolation;
FLUSH STATUS;
SELECT /*+ PQ(4) */
l_returnflag,
l_linestatus,
SUM(l_quantity) AS sum_qty,
SUM(l_extendedprice) AS sum_base_price,
SUM(l_extendedprice * (1 - l_discount)) AS sum_disc_price,
SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax)) AS sum_charge,
AVG(l_quantity) AS avg_qty,
AVG(l_extendedprice) AS avg_price,
AVG(l_discount) AS avg_disc,
COUNT(*) AS count_order
FROM lineitem_q1_split_merge
WHERE l_shipdate <= DATE '1998-12-01' - INTERVAL '90' DAY
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus
FOR UPDATE;
l_returnflag	l_linestatus	sum_qty	sum_base_price	sum_disc_price	sum_charge	avg_qty	avg_price	avg_disc	count_order
