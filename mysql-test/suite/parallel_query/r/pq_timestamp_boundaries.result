SET time_zone= '+05:30';
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS timestamp_trace_count
FROM lineitem_ts
WHERE l_shipts > '1980-01-01 00:00:00';
timestamp_trace_count
3
