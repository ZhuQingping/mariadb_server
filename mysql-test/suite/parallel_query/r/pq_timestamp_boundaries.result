#
# Parallel Query TIMESTAMP boundary coverage.
#
SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_support_features_switch= @@pq_support_features_switch;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_optimizer_switch= @@optimizer_switch;
SET @save_time_zone= @@time_zone;
SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=on,correlated_subquery=on,hash_join_spill_to_disk=on,insert_select=on';
#
# TIMESTAMP predicates fall back because worker THDs do not clone session time zone.
#
CREATE TABLE lineitem_ts (
l_orderkey INT NOT NULL PRIMARY KEY,
l_shipts TIMESTAMP NOT NULL,
l_quantity INT NOT NULL
) ENGINE=InnoDB;
SET time_zone= '+00:00';
INSERT INTO lineitem_ts VALUES
(1, '1979-12-31 23:00:00', 10),
(2, '1980-01-01 01:00:00', 20),
(3, '1980-01-02 00:00:00', 30);
SET time_zone= '+05:30';
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS timestamp_count
FROM lineitem_ts
WHERE l_shipts > '1980-01-01 00:00:00';
timestamp_count
3
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ NO_PQ */ MIN(l_shipts) AS min_shipts
FROM lineitem_ts;
min_shipts
1980-01-01 04:30:00
SELECT /*+ PQ(4) */ MIN(l_shipts) AS min_shipts
FROM lineitem_ts;
min_shipts
1980-01-01 04:30:00
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS MIN(l_shipts) AS min_shipts_found_rows
FROM lineitem_ts;
min_shipts_found_rows
1980-01-01 04:30:00
SELECT FOUND_ROWS() AS found_rows_after_timestamp_min;
found_rows_after_timestamp_min
1
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ NO_PQ */ MAX(l_shipts) AS max_shipts
FROM lineitem_ts;
max_shipts
1980-01-02 05:30:00
SELECT /*+ PQ(4) */ MAX(l_shipts) AS max_shipts
FROM lineitem_ts;
max_shipts
1980-01-02 05:30:00
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ NO_PQ */ MIN(l_shipts) AS min_shipts_quantity
FROM lineitem_ts
WHERE l_quantity >= 20;
min_shipts_quantity
1980-01-01 06:30:00
SELECT /*+ PQ(4) */ MIN(l_shipts) AS min_shipts_quantity
FROM lineitem_ts
WHERE l_quantity >= 20;
min_shipts_quantity
1980-01-01 06:30:00
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ NO_PQ */ MAX(l_shipts) AS max_shipts_quantity
FROM lineitem_ts
WHERE l_quantity <= 20;
max_shipts_quantity
1980-01-01 06:30:00
SELECT /*+ PQ(4) */ MAX(l_shipts) AS max_shipts_quantity
FROM lineitem_ts
WHERE l_quantity <= 20;
max_shipts_quantity
1980-01-01 06:30:00
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ NO_PQ */ l_orderkey, l_shipts
FROM lineitem_ts
ORDER BY l_orderkey;
l_orderkey	l_shipts
1	1980-01-01 04:30:00
2	1980-01-01 06:30:00
3	1980-01-02 05:30:00
SELECT /*+ PQ(4) */ l_orderkey, l_shipts
FROM lineitem_ts
ORDER BY l_orderkey;
