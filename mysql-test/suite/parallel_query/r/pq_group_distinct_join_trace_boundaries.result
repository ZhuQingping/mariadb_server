Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ q.l_returnflag, q.l_linestatus,
SUM(q.l_quantity * f.flag_weight) AS weighted_qty
FROM lineitem_q1_group q
JOIN lineitem_q1_flag f ON f.l_returnflag = q.l_returnflag
WHERE q.l_shipdate <= DATE '1998-09-02'
GROUP BY q.l_returnflag, q.l_linestatus
ORDER BY q.l_returnflag, q.l_linestatus;
l_returnflag	l_linestatus	weighted_qty
A	F	30.00
N	O	180.00
R	F	180.00
