FLUSH STATUS;
SELECT /*+ QB_NAME(pq_table_qb_bad_dop) PQ(lineitem_pq_syntax @pq_table_qb_bad_dop, 0) */
SUM(l_extendedprice * l_discount) AS revenue
FROM lineitem_pq_syntax
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01';
