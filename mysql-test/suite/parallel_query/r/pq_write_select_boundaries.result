#
# Parallel Query write-select boundary coverage.
#
CREATE TABLE lineitem (
l_orderkey INT NOT NULL PRIMARY KEY,
l_shipdate DATE NOT NULL,
l_quantity INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem VALUES
(1, '1979-12-31', 10),
(2, '1980-01-01', 20),
(3, '1980-01-02', 30),
(4, '1981-05-10', 40),
(5, '1992-07-15', 50),
(6, '1978-03-20', 60),
(7, '1980-06-01', 70),
(8, '1985-09-09', 80);
CREATE TABLE lineitem_q1_group (
l_orderkey INT NOT NULL,
l_linenumber INT NOT NULL,
l_shipdate DATE NOT NULL,
l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
l_quantity DECIMAL(15,2) NOT NULL,
PRIMARY KEY (l_orderkey, l_linenumber)
) ENGINE=InnoDB;
INSERT INTO lineitem_q1_group VALUES
(1, 1, '1998-09-01', 'A', 'F', 10.00),
(2, 1, '1998-09-02', 'A', 'F', 20.00),
(3, 1, '1998-09-03', 'A', 'F', 30.00),
(4, 1, '1998-08-30', 'N', 'O', 40.00),
(5, 1, '1998-08-31', 'N', 'O', 50.00),
(6, 1, '1998-07-01', 'R', 'F', 60.00);
SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_pq_support_features_switch= @@pq_support_features_switch;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_optimizer_switch= @@optimizer_switch;
SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=on,correlated_subquery=on,hash_join_spill_to_disk=on,insert_select=off';
SET optimizer_trace= 1;
# The insert_select feature bit being off keeps write-select on the serial path.
CREATE TABLE pq_insert_select_switch_off_target (
l_orderkey INT NOT NULL PRIMARY KEY,
l_quantity INT NOT NULL
) ENGINE=InnoDB;
FLUSH STATUS;
INSERT INTO pq_insert_select_switch_off_target
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_insert_select"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SELECT * FROM pq_insert_select_switch_off_target ORDER BY l_orderkey;
l_orderkey	l_quantity
3	30
4	40
5	50
7	70
8	80
DROP TABLE pq_insert_select_switch_off_target;
# Enabling the TaurusDB insert_select bit still does not broaden MariaDB v1.
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=on,correlated_subquery=on,hash_join_spill_to_disk=on,insert_select=on';
CREATE TABLE pq_insert_select_target (
l_orderkey INT NOT NULL PRIMARY KEY,
l_quantity INT NOT NULL
) ENGINE=InnoDB;
FLUSH STATUS;
INSERT INTO pq_insert_select_target
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_insert_select"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SELECT * FROM pq_insert_select_target ORDER BY l_orderkey;
l_orderkey	l_quantity
3	30
4	40
5	50
7	70
8	80
DROP TABLE pq_insert_select_target;
CREATE TABLE pq_insert_select_agg_target (
row_count BIGINT NOT NULL,
sum_quantity BIGINT NOT NULL
) ENGINE=InnoDB;
FLUSH STATUS;
INSERT INTO pq_insert_select_agg_target
SELECT /*+ PQ(4) */ COUNT(*) AS row_count, SUM(l_quantity) AS sum_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_insert_select"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SELECT * FROM pq_insert_select_agg_target;
row_count	sum_quantity
5	270
DROP TABLE pq_insert_select_agg_target;
CREATE TABLE pq_insert_select_q1_group_target (
l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
sum_qty DECIMAL(15,2) NOT NULL,
count_order BIGINT NOT NULL,
PRIMARY KEY (l_returnflag, l_linestatus)
) ENGINE=InnoDB;
FLUSH STATUS;
INSERT INTO pq_insert_select_q1_group_target
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
SUM(l_quantity) AS sum_qty, COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_insert_select"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SELECT * FROM pq_insert_select_q1_group_target
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	sum_qty	count_order
A	F	30.00	2
N	O	90.00	2
R	F	60.00	1
DROP TABLE pq_insert_select_q1_group_target;
CREATE TABLE pq_replace_select_target (
l_orderkey INT NOT NULL PRIMARY KEY,
l_quantity INT NOT NULL
) ENGINE=InnoDB;
FLUSH STATUS;
REPLACE INTO pq_replace_select_target
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_insert_select"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SELECT * FROM pq_replace_select_target ORDER BY l_orderkey;
l_orderkey	l_quantity
3	30
4	40
5	50
7	70
8	80
DROP TABLE pq_replace_select_target;
CREATE TABLE pq_replace_select_agg_target (
metric VARCHAR(32) NOT NULL PRIMARY KEY,
value BIGINT NOT NULL
) ENGINE=InnoDB;
FLUSH STATUS;
REPLACE INTO pq_replace_select_agg_target
SELECT /*+ PQ(4) */ 'row_count' AS metric, COUNT(*) AS value
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_insert_select"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SELECT * FROM pq_replace_select_agg_target ORDER BY metric;
metric	value
row_count	5
DROP TABLE pq_replace_select_agg_target;
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
