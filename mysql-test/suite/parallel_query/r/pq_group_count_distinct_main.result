#
# Grouped COUNT(DISTINCT) field, expression, memory admission,
# EXPLAIN, HAVING, and SQL_CALC_FOUND_ROWS boundaries.
#
SET @save_pq_support_features_switch= @@pq_support_features_switch;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_optimizer_trace= @@optimizer_trace;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_trace= 'enabled=on';
#
# Grouped COUNT(DISTINCT field) merges worker-local distinct sets.
#
CREATE TABLE lineitem_group_distinct (
l_orderkey INT NOT NULL PRIMARY KEY,
l_shipdate DATE NOT NULL,
l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
l_quantity INT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem_group_distinct VALUES
(1, '1998-09-01', 'A', 'F', 10),
(2, '1998-09-01', 'A', 'F', 20),
(75, '1998-09-01', 'A', 'F', 10),
(76, '1998-09-01', 'N', 'O', 30),
(150, '1998-09-01', 'A', 'F', NULL),
(151, '1998-09-01', 'N', 'O', 30),
(152, '1998-09-01', 'N', 'O', 40),
(153, '1998-09-03', 'R', 'F', 50);
FLUSH STATUS;
SELECT /*+ NO_PQ */ l_returnflag, l_linestatus,
COUNT(DISTINCT l_quantity) AS distinct_qty_serial_count
FROM lineitem_group_distinct
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	distinct_qty_serial_count
A	F	2
N	O	2
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=off';
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
COUNT(DISTINCT l_quantity) AS distinct_qty_switch_off_count
FROM lineitem_group_distinct
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	distinct_qty_switch_off_count
A	F	2
N	O	2
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=on';
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
COUNT(*) AS count_order,
SUM(l_quantity) AS sum_qty,
COUNT(DISTINCT l_quantity) AS distinct_qty_count
FROM lineitem_group_distinct
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	count_order	sum_qty	distinct_qty_count
A	F	4	40	2
N	O	3	100	2
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ NO_PQ */ l_returnflag, l_linestatus,
COUNT(DISTINCT l_quantity + (l_orderkey MOD 2)) AS distinct_qty_expr_serial_count
FROM lineitem_group_distinct
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	distinct_qty_expr_serial_count
A	F	2
N	O	3
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
COUNT(DISTINCT l_quantity + (l_orderkey MOD 2)) AS distinct_qty_expr_count
FROM lineitem_group_distinct
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	distinct_qty_expr_count
A	F	2
N	O	3
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
connect  pq_group_distinct_expr_memory_leader, localhost, root,,test;
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=on';
SET debug_sync= 'after_pq_materialized_result_ready SIGNAL pq_group_distinct_expr_ready WAIT_FOR pq_group_distinct_expr_release';
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus, COUNT(DISTINCT l_quantity + (l_orderkey MOD 2)) AS distinct_qty_expr_memory_count FROM lineitem_group_distinct WHERE l_shipdate <= DATE '1998-09-02' GROUP BY l_returnflag, l_linestatus ORDER BY l_returnflag, l_linestatus;
connection default;
SET debug_sync= 'now WAIT_FOR pq_group_distinct_expr_ready TIMEOUT 30';
SELECT CAST(VARIABLE_VALUE AS UNSIGNED) > 0 AS pq_group_distinct_expr_memory_reserved
FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME= 'PQ_MEMORY_USED';
pq_group_distinct_expr_memory_reserved
1
SET debug_sync= 'now SIGNAL pq_group_distinct_expr_release';
connection pq_group_distinct_expr_memory_leader;
l_returnflag	l_linestatus	distinct_qty_expr_memory_count
A	F	2
N	O	3
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
SET debug_sync= 'RESET';
disconnect pq_group_distinct_expr_memory_leader;
connection default;
SHOW GLOBAL STATUS LIKE 'PQ_memory_used';
Variable_name	Value
Pq_memory_used	0
SET debug_sync= 'RESET';
# Grouped COUNT(DISTINCT expr) memory admission uses all expression dependency fields.
Table	Op	Msg_type	Msg_text
test.lineitem_group_distinct_memory	analyze	status	Engine-independent statistics collected
test.lineitem_group_distinct_memory	analyze	status	OK
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
COUNT(DISTINCT l_quantity + (l_orderkey MOD 2)) AS distinct_qty_expr_memory_limit_count
FROM lineitem_group_distinct_memory
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	distinct_qty_expr_memory_limit_count
A	F	2
N	O	3
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SELECT CAST(VARIABLE_VALUE AS UNSIGNED) > @pq_memory_refused_before AS pq_group_distinct_expr_memory_refused
FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME= 'PQ_MEMORY_REFUSED';
pq_group_distinct_expr_memory_refused
1
SET GLOBAL parallel_memory_limit= 104857600;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
COUNT(DISTINCT CONCAT(l_quantity, '')) AS distinct_qty_string_expr_count
FROM lineitem_group_distinct
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	distinct_qty_string_expr_count
A	F	2
N	O	2
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
