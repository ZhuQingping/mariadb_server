SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
SET debug_sync= 'RESET';
connection pq_mvcc_writer2;
SELECT l_returnflag, l_linestatus,
SUM(l_quantity) AS mvcc_q1_current_sum_qty,
SUM(l_extendedprice) AS mvcc_q1_current_sum_base_price,
SUM(l_extendedprice * (1 - l_discount)) AS mvcc_q1_current_sum_disc_price,
SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax)) AS mvcc_q1_current_sum_charge,
AVG(l_quantity) AS mvcc_q1_current_avg_qty,
AVG(l_extendedprice) AS mvcc_q1_current_avg_price,
AVG(l_discount) AS mvcc_q1_current_avg_disc,
COUNT(*) AS mvcc_q1_current_count
FROM lineitem_mvcc_q1
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
