#
# MVCC, isolation, and locking boundaries for current PQ worker paths.
#
SET @save_transaction_isolation= @@transaction_isolation;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_debug_dbug= @@debug_dbug;
SET GLOBAL parallel_memory_limit= 104857600;
CREATE TABLE lineitem (
l_orderkey INT NOT NULL PRIMARY KEY,
l_shipdate DATE NOT NULL,
l_quantity INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem VALUES
(1, '1979-12-31', 10),
(2, '1980-01-01', 20),
(3, '1980-01-02', 30),
(4, '1981-05-10', 40),
(5, '1992-07-15', 50),
(6, '1978-03-20', 60),
(7, '1980-06-01', 70),
(8, '1985-09-09', 80);
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS read_committed_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
read_committed_count
5
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
CREATE TABLE lineitem_mvcc_snapshot (
l_orderkey INT NOT NULL PRIMARY KEY,
l_shipdate DATE NOT NULL,
l_quantity INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem_mvcc_snapshot VALUES
(1, '1980-01-02', 10),
(2, '1981-01-02', 20),
(3, '1979-01-02', 30);
connect  pq_mvcc_reader, localhost, root,,test;
connect  pq_mvcc_writer, localhost, root,,test;
connection pq_mvcc_reader;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
SET debug_sync= 'after_pq_create_snapshot SIGNAL pq_mvcc_rr_snapshot WAIT_FOR pq_mvcc_rr_release';
SELECT /*+ PQ(4) */ COUNT(*) AS mvcc_rr_count FROM lineitem_mvcc_snapshot WHERE l_shipdate > '1980-01-01';
connection pq_mvcc_writer;
SET debug_sync= 'now WAIT_FOR pq_mvcc_rr_snapshot TIMEOUT 30';
INSERT INTO lineitem_mvcc_snapshot VALUES (4, '1982-01-02', 40);
UPDATE lineitem_mvcc_snapshot SET l_shipdate= '1983-01-02' WHERE l_orderkey= 3;
DELETE FROM lineitem_mvcc_snapshot WHERE l_orderkey= 1;
SET debug_sync= 'now SIGNAL pq_mvcc_rr_release';
connection pq_mvcc_reader;
mvcc_rr_count
2
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
SET debug_sync= 'RESET';
connection pq_mvcc_writer;
SELECT COUNT(*) AS mvcc_current_count
FROM lineitem_mvcc_snapshot
WHERE l_shipdate > '1980-01-01';
mvcc_current_count
3
TRUNCATE TABLE lineitem_mvcc_snapshot;
INSERT INTO lineitem_mvcc_snapshot VALUES
(1, '1980-01-02', 10),
(2, '1981-01-02', 20),
(3, '1979-01-02', 30);
connection pq_mvcc_reader;
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
SET debug_sync= 'after_pq_create_snapshot SIGNAL pq_mvcc_rc_snapshot WAIT_FOR pq_mvcc_rc_release';
SELECT /*+ PQ(4) */ COUNT(*) AS mvcc_rc_count FROM lineitem_mvcc_snapshot WHERE l_shipdate > '1980-01-01';
connection pq_mvcc_writer;
SET debug_sync= 'now WAIT_FOR pq_mvcc_rc_snapshot TIMEOUT 30';
INSERT INTO lineitem_mvcc_snapshot VALUES (4, '1982-01-02', 40);
UPDATE lineitem_mvcc_snapshot SET l_shipdate= '1983-01-02' WHERE l_orderkey= 3;
DELETE FROM lineitem_mvcc_snapshot WHERE l_orderkey= 1;
SET debug_sync= 'now SIGNAL pq_mvcc_rc_release';
connection pq_mvcc_reader;
mvcc_rc_count
2
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	2
SET debug_sync= 'RESET';
disconnect pq_mvcc_reader;
connection pq_mvcc_writer;
SELECT COUNT(*) AS mvcc_current_count
FROM lineitem_mvcc_snapshot
WHERE l_shipdate > '1980-01-01';
mvcc_current_count
3
TRUNCATE TABLE lineitem_mvcc_snapshot;
