connection pq_mvcc_reader2;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
FLUSH STATUS;
SET debug_sync= 'after_pq_create_snapshot SIGNAL pq_mvcc_q1_rr_snapshot WAIT_FOR pq_mvcc_q1_rr_release';
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus, SUM(l_quantity) AS sum_qty, SUM(l_extendedprice) AS sum_base_price, SUM(l_extendedprice * (1 - l_discount)) AS sum_disc_price, SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax)) AS sum_charge, AVG(l_quantity) AS avg_qty, AVG(l_extendedprice) AS avg_price, AVG(l_discount) AS avg_disc, COUNT(*) AS count_order FROM lineitem_mvcc_q1 WHERE l_shipdate <= DATE '1998-09-02' GROUP BY l_returnflag, l_linestatus ORDER BY l_returnflag, l_linestatus;
connection pq_mvcc_writer2;
SET debug_sync= 'now WAIT_FOR pq_mvcc_q1_rr_snapshot TIMEOUT 30';
