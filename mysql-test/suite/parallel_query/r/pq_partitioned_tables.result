(2, '1980-01-02', 20),
(3, '1980-01-02', 30),
(4, '1981-05-10', 40),
(5, '1981-05-10', 50),
(6, '1985-09-09', 60);
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS partition_list_count
FROM lineitem_partitioned_list
WHERE l_shipdate > '1980-01-01';
partition_list_count
