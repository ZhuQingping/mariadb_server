DROP TABLE lineitem_partitioned_range;
#
# Partitioned Q1 grouped merge combines the same group across worker ranges and partitions.
#
CREATE TABLE lineitem_q1_partitioned_hash (
l_orderkey INT NOT NULL,
l_linenumber INT NOT NULL,
l_shipdate DATE NOT NULL,
l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
l_quantity DECIMAL(15,2) NOT NULL,
l_extendedprice DECIMAL(15,2) NOT NULL,
l_discount DECIMAL(15,2) NOT NULL,
l_tax DECIMAL(15,2) NOT NULL,
PRIMARY KEY (l_orderkey, l_linenumber)
) ENGINE=InnoDB
PARTITION BY HASH(l_orderkey) PARTITIONS 4;
INSERT INTO lineitem_q1_partitioned_hash VALUES
(1, 1, '1998-09-01', 'A', 'F', 10.00, 100.00, 0.05, 0.01),
(102, 1, '1998-09-01', 'A', 'F', 20.00, 200.00, 0.06, 0.02),
(203, 1, '1998-09-01', 'A', 'F', 30.00, 300.00, 0.07, 0.03),
(304, 1, '1998-09-01', 'A', 'F', 40.00, 400.00, 0.08, 0.04),
(2, 1, '1998-09-02', 'N', 'O', 50.00, 500.00, 0.05, 0.01),
(103, 1, '1998-09-02', 'N', 'O', 60.00, 600.00, 0.06, 0.02),
(204, 1, '1998-09-02', 'N', 'O', 70.00, 700.00, 0.07, 0.03),
(305, 1, '1998-09-02', 'N', 'O', 80.00, 800.00, 0.08, 0.04),
(406, 1, '1998-09-03', 'A', 'F', 90.00, 900.00, 0.09, 0.05);
FLUSH STATUS;
SELECT /*+ NO_PQ */ l_returnflag, l_linestatus,
COUNT(*) AS count_order,
SUM(l_quantity) AS sum_qty
FROM lineitem_q1_partitioned_hash
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	count_order	sum_qty
A	F	4	100.00
N	O	4	260.00
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
COUNT(*) AS count_order,
SUM(l_quantity) AS sum_qty
FROM lineitem_q1_partitioned_hash
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
l_returnflag	l_linestatus	count_order	sum_qty
A	F	4	100.00
N	O	4	260.00
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ NO_PQ */ SUM(l_extendedprice * l_discount) AS partition_hash_q6_serial_revenue
FROM lineitem_q1_partitioned_hash
WHERE l_shipdate >= DATE '1998-09-01'
  AND l_shipdate < DATE '1998-09-03'
  AND l_discount BETWEEN 0.05 AND 0.07
AND l_quantity < 75;
partition_hash_q6_serial_revenue
148.0000
