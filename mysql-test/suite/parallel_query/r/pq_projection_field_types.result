#
# Parallel Query projection field type coverage.
#
CREATE TABLE lineitem (
l_orderkey INT NOT NULL PRIMARY KEY,
l_shipdate DATE NOT NULL,
l_quantity INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem VALUES
(1, '1979-12-31', 10),
(2, '1980-01-01', 20),
(3, '1980-01-02', 30),
(4, '1981-05-10', 40),
(5, '1992-07-15', 50),
(6, '1978-03-20', 60),
(7, '1980-06-01', 70),
(8, '1985-09-09', 80);
SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_optimizer_switch= @@optimizer_switch;
SET @save_optimizer_trace= @@optimizer_trace;
SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
SET optimizer_trace=1;
#
# Nullable raw field projection keeps NULL state on the PQ path.
#
CREATE TABLE lineitem_nullable (
l_orderkey INT NOT NULL PRIMARY KEY,
l_shipdate DATE NOT NULL,
l_comment VARCHAR(32) NULL
) ENGINE=InnoDB;
INSERT INTO lineitem_nullable VALUES
(1, '1979-12-31', 'old'),
(3, '1980-01-02', 'ok'),
(4, '1981-05-10', NULL);
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_comment
FROM lineitem_nullable
WHERE l_shipdate > '1980-01-01';
l_orderkey	l_comment
3	ok
4	NULL
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS string_eq_count
FROM lineitem_nullable
WHERE l_comment = 'ok';
string_eq_count
1
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_comment
FROM lineitem_nullable
WHERE l_comment = 'ok';
l_orderkey	l_comment
3	ok
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS string_like_count
FROM lineitem_nullable
WHERE l_comment LIKE 'o%';
string_like_count
2
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS string_ne_count
FROM lineitem_nullable
WHERE l_comment != 'ok';
string_ne_count
1
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS string_in_count
FROM lineitem_nullable
WHERE l_comment IN ('ok', 'old', NULL);
string_in_count
2
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_comment
FROM lineitem_nullable
WHERE l_comment LIKE '%k';
l_orderkey	l_comment
3	ok
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS string_not_like_count
FROM lineitem_nullable
WHERE l_comment NOT LIKE '%k';
string_not_like_count
1
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_comment
FROM lineitem_nullable
WHERE l_comment NOT LIKE '%k';
l_orderkey	l_comment
1	old
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS comment_is_null_count
FROM lineitem_nullable
WHERE l_comment IS NULL;
comment_is_null_count
1
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_comment
FROM lineitem_nullable
WHERE l_comment IS NULL;
l_orderkey	l_comment
4	NULL
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS comment_is_not_null_count
FROM lineitem_nullable
WHERE l_comment IS NOT NULL;
comment_is_not_null_count
2
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_comment
FROM lineitem_nullable
WHERE l_comment IS NOT NULL;
l_orderkey	l_comment
1	old
3	ok
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS and_is_null_count
FROM lineitem_nullable
WHERE l_shipdate > '1980-01-01' AND l_comment IS NULL;
and_is_null_count
1
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_comment
FROM lineitem_nullable
WHERE l_shipdate > '1980-01-01' AND l_comment IS NOT NULL;
l_orderkey	l_comment
3	ok
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS string_gt_count
FROM lineitem_nullable
WHERE l_comment > 'm';
string_gt_count
