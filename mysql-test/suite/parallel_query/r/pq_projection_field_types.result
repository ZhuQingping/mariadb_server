Parallel_query_count	0
CREATE TABLE lineitem_fulltext_projection (
l_orderkey INT NOT NULL PRIMARY KEY,
doc TEXT NOT NULL,
FULLTEXT KEY ft_doc (doc)
) ENGINE=InnoDB;
INSERT INTO lineitem_fulltext_projection VALUES
(1, 'alpha bravo'),
(2, 'charlie delta'),
(3, 'alpha echo');
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey,
MATCH(doc) AGAINST('+alpha' IN BOOLEAN MODE) > 0 AS ft_match
FROM lineitem_fulltext_projection
ORDER BY l_orderkey;
l_orderkey	ft_match
1	1
2	0
3	1
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS fulltext_predicate_count
FROM lineitem_fulltext_projection
WHERE MATCH(doc) AGAINST('+alpha' IN BOOLEAN MODE) > 0;
fulltext_predicate_count
2
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
CREATE TABLE lineitem_json_projection (
l_orderkey INT NOT NULL PRIMARY KEY,
j JSON NULL
) ENGINE=InnoDB;
INSERT INTO lineitem_json_projection VALUES
(1, '{"a":1}'),
(2, NULL),
(3, '{"a":3,"b":"x"}');
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, j
FROM lineitem_json_projection
ORDER BY l_orderkey;
l_orderkey	j
1	{"a":1}
2	NULL
3	{"a":3,"b":"x"}
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, JSON_EXTRACT(j, '$.a') AS a_value
FROM lineitem_json_projection
ORDER BY l_orderkey;
l_orderkey	a_value
1	1
2	NULL
3	3
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, JSON_VALID(j) AS j_valid
FROM lineitem_json_projection
ORDER BY l_orderkey;
l_orderkey	j_valid
1	1
2	NULL
3	1
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_projection"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey,
JSON_TYPE(j) AS j_type,
JSON_UNQUOTE(JSON_EXTRACT(j, '$.b')) AS b_unquoted,
JSON_DEPTH(j) AS j_depth,
JSON_QUOTE(CAST(l_orderkey AS CHAR)) AS orderkey_json
FROM lineitem_json_projection
ORDER BY l_orderkey;
l_orderkey	j_type	b_unquoted	j_depth	orderkey_json
1	OBJECT	NULL	2	"1"
2	NULL	NULL	NULL	"2"
3	OBJECT	x	2	"3"
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_projection"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS json_contains_path_count
FROM lineitem_json_projection
WHERE JSON_CONTAINS_PATH(j, 'one', '$.a') = 1;
json_contains_path_count
2
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_predicate_or_expression"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS json_length_predicate_count
FROM lineitem_json_projection
WHERE JSON_LENGTH(j) > 0;
json_length_predicate_count
2
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_predicate_or_expression"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
SET optimizer_trace=1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey,
JSON_VALUE(JSON_OBJECT('a', l_orderkey), '$.a') AS json_value_a,
JSON_QUERY(JSON_OBJECT('a', l_orderkey), '$') IS NOT NULL AS json_query_guard
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
l_orderkey	json_value_a	json_query_guard
1	1	1
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_projection"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS json_path_predicate_count
FROM lineitem
WHERE JSON_EXISTS(JSON_OBJECT('a', l_orderkey), '$.a') = 1
AND JSON_OVERLAPS(JSON_OBJECT('a', l_orderkey),
JSON_OBJECT('a', l_orderkey)) = 1
AND JSON_SEARCH(JSON_ARRAY(l_orderkey), 'one',
CAST(l_orderkey AS CHAR)) IS NOT NULL;
json_path_predicate_count
8
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_predicate_or_expression"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
#
# Generated columns stay on the serial path for raw-field PQ surfaces.
#
CREATE TABLE lineitem_generated_projection (
l_orderkey INT NOT NULL PRIMARY KEY,
price INT NOT NULL,
quantity INT NOT NULL,
v_nullable INT AS (IF(price = 10, NULL, price * quantity)) VIRTUAL,
v_total INT AS (price * quantity) VIRTUAL,
p_total INT AS (price + quantity) PERSISTENT
) ENGINE=InnoDB;
INSERT INTO lineitem_generated_projection (l_orderkey, price, quantity) VALUES
(1, 10, 2),
(2, 20, 3),
(3, 30, 4);
SET optimizer_trace=1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, v_total
FROM lineitem_generated_projection
ORDER BY l_orderkey;
l_orderkey	v_total
1	20
2	60
3	120
