ORDER BY l_comment, l_orderkey;
l_orderkey	l_comment
4	NULL
3	ok
1	old
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
pq_trace
[
    {
        "select_id": 1,
        "chosen": false,
        "reason": "unsupported_projection_order"
    }
]
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
CREATE TABLE lineitem_binary_order (
l_orderkey INT NOT NULL PRIMARY KEY,
sort_key VARBINARY(4) NULL,
payload INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem_binary_order VALUES
(1, X'62', 10),
(2, X'41', 20),
(3, NULL, 30),
(4, X'6161', 40),
(5, X'61', 50);
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, HEX(sort_key) AS sort_hex, payload
FROM lineitem_binary_order
ORDER BY sort_key, l_orderkey;
l_orderkey	sort_hex	payload
3	NULL	30
2	41	20
5	61	50
4	6161	40
1	62	10
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, HEX(sort_key) AS sort_hex
FROM lineitem_binary_order
ORDER BY sort_key DESC, l_orderkey
LIMIT 3;
l_orderkey	sort_hex
1	62
4	6161
5	61
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	1
CREATE TABLE lineitem_blob_projection (
l_orderkey INT NOT NULL PRIMARY KEY,
payload BLOB NULL
) ENGINE=InnoDB;
INSERT INTO lineitem_blob_projection VALUES
(1, X'616263'),
(2, NULL),
(3, X'7A7A');
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, payload
FROM lineitem_blob_projection
ORDER BY l_orderkey;
l_orderkey	payload
1	abc
2	NULL
3	zz
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, HEX(payload) AS payload_hex
FROM lineitem_blob_projection
ORDER BY l_orderkey;
l_orderkey	payload_hex
1	616263
2	NULL
3	7A7A
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS blob_predicate_count
FROM lineitem_blob_projection
WHERE payload = X'7A7A';
blob_predicate_count
1
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ payload, COUNT(*) AS blob_group_count
FROM lineitem_blob_projection
GROUP BY payload
ORDER BY payload;
payload	blob_group_count
NULL	1
abc	1
zz	1
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
CREATE TABLE lineitem_geometry_projection (
l_orderkey INT NOT NULL PRIMARY KEY,
g GEOMETRY NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem_geometry_projection VALUES
(1, ST_GeomFromText('POINT(0 0)')),
(2, ST_GeomFromText('POINT(1 1)')),
(3, ST_GeomFromText('POINT(2 2)'));
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, ST_AsText(g) AS g_wkt
FROM lineitem_geometry_projection
ORDER BY l_orderkey;
l_orderkey	g_wkt
1	POINT(0 0)
2	POINT(1 1)
3	POINT(2 2)
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS geometry_predicate_count
FROM lineitem_geometry_projection
WHERE ST_Equals(g, ST_GeomFromText('POINT(1 1)'));
geometry_predicate_count
1
SHOW SESSION STATUS LIKE 'Parallel_query_count';
Variable_name	Value
Parallel_query_count	0
CREATE TABLE lineitem_text_projection (
l_orderkey INT NOT NULL PRIMARY KEY,
txt TEXT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem_text_projection VALUES
(1, 'alpha'),
(2, NULL),
(3, 'xyz');
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, txt
FROM lineitem_text_projection
ORDER BY l_orderkey;
l_orderkey	txt
1	alpha
2	NULL
3	xyz
