--source include/have_innodb.inc

--echo #
--echo # Parallel Query SELECT INTO and trigger boundary coverage.
--echo #

CREATE TABLE lineitem (
  l_orderkey INT NOT NULL PRIMARY KEY,
  l_shipdate DATE NOT NULL,
  l_quantity INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO lineitem VALUES
  (1, '1979-12-31', 10),
  (2, '1980-01-01', 20),
  (3, '1980-01-02', 30),
  (4, '1981-05-10', 40),
  (5, '1992-07-15', 50),
  (6, '1978-03-20', 60),
  (7, '1980-06-01', 70),
  (8, '1985-09-09', 80);

CREATE TABLE lineitem_q6 (
  l_orderkey INT NOT NULL,
  l_linenumber INT NOT NULL,
  l_shipdate DATE NOT NULL,
  l_quantity DECIMAL(15,2) NOT NULL,
  l_extendedprice DECIMAL(15,2) NOT NULL,
  l_discount DECIMAL(15,2) NOT NULL,
  PRIMARY KEY (l_orderkey, l_linenumber),
  KEY idx_q6_shipdate (l_shipdate)
) ENGINE=InnoDB;

INSERT INTO lineitem_q6 VALUES
  (1, 1, '1993-12-31', 10.00, 100.00, 0.06),
  (2, 1, '1994-01-01', 12.00, 200.00, 0.05),
  (3, 1, '1994-06-15', 23.00, 300.00, 0.06),
  (3, 2, '1994-06-16', 18.00, 1000.00, 0.06),
  (4, 1, '1994-12-31', 24.00, 400.00, 0.07),
  (5, 1, '1995-01-01', 20.00, 500.00, 0.06),
  (6, 1, '1994-03-20', 20.00, 600.00, 0.04),
  (7, 1, '1994-08-08', 21.00, 700.00, 0.08),
  (8, 1, '1994-09-09', 22.00, 800.00, 0.07);

CREATE TABLE lineitem_q1_group (
  l_orderkey INT NOT NULL,
  l_linenumber INT NOT NULL,
  l_shipdate DATE NOT NULL,
  l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_quantity DECIMAL(15,2) NOT NULL,
  l_extendedprice DECIMAL(15,2) NOT NULL,
  l_discount DECIMAL(15,2) NOT NULL,
  l_tax DECIMAL(15,2) NOT NULL,
  l_comment BLOB NOT NULL,
  PRIMARY KEY (l_orderkey, l_linenumber)
) ENGINE=InnoDB;

INSERT INTO lineitem_q1_group VALUES
  (1, 1, '1998-09-01', 'A', 'F', 10.00, 100.00, 0.05, 0.10, 'aa'),
  (2, 1, '1998-09-02', 'A', 'F', 20.00, 200.00, 0.10, 0.08, 'bbb'),
  (3, 1, '1998-09-03', 'A', 'F', 30.00, 300.00, 0.02, 0.04, 'cccc'),
  (4, 1, '1998-08-30', 'N', 'O', 40.00, 400.00, 0.07, 0.05, 'dd'),
  (5, 1, '1998-08-31', 'N', 'O', 50.00, 500.00, 0.06, 0.03, 'eee'),
  (6, 1, '1998-07-01', 'R', 'F', 60.00, 600.00, 0.08, 0.02, 'ffff');

SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_pq_support_features_switch= @@pq_support_features_switch;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_optimizer_switch= @@optimizer_switch;

SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=on';

SET optimizer_trace=1;

SET @save_select_into_force_parallel_execute= @@force_parallel_execute;
SET force_parallel_execute= 1;

SET @pq_select_into_count= NULL;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) INTO @pq_select_into_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SELECT @pq_select_into_count AS pq_select_into_count;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET @pq_select_into_sum= NULL;
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_extendedprice * l_discount) INTO @pq_select_into_sum
FROM lineitem_q6
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
  AND l_quantity < 24;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SELECT @pq_select_into_sum AS pq_select_into_sum;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET @pq_select_into_returnflag= NULL;
SET @pq_select_into_count= NULL;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, COUNT(*) AS count_order
INTO @pq_select_into_returnflag, @pq_select_into_count
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag
ORDER BY l_returnflag
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SELECT @pq_select_into_returnflag AS pq_select_into_returnflag,
       @pq_select_into_count AS pq_select_into_count;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET @pq_select_into_quantity= NULL;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_quantity INTO @pq_select_into_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SELECT @pq_select_into_quantity AS pq_select_into_quantity;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET force_parallel_execute= @save_select_into_force_parallel_execute;

CREATE TABLE pq_trigger_guard_sink (
  id INT NOT NULL PRIMARY KEY
) ENGINE=InnoDB;

delimiter |;
CREATE TRIGGER pq_trigger_guard_sink_bi BEFORE INSERT ON pq_trigger_guard_sink
FOR EACH ROW
BEGIN
  SELECT /*+ PQ(4) */ COUNT(*) INTO @pq_trigger_guard_count
  FROM lineitem
  WHERE l_shipdate > '1980-01-01';
END|
delimiter ;|
SET @pq_trigger_guard_count= NULL;
FLUSH STATUS;
INSERT INTO pq_trigger_guard_sink VALUES (1);
SELECT @pq_trigger_guard_count AS pq_trigger_guard_count;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
DROP TABLE pq_trigger_guard_sink;

SET optimizer_trace= @save_optimizer_trace;
SET optimizer_switch= @save_optimizer_switch;
SET pq_support_features_switch= @save_pq_support_features_switch;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL pq_master_enable= @save_pq_master_enable;

DROP TABLE lineitem_q1_group;
DROP TABLE lineitem_q6;
DROP TABLE lineitem;
