CREATE TABLE lineitem_time_pk (
  l_shiptime TIME NOT NULL PRIMARY KEY,
  l_orderkey INT NOT NULL,
  l_quantity DECIMAL(15,2) NOT NULL,
  l_extendedprice DECIMAL(15,2) NOT NULL,
  l_discount DECIMAL(15,2) NOT NULL,
  l_tax DECIMAL(15,2) NOT NULL,
  l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem_time_pk VALUES
  ('-838:59:59', 1, 10.00, 100.00, 0.05, 0.01, 'N', 'O'),
  ('-00:00:01', 2, 20.00, 200.00, 0.06, 0.02, 'N', 'O'),
  ('00:00:00', 3, 30.00, 300.00, 0.07, 0.03, 'R', 'F'),
  ('00:00:01', 4, 40.00, 400.00, 0.08, 0.04, 'R', 'F'),
  ('838:59:59', 5, 50.00, 500.00, 0.09, 0.05, 'A', 'F');
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS time_pk_count
FROM lineitem_time_pk;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_quantity) AS time_pk_sum
FROM lineitem_time_pk;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS time_pk_predicate_count
FROM lineitem_time_pk
WHERE l_shiptime > TIME '00:00:00';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_shiptime, l_orderkey, l_quantity
FROM lineitem_time_pk
ORDER BY l_shiptime
LIMIT 5;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ NO_PQ */ SUM(l_extendedprice * l_discount) AS time_pk_q6_serial_revenue
FROM lineitem_time_pk
WHERE l_shiptime >= TIME '-00:00:01'
  AND l_shiptime < TIME '00:00:01'
  AND l_discount BETWEEN 0.05 AND 0.07
  AND l_quantity < 35;
SELECT /*+ PQ(4) */ SUM(l_extendedprice * l_discount) AS time_pk_q6_revenue
FROM lineitem_time_pk
WHERE l_shiptime >= TIME '-00:00:01'
  AND l_shiptime < TIME '00:00:01'
  AND l_discount BETWEEN 0.05 AND 0.07
  AND l_quantity < 35;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
