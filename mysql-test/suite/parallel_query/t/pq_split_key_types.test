--source include/assert.inc
DROP TABLE lineitem_time_pk;

CREATE TABLE lineitem_time6_pk (
  l_shiptime TIME(6) NOT NULL PRIMARY KEY,
  l_orderkey INT NOT NULL,
  l_quantity INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem_time6_pk VALUES
  ('-00:00:00.000001', 1, 10),
  ('00:00:00.000000', 2, 20),
  ('00:00:00.000001', 3, 30),
  ('12:30:00.123456', 4, 40);
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS time6_pk_count
FROM lineitem_time6_pk;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_quantity) AS time6_pk_sum
FROM lineitem_time6_pk;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS time6_pk_between_count
FROM lineitem_time6_pk
WHERE l_shiptime BETWEEN TIME '-00:00:00.000001' AND TIME '00:00:00.000001';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_shiptime, l_orderkey, l_quantity
FROM lineitem_time6_pk
ORDER BY l_shiptime
LIMIT 4;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_quantity, COUNT(*) AS time6_pk_group_count
FROM lineitem_time6_pk
WHERE l_shiptime BETWEEN TIME '-00:00:00.000001' AND TIME '00:00:00.000001'
GROUP BY l_quantity
ORDER BY l_quantity;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
DROP TABLE lineitem_time6_pk;

SET optimizer_trace= @save_optimizer_trace;
SET optimizer_switch= @save_optimizer_switch;
SET pq_support_features_switch= @save_pq_support_features_switch;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL pq_master_enable= @save_pq_master_enable;
