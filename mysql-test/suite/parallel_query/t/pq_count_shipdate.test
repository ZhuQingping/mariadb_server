--replace_regex /"rows": [0-9]+/"rows": #/ /"cost": [0-9.]+/"cost": #/
EXPLAIN FORMAT=JSON SELECT /*+ PQ(4) */ q1.l_returnflag, q1.l_linestatus,
       SUM(q1.l_quantity) AS sum_qty,
       SUM(q1.l_extendedprice) AS sum_base_price,
       SUM(q1.l_extendedprice * (1 - q1.l_discount)) AS sum_disc_price,
       SUM(q1.l_extendedprice * (1 - q1.l_discount) * (1 + q1.l_tax)) AS sum_charge,
       AVG(q1.l_quantity) AS avg_qty,
       AVG(q1.l_extendedprice) AS avg_price,
       AVG(q1.l_discount) AS avg_disc,
       COUNT(*) AS count_order
FROM lineitem_q1_group AS q1
WHERE q1.l_shipdate <= DATE '1998-09-02'
GROUP BY q1.l_returnflag, q1.l_linestatus
ORDER BY q1.l_returnflag, q1.l_linestatus;

--replace_regex /"r_total_time_ms": [0-9.]+/"r_total_time_ms": #/ /"r_table_time_ms": [0-9.]+/"r_table_time_ms": #/ /"r_other_time_ms": [0-9.]+/"r_other_time_ms": #/ /"cost": [0-9.]+/"cost": #/ /"pages_accessed": [0-9]+/"pages_accessed": #/
ANALYZE FORMAT=JSON SELECT /*+ PQ(4) */ q1.l_returnflag, q1.l_linestatus,
       SUM(q1.l_quantity) AS sum_qty,
       SUM(q1.l_extendedprice) AS sum_base_price,
       SUM(q1.l_extendedprice * (1 - q1.l_discount)) AS sum_disc_price,
       SUM(q1.l_extendedprice * (1 - q1.l_discount) * (1 + q1.l_tax)) AS sum_charge,
       AVG(q1.l_quantity) AS avg_qty,
       AVG(q1.l_extendedprice) AS avg_price,
       AVG(q1.l_discount) AS avg_disc,
       COUNT(*) AS count_order
FROM lineitem_q1_group AS q1
WHERE q1.l_shipdate <= DATE '1998-09-02'
GROUP BY q1.l_returnflag, q1.l_linestatus
ORDER BY q1.l_returnflag, q1.l_linestatus;

SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
       COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_quantity > (SELECT AVG(l_quantity) FROM lineitem_q1_group)
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
       COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_quantity BETWEEN (SELECT MIN(l_quantity) FROM lineitem_q1_group)
                     AND (SELECT AVG(l_quantity) FROM lineitem_q1_group)
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ q.l_returnflag, q.l_linestatus,
       SUM(q.l_quantity * f.flag_weight) AS weighted_qty
FROM lineitem_q1_group q
JOIN lineitem_q1_flag f ON f.l_returnflag = q.l_returnflag
WHERE q.l_shipdate <= DATE '1998-09-02'
GROUP BY q.l_returnflag, q.l_linestatus
ORDER BY q.l_returnflag, q.l_linestatus;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
       SUM(LENGTH(l_comment)) AS comment_bytes
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
SHOW SESSION STATUS LIKE 'Parallel_query_count';





