SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS quantity_not_between_count
FROM lineitem
WHERE l_quantity NOT BETWEEN 20 AND 70;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS const_lt_quantity_count
FROM lineitem
WHERE 30 < l_quantity;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE 40 != l_quantity
ORDER BY l_orderkey
LIMIT 3;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_quantity IN (10, 50, 70)
ORDER BY l_orderkey;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_quantity NOT BETWEEN 20 AND 70
ORDER BY l_orderkey;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS and_predicate_count
FROM lineitem
WHERE l_shipdate > '1980-01-01' AND l_quantity >= 40;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01' AND l_quantity <= 50;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS or_quantity_count
FROM lineitem
WHERE l_quantity < 30 OR l_quantity > 60;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS or_shipdate_count
FROM lineitem
WHERE l_shipdate = '1980-01-02' OR l_shipdate = '1985-09-09';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_quantity < 30 OR l_quantity > 60
ORDER BY l_orderkey;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS or_and_predicate_count
FROM lineitem
WHERE (l_shipdate > '1980-01-01' AND l_quantity <= 40)
      OR l_quantity > 60;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey
LIMIT 3;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey DESC
LIMIT 2;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey
LIMIT 1, 2;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ l_orderkey, l_shipdate, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01';

--replace_regex /"rows": [0-9]+/"rows": #/ /"cost": [0-9.]+/"cost": #/
EXPLAIN FORMAT=JSON SELECT /*+ PQ(4) */ l_orderkey, l_shipdate, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01';

--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey
LIMIT 1, 2;

--replace_regex /"rows": [0-9]+/"rows": #/ /"cost": [0-9.]+/"cost": #/
EXPLAIN FORMAT=JSON SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey
LIMIT 1, 2;

--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_quantity + 1 DESC, l_orderkey
LIMIT 3;

--replace_regex /"rows": [0-9]+/"rows": #/ /"cost": [0-9.]+/"cost": #/
EXPLAIN FORMAT=JSON SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_quantity + 1 DESC, l_orderkey
LIMIT 3;

SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_quantity > (SELECT AVG(l_quantity) FROM lineitem)
ORDER BY l_orderkey;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE (SELECT AVG(l_quantity) FROM lineitem) < l_quantity
ORDER BY l_orderkey;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=off';

--echo #
--echo # AVG(base signed integer field) uses worker partial sums/counts and leader aggregation.
--echo #

FLUSH STATUS;
SELECT /*+ PQ(4) */ AVG(l_quantity) AS avg_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ AVG(l_quantity + 1) AS avg_quantity_expr
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--replace_regex /"rows": [0-9]+/"rows": #/ /"cost": [0-9.]+/"cost": #/
EXPLAIN FORMAT=JSON SELECT /*+ PQ(4) */ AVG(l_quantity + 1) AS avg_quantity_expr
FROM lineitem
WHERE l_shipdate > '1980-01-01';

--echo #
--echo # SUM(base signed integer field) uses worker partial sums and leader aggregation.
--echo #

FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_quantity) AS sum_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_quantity + 1) AS sum_quantity_expr
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo #
--echo # MIN/MAX(expr) uses leader expression evaluation over worker payload rows.
--echo #

FLUSH STATUS;
SELECT /*+ PQ(4) */ MIN(l_quantity + 1) AS min_quantity_expr
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ MAX(l_quantity + l_orderkey) AS max_quantity_expr
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ MIN(NULLIF(l_quantity, 40)) AS min_expr_null_skip
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--replace_regex /"r_total_time_ms": [0-9.]+/"r_total_time_ms": #/ /"r_table_time_ms": [0-9.]+/"r_table_time_ms": #/ /"r_other_time_ms": [0-9.]+/"r_other_time_ms": #/ /"cost": [0-9.]+/"cost": #/ /"pages_accessed": [0-9]+/"pages_accessed": #/
ANALYZE FORMAT=JSON SELECT /*+ PQ(4) */ MIN(NULLIF(l_quantity, 40)) AS min_expr_null_skip
FROM lineitem
WHERE l_shipdate > '1980-01-01';

FLUSH STATUS;
SELECT /*+ PQ(4) */ MIN(l_quantity + 1) AS min_quantity_expr_having_alias
FROM lineitem
WHERE l_shipdate > '1980-01-01'
HAVING min_quantity_expr_having_alias > 0;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ MAX(l_quantity + l_orderkey) AS max_quantity_expr_having_repeat
FROM lineitem
WHERE l_shipdate > '1980-01-01'
HAVING MAX(l_quantity + l_orderkey) = 88;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo #
--echo # TPC-H Q1 aggregate list groups by raw fields and merges partials.
--echo #

CREATE TABLE lineitem_q1_group (
  l_orderkey INT NOT NULL,
  l_linenumber INT NOT NULL,
  l_shipdate DATE NOT NULL,
  l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_quantity DECIMAL(15,2) NOT NULL,
  l_extendedprice DECIMAL(15,2) NOT NULL,
  l_discount DECIMAL(15,2) NOT NULL,
  l_tax DECIMAL(15,2) NOT NULL,
  l_comment BLOB NOT NULL,
  PRIMARY KEY (l_orderkey, l_linenumber)
) ENGINE=InnoDB;

INSERT INTO lineitem_q1_group VALUES
  (1, 1, '1998-09-01', 'A', 'F', 10.00, 100.00, 0.05, 0.10, 'aa'),
  (2, 1, '1998-09-02', 'A', 'F', 20.00, 200.00, 0.10, 0.08, 'bbb'),
  (3, 1, '1998-09-03', 'A', 'F', 30.00, 300.00, 0.02, 0.04, 'cccc'),
  (4, 1, '1998-08-30', 'N', 'O', 40.00, 400.00, 0.07, 0.05, 'dd'),
  (5, 1, '1998-08-31', 'N', 'O', 50.00, 500.00, 0.06, 0.03, 'eee'),
  (6, 1, '1998-07-15', 'R', 'F', 60.00, 600.00, 0.08, 0.07, 'ffff');

CREATE TABLE lineitem_q1_shipdate_range (
  l_orderkey INT NOT NULL,
  l_linenumber INT NOT NULL,
  l_shipdate DATE NOT NULL,
  l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_quantity DECIMAL(15,2) NOT NULL,
  l_extendedprice DECIMAL(15,2) NOT NULL,
  l_discount DECIMAL(15,2) NOT NULL,
  l_tax DECIMAL(15,2) NOT NULL,
  PRIMARY KEY (l_orderkey, l_linenumber),
  KEY idx_q1_shipdate (l_shipdate)
) ENGINE=InnoDB;

INSERT INTO lineitem_q1_shipdate_range VALUES
  (1, 1, '1998-09-01', 'A', 'F', 10.00, 100.00, 0.05, 0.10),
  (2, 1, '1998-09-02', 'A', 'F', 20.00, 200.00, 0.10, 0.08),
  (3, 1, '1998-09-03', 'A', 'F', 30.00, 300.00, 0.02, 0.04),
  (4, 1, '1998-08-30', 'N', 'O', 40.00, 400.00, 0.07, 0.05),
  (5, 1, '1998-08-31', 'N', 'O', 50.00, 500.00, 0.06, 0.03),
  (6, 1, '1998-07-15', 'R', 'F', 60.00, 600.00, 0.08, 0.07);

--echo # Q1 can use PQ when fewer primary-key ranges are generated than requested DOP.
CREATE TABLE lineitem_q1_small_range (
  l_orderkey INT NOT NULL,
  l_linenumber INT NOT NULL,
  l_shipdate DATE NOT NULL,
  l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_quantity DECIMAL(15,2) NOT NULL,
  PRIMARY KEY (l_orderkey, l_linenumber)
) ENGINE=InnoDB;

INSERT INTO lineitem_q1_small_range VALUES
  (10, 1, '1998-09-01', 'A', 'F', 10.00),
  (11, 1, '1998-09-02', 'N', 'O', 20.00),
  (12, 1, '1998-09-03', 'R', 'F', 30.00);

FLUSH STATUS;
SELECT /*+ NO_PQ */ l_returnflag, l_linestatus,
       COUNT(*) AS count_order,
       SUM(l_quantity) AS sum_qty
FROM lineitem_q1_small_range
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
       COUNT(*) AS count_order,
       SUM(l_quantity) AS sum_qty
FROM lineitem_q1_small_range
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
SHOW SESSION STATUS LIKE 'Parallel_query_count';


SET GLOBAL parallel_max_threads= 3;
FLUSH STATUS;
SELECT /*+ PQ(64) */ l_returnflag, l_linestatus,
       COUNT(*) AS count_order,
       SUM(l_quantity) AS sum_qty
FROM lineitem_q1_small_range
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
SET GLOBAL parallel_max_threads= 64;

SET parallel_default_dop= 128;
FLUSH STATUS;
SELECT /*+ PQ() */ COUNT(*) AS default_dop_above_phase1_cap_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';
SET parallel_default_dop= 4;

CREATE TABLE lineitem_q1_flag (
  l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL PRIMARY KEY,
  flag_weight INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO lineitem_q1_flag VALUES ('A', 1), ('N', 2), ('R', 3);

--echo #
--echo # Q1 composite PK first-keypart ranges keep duplicate first-keypart rows.
--echo #

CREATE TABLE lineitem_q1_composite_pk (
  l_orderkey INT NOT NULL,
  l_linenumber INT NOT NULL,
  l_shipdate DATE NOT NULL,
  l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_quantity DECIMAL(15,2) NOT NULL,
  PRIMARY KEY (l_orderkey, l_linenumber)
) ENGINE=InnoDB;

INSERT INTO lineitem_q1_composite_pk VALUES
  (1, 1, '1998-09-01', 'A', 'F', 10.00),
  (2, 1, '1998-09-02', 'A', 'F', 20.00),
  (2, 2, '1998-09-02', 'A', 'F', 5.00),
  (3, 1, '1998-08-30', 'N', 'O', 40.00);

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
       COUNT(*) AS count_order,
       SUM(l_quantity) AS sum_qty
FROM lineitem_q1_composite_pk
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo #
--echo # Q1 leader merge combines the same group from multiple worker ranges.
--echo #

CREATE TABLE lineitem_q1_split_group (
  l_orderkey INT NOT NULL,
  l_linenumber INT NOT NULL,
  l_shipdate DATE NOT NULL,
  l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_quantity DECIMAL(15,2) NOT NULL,
  l_extendedprice DECIMAL(15,2) NOT NULL,
  l_discount DECIMAL(15,2) NOT NULL,
  l_tax DECIMAL(15,2) NOT NULL,
  PRIMARY KEY (l_orderkey, l_linenumber)
) ENGINE=InnoDB;

INSERT INTO lineitem_q1_split_group VALUES
  (1, 1, '1998-09-01', 'A', 'F', 10.00, 100.00, 0.05, 0.10),
  (2, 1, '1998-09-02', 'N', 'O', 20.00, 200.00, 0.10, 0.08),
  (75, 1, '1998-09-01', 'A', 'F', 30.00, 300.00, 0.02, 0.04),
  (76, 1, '1998-09-02', 'N', 'O', 40.00, 400.00, 0.07, 0.05),
  (150, 1, '1998-09-01', 'A', 'F', 50.00, 500.00, 0.06, 0.03),
  (151, 1, '1998-09-02', 'N', 'O', 60.00, 600.00, 0.08, 0.07);

FLUSH STATUS;
SELECT /*+ NO_PQ */ l_returnflag, l_linestatus,
       COUNT(*) AS count_order,
       SUM(l_quantity) AS sum_qty
FROM lineitem_q1_split_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
       COUNT(*) AS count_order,
       SUM(l_quantity) AS sum_qty
FROM lineitem_q1_split_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ NO_PQ */ l_returnflag, l_linestatus,
       SUM(l_quantity) AS sum_qty,
       SUM(l_extendedprice) AS sum_base_price,
       SUM(l_extendedprice * (1 - l_discount)) AS sum_disc_price,
       SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax)) AS sum_charge,
       AVG(l_quantity) AS avg_qty,
       AVG(l_extendedprice) AS avg_price,
       AVG(l_discount) AS avg_disc,
       COUNT(*) AS count_order
FROM lineitem_q1_split_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
       SUM(l_quantity) AS sum_qty,
       SUM(l_extendedprice) AS sum_base_price,
       SUM(l_extendedprice * (1 - l_discount)) AS sum_disc_price,
       SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax)) AS sum_charge,
       AVG(l_quantity) AS avg_qty,
       AVG(l_extendedprice) AS avg_price,
       AVG(l_discount) AS avg_disc,
       COUNT(*) AS count_order
FROM lineitem_q1_split_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ NO_PQ */ l_returnflag, l_linestatus,
       SUM(l_quantity) AS sum_qty,
       SUM(l_extendedprice) AS sum_base_price,
       SUM(l_extendedprice * (1 - l_discount)) AS sum_disc_price,
