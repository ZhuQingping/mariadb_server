--source include/have_innodb.inc
--source include/have_partition.inc
--source include/have_debug_sync.inc

--echo #
--echo # Phase 1 Parallel Query: COUNT(*) with a simple date predicate.
--echo #

CREATE TABLE lineitem (
  l_orderkey INT NOT NULL PRIMARY KEY,
  l_shipdate DATE NOT NULL,
  l_quantity INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO lineitem VALUES
  (1, '1979-12-31', 10),
  (2, '1980-01-01', 20),
  (3, '1980-01-02', 30),
  (4, '1981-05-10', 40),
  (5, '1992-07-15', 50),
  (6, '1978-03-20', 60),
  (7, '1980-06-01', 70),
  (8, '1985-09-09', 80);

SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_parallel_queue_timeout= @@parallel_queue_timeout;
SET @save_pq_msg_queue_size= @@pq_msg_queue_size;
SET @save_pq_msg_queue_spin_lock= @@pq_msg_queue_spin_lock;
SET @save_pq_hash_join_max_hash_table_refills= @@pq_hash_join_max_hash_table_refills;
SET @save_parallel_batch_max_slot= @@parallel_batch_max_slot;
SET @save_parallel_batch_max_mem_size= @@parallel_batch_max_mem_size;
SET @save_parallel_cost_threshold= @@parallel_cost_threshold;
SET @save_parallel_rows_threshold= @@parallel_rows_threshold;
SET @save_op_over_pq_offset_threshold= @@op_over_pq_offset_threshold;
SET @save_parallel_setup_cost= @@parallel_setup_cost;
SET @save_parallel_tuple_cost= @@parallel_tuple_cost;
SET @save_parallel_fail_retry= @@parallel_fail_retry;
SET @save_parallel_graceful_fallback= @@parallel_graceful_fallback;
SET @save_parallel_limit_no_order_by= @@parallel_limit_no_order_by;
SET @save_pq_support_features_switch= @@pq_support_features_switch;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_transaction_isolation= @@transaction_isolation;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_optimizer_switch= @@optimizer_switch;
SET @save_join_cache_level= @@join_cache_level;
SET @save_time_zone= @@time_zone;
SET @save_debug_dbug= @@debug_dbug;

SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SELECT @@global.parallel_max_threads;
SELECT @@global.parallel_memory_limit;
SELECT @@parallel_queue_timeout;
SELECT @@pq_msg_queue_size;
SELECT @@pq_msg_queue_spin_lock;
SELECT @@pq_hash_join_max_hash_table_refills;
SELECT @@parallel_batch_max_slot;
SELECT @@parallel_batch_max_mem_size;
SELECT @@parallel_cost_threshold;
SELECT @@parallel_rows_threshold;
SELECT @@op_over_pq_offset_threshold;
SELECT @@parallel_setup_cost;
SELECT @@parallel_tuple_cost;
SELECT @@parallel_fail_retry;
SELECT @@parallel_graceful_fallback;
SELECT @@parallel_limit_no_order_by;
SELECT @@pq_support_features_switch;
SELECT @@global.pq_master_enable;
SELECT @@optimizer_switch LIKE '%parallel_query=on%' AS optimizer_switch_parallel_query_on;
--error ER_GLOBAL_VARIABLE
SET SESSION parallel_max_threads= 2;
--error ER_GLOBAL_VARIABLE
SET SESSION parallel_memory_limit= 104857600;
--error ER_GLOBAL_VARIABLE
SET SESSION pq_master_enable= OFF;

SET GLOBAL pq_master_enable= OFF;
SELECT @@global.pq_master_enable;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS pq_master_disabled_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';
SET GLOBAL pq_master_enable= ON;
SELECT @@global.pq_master_enable;

SET optimizer_switch= 'parallel_query=off';
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS optimizer_switch_disabled_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';
SET optimizer_switch= 'parallel_query=on';

SET force_parallel_execute= 1;
SET optimizer_switch= 'parallel_query=off';
FLUSH STATUS;
SELECT COUNT(*) AS optimizer_switch_blocks_force_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';
SET optimizer_switch= 'parallel_query=on';
SET force_parallel_execute= 1;

SET parallel_default_dop= 65;
SHOW WARNINGS;
SET parallel_default_dop= 128;
SHOW WARNINGS;
SET parallel_default_dop= 1025;
SHOW WARNINGS;
SELECT @@parallel_default_dop;
SET parallel_default_dop= 4;
SET parallel_cost_threshold= 1234;
SELECT @@parallel_cost_threshold;
SET parallel_rows_threshold= 4321;
SELECT @@parallel_rows_threshold;
SET op_over_pq_offset_threshold= 2048;
SELECT @@op_over_pq_offset_threshold;
SET parallel_setup_cost= 12.5;
SELECT @@parallel_setup_cost;
SET parallel_tuple_cost= 0.75;
SELECT @@parallel_tuple_cost;
SET parallel_fail_retry= OFF;
SELECT @@parallel_fail_retry;
SET parallel_fail_retry= ON;
SELECT @@parallel_fail_retry;
SET parallel_graceful_fallback= OFF;
SELECT @@parallel_graceful_fallback;
SET parallel_graceful_fallback= ON;
SET parallel_limit_no_order_by= OFF;
SELECT @@parallel_limit_no_order_by;
SET parallel_limit_no_order_by= ON;
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=on';
SELECT @@pq_support_features_switch;
SET pq_msg_queue_size= 1048578;
SELECT @@pq_msg_queue_size;
SET pq_msg_queue_spin_lock= 101;
SELECT @@pq_msg_queue_spin_lock;
SET pq_msg_queue_size= 1048575;
SHOW WARNINGS;
SELECT @@pq_msg_queue_size;
SET pq_msg_queue_spin_lock= 99;
SHOW WARNINGS;
SELECT @@pq_msg_queue_spin_lock;
SET pq_hash_join_max_hash_table_refills= 2;
SELECT @@pq_hash_join_max_hash_table_refills;
SET pq_hash_join_max_hash_table_refills= 0;
SHOW WARNINGS;
SELECT @@pq_hash_join_max_hash_table_refills;
SET parallel_batch_max_slot= 16;
SELECT @@parallel_batch_max_slot;
SET parallel_batch_max_mem_size= 2097152;
SELECT @@parallel_batch_max_mem_size;
SET parallel_batch_max_slot= 1025;
SHOW WARNINGS;
SELECT @@parallel_batch_max_slot;
SET parallel_batch_max_mem_size= 0;
SELECT @@parallel_batch_max_mem_size;
SET parallel_batch_max_mem_size= 2097152;

SET force_parallel_execute= 0;
FLUSH STATUS;
SELECT COUNT(*) AS serial_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET force_parallel_execute= 1;
SET parallel_default_dop= 4;
FLUSH STATUS;
SELECT COUNT(*) AS parallel_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET @save_auto_rbo_force_parallel_execute= @@force_parallel_execute;
SET @save_auto_rbo_parallel_cost_threshold= @@parallel_cost_threshold;
SET @save_auto_rbo_parallel_rows_threshold= @@parallel_rows_threshold;
SET @save_auto_rbo_parallel_setup_cost= @@parallel_setup_cost;
SET @save_auto_rbo_parallel_tuple_cost= @@parallel_tuple_cost;
SET force_parallel_execute= 0;
SET parallel_cost_threshold= 0;
SET parallel_rows_threshold= 0;
SET parallel_setup_cost= 0;
SET parallel_tuple_cost= 0;
FLUSH STATUS;
SELECT COUNT(*) AS auto_rbo_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey
LIMIT 2;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET parallel_rows_threshold= 18446744073709551615;
FLUSH STATUS;
SELECT COUNT(*) AS auto_rbo_rows_threshold_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';
SET parallel_rows_threshold= 0;

SET optimizer_switch= 'parallel_query=off';
FLUSH STATUS;
SELECT COUNT(*) AS auto_rbo_optimizer_switch_disabled_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';
SET optimizer_switch= 'parallel_query=on';

FLUSH STATUS;
SELECT /*+ NO_PQ */ COUNT(*) AS auto_rbo_no_pq_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';
SET parallel_cost_threshold= @save_auto_rbo_parallel_cost_threshold;
SET parallel_rows_threshold= @save_auto_rbo_parallel_rows_threshold;
SET parallel_setup_cost= @save_auto_rbo_parallel_setup_cost;
SET parallel_tuple_cost= @save_auto_rbo_parallel_tuple_cost;
SET force_parallel_execute= @save_auto_rbo_force_parallel_execute;

SET pq_support_features_switch= 'simple_aggregate=off';
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS simple_aggregate_switch_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';
SET pq_support_features_switch= 'simple_aggregate=on';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS no_where_count
FROM lineitem;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT (SELECT /*+ PQ(4) */ COUNT(*)
        FROM lineitem
        WHERE l_shipdate > '1980-01-01') AS scalar_subquery_count;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey,
       (SELECT 5) AS scalar_subquery_projection_const
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey
LIMIT 2;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET @pq_projection_user_var := 'leader_const';
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey,
       @pq_projection_user_var AS user_var_projection_const
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey
LIMIT 2;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey,
       (SELECT /*+ PQ(4) */ COUNT(*)
        FROM lineitem
        WHERE l_shipdate > '1980-01-01') AS scalar_subquery_projection_pq_count
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey
LIMIT 2;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT l_orderkey, l_quantity
FROM (SELECT /*+ PQ(4) */ l_orderkey, l_quantity
      FROM lineitem
      WHERE l_shipdate > '1980-01-01'
      ORDER BY l_orderkey
      LIMIT 2) AS d
ORDER BY l_orderkey;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

CREATE TABLE lineitem_small_span (
  l_orderkey INT NOT NULL PRIMARY KEY,
  l_shipdate DATE NOT NULL,
  l_quantity INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO lineitem_small_span VALUES
  (10, '1980-01-02', 30),
  (11, '1981-05-10', 40),
  (12, '1979-12-31', 50);

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS small_span_count
FROM lineitem_small_span
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem_small_span
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

CREATE TABLE lineitem_negative_pk (
  l_orderkey INT NOT NULL PRIMARY KEY,
  l_shipdate DATE NOT NULL,
  l_quantity INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO lineitem_negative_pk VALUES
  (-8, '1980-01-02', 10),
  (-3, '1981-05-10', 20),
  (-1, '1979-12-31', 30),
  (0, '1985-09-09', 40),
  (2, '1988-01-01', 50),
  (7, '1978-01-01', 60);

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS negative_pk_count
FROM lineitem_negative_pk
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_quantity) AS negative_pk_sum
FROM lineitem_negative_pk
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem_negative_pk
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey DESC
LIMIT 3;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_quantity) AS negative_pk_range_sum
FROM lineitem_negative_pk
WHERE l_orderkey >= -3 AND l_orderkey < 7;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

CREATE TABLE lineitem_unsigned_pk (
  l_orderkey BIGINT UNSIGNED NOT NULL PRIMARY KEY,
  l_shipdate DATE NOT NULL,
  l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_quantity INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO lineitem_unsigned_pk VALUES
  (9223372036854775808, '1980-01-02', 'A', 'F', 10),
  (9223372036854775810, '1981-05-10', 'A', 'F', 20),
  (18446744073709551609, '1979-12-31', 'B', 'O', 30),
  (18446744073709551610, '1985-09-09', 'B', 'O', 40);

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS unsigned_pk_count
FROM lineitem_unsigned_pk
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_quantity) AS unsigned_pk_sum
FROM lineitem_unsigned_pk
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_quantity) AS unsigned_pk_range_sum
FROM lineitem_unsigned_pk
WHERE l_orderkey >= 9223372036854775810
  AND l_orderkey < 18446744073709551610;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
       COUNT(*) AS count_order,
       SUM(l_quantity) AS sum_qty
FROM lineitem_unsigned_pk
WHERE l_shipdate > '1980-01-01'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem_unsigned_pk
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey
LIMIT 2;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem_unsigned_pk
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey DESC
LIMIT 2;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ NO_PQ */ COUNT(*) AS no_pq_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) NO_PQ */ COUNT(*) AS no_pq_overrides_pq_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ NO_PQ PQ(4) */ COUNT(*) AS no_pq_before_pq_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ NO_PQ NO_PQ */ COUNT(*) AS no_pq_repeat_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo #
--echo # TaurusDB only accepts bare NO_PQ input; parameterized forms are ignored.
--echo #

--disable_warnings
FLUSH STATUS;
SELECT /*+ NO_PQ(lineitem) */ COUNT(*) AS no_pq_table_form_ignored_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ QB_NAME(no_pq_qb) NO_PQ(@no_pq_qb) */
  COUNT(*) AS no_pq_qb_form_ignored_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';
--enable_warnings

SET force_parallel_execute= 0;
SET parallel_default_dop= 0;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS pq_hint_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(lineitem, 4) */ COUNT(*) AS pq_table_hint_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(lineitem 4) */ COUNT(*) AS pq_table_hint_space_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(li 4) */ COUNT(*) AS pq_table_alias_hint_count
FROM lineitem AS li
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(lineitem 4) */ COUNT(*) AS pq_table_base_hint_with_alias_count
FROM lineitem AS li
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ QB_NAME(pq_main) PQ(@pq_main 4) */ COUNT(*) AS pq_qb_hint_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ QB_NAME(pq_main_table) PQ(@pq_main_table lineitem 4) */
  COUNT(*) AS pq_qb_table_hint_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(0) */ COUNT(*) AS pq_zero_dop_ignored_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW WARNINGS;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(lineitem, 4294967296) */ COUNT(*) AS pq_large_dop_ignored_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW WARNINGS;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(65) */ COUNT(*) AS pq_hint_just_above_phase1_cap_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(128) */ COUNT(*) AS pq_hint_above_phase1_cap_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET parallel_default_dop= 4;
FLUSH STATUS;
SELECT /*+ PQ() */ COUNT(*) AS pq_empty_hint_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(lineitem) */ COUNT(*) AS pq_table_default_dop_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ QB_NAME(pq_main_default) PQ(@pq_main_default) */
  COUNT(*) AS pq_qb_default_dop_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';
SET parallel_default_dop= 0;

--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ COUNT(*) AS pq_explain_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';

--replace_column 9 # 10 # 11 # 12 #
ANALYZE SELECT /*+ PQ(4) */ COUNT(*) AS pq_analyze_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';

--replace_regex /"rows": [0-9]+/"rows": #/ /"cost": [0-9.]+/"cost": #/
EXPLAIN FORMAT=JSON SELECT /*+ PQ(4) */ COUNT(*) AS pq_explain_json_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';

--replace_regex /"r_total_time_ms": [0-9.]+/"r_total_time_ms": #/ /"r_table_time_ms": [0-9.]+/"r_table_time_ms": #/ /"r_other_time_ms": [0-9.]+/"r_other_time_ms": #/ /"cost": [0-9.]+/"cost": #/ /"pages_accessed": [0-9]+/"pages_accessed": #/
ANALYZE FORMAT=JSON SELECT /*+ PQ(4) */ COUNT(*) AS pq_analyze_json_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_shipdate, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET parallel_limit_no_order_by= OFF;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_shipdate, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
LIMIT 1;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
SET parallel_limit_no_order_by= ON;

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
ORDER BY l_orderkey
LIMIT 3;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey
LIMIT 2;
SELECT FOUND_ROWS() AS found_rows_after_calc;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_quantity DESC, l_orderkey
LIMIT 3;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_quantity DESC, l_orderkey
LIMIT 3;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_quantity + 1 DESC, l_orderkey
LIMIT 3;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY ABS(l_quantity) DESC, l_orderkey
LIMIT 3;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_quantity DESC, l_orderkey DESC
LIMIT 1, 3;
SELECT FOUND_ROWS() AS found_rows_after_multi_order_calc;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

CREATE TABLE lineitem_expr_order_precision (
  l_orderkey INT NOT NULL PRIMARY KEY,
  l_shipdate DATE NOT NULL,
  l_big BIGINT NOT NULL,
  l_dec DECIMAL(30,0) NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem_expr_order_precision VALUES
  (1, '1980-01-02', 9007199254740993, 900719925474099312345678902),
  (2, '1980-01-03', 9007199254740992, 900719925474099312345678901),
  (3, '1980-01-04', 9007199254740995, 900719925474099312345678904),
  (4, '1980-01-05', 9007199254740994, 900719925474099312345678903);

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_big
FROM lineitem_expr_order_precision
WHERE l_shipdate > '1980-01-01'
ORDER BY l_big + 0
LIMIT 2;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_dec
FROM lineitem_expr_order_precision
WHERE l_shipdate > '1980-01-01'
ORDER BY l_dec + 0
LIMIT 2;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

DROP TABLE lineitem_expr_order_precision;

CREATE TABLE lineitem_projection_string (
  l_orderkey INT NOT NULL PRIMARY KEY,
  l_shipdate DATE NOT NULL,
  l_comment CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem_projection_string VALUES
  (1, '1980-01-02', 'A'),
  (2, '1980-01-03', 'C'),
  (3, '1980-01-04', 'B'),
  (4, '1980-01-05', 'C'),
  (5, '1980-01-06', 'A');
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_comment
FROM lineitem_projection_string
WHERE l_shipdate > '1980-01-01'
ORDER BY l_comment DESC, l_orderkey
LIMIT 4;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ l_orderkey, l_comment
FROM lineitem_projection_string
WHERE l_shipdate > '1980-01-01'
ORDER BY l_comment DESC, l_orderkey
LIMIT 4;

--replace_regex /"rows": [0-9]+/"rows": #/ /"cost": [0-9.]+/"cost": #/
EXPLAIN FORMAT=JSON SELECT /*+ PQ(4) */ l_orderkey, l_comment
FROM lineitem_projection_string
WHERE l_shipdate > '1980-01-01'
ORDER BY l_comment DESC, l_orderkey
LIMIT 4;
DROP TABLE lineitem_projection_string;

CREATE TABLE lineitem_projection_order_types (
  l_orderkey INT NOT NULL PRIMARY KEY,
  l_shipdate DATE NOT NULL,
  l_shiptime TIME(6) NOT NULL,
  l_shipdt DATETIME(6) NOT NULL,
  l_amount DECIMAL(10,2) NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem_projection_order_types VALUES
  (1, '1980-01-02', '-00:00:01.000001', '1980-01-02 00:00:00.000001', 10.10),
  (2, '1980-01-03', '00:00:00.000000', '1980-01-01 12:00:00.123456', -5.50),
  (3, '1979-12-31', '12:30:00.123456', '1980-01-03 00:00:00.000000', 20.20),
  (4, '1980-01-02', '23:59:59.999999', '1979-12-31 23:59:59.999999', 0.00),
  (5, '1981-05-10', '00:00:01.000000', '1981-05-10 00:00:01.000000', 10.10);
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_shipdate, l_shipdt, l_amount
FROM lineitem_projection_order_types
ORDER BY l_shipdate DESC, l_shipdt, l_orderkey
LIMIT 4;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_shiptime, l_amount
FROM lineitem_projection_order_types
ORDER BY l_shiptime, l_amount DESC, l_orderkey
LIMIT 1, 3;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS temporal_predicate_count
FROM lineitem_projection_order_types
WHERE l_shipdt >= TIMESTAMP '1980-01-02 00:00:00'
  AND l_shiptime BETWEEN TIME '00:00:00' AND TIME '23:59:59.999999';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_shipdt, l_shiptime
FROM lineitem_projection_order_types
WHERE l_shipdt >= TIMESTAMP '1980-01-02 00:00:00'
  AND l_shiptime BETWEEN TIME '00:00:00' AND TIME '23:59:59.999999'
ORDER BY l_orderkey
LIMIT 3;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
DROP TABLE lineitem_projection_order_types;

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
ORDER BY l_orderkey
LIMIT 2 OFFSET 1;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
ORDER BY l_quantity
FETCH FIRST 2 ROWS WITH TIES;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey + l_quantity AS order_quantity_sum
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS quantity_gt_count
FROM lineitem
WHERE l_quantity > 30;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_quantity > 30
LIMIT 2;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS quantity_ge_count
FROM lineitem
WHERE l_quantity >= 40;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS quantity_eq_count
FROM lineitem
WHERE l_quantity = 40;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS quantity_ne_count
FROM lineitem
WHERE l_quantity != 40;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS shipdate_lt_count
FROM lineitem
WHERE l_shipdate < '1980-01-02';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS shipdate_le_count
FROM lineitem
WHERE l_shipdate <= '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS shipdate_ne_count
FROM lineitem
WHERE l_shipdate <> '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS quantity_in_count
FROM lineitem
WHERE l_quantity IN (20, 40, 80);
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS quantity_in_scalar_subquery_count
FROM lineitem
WHERE l_quantity IN ((SELECT 20), (SELECT 40), (SELECT 80));
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS quantity_not_in_count
FROM lineitem
WHERE l_quantity NOT IN (20, 40, 80);
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS shipdate_in_count
FROM lineitem
