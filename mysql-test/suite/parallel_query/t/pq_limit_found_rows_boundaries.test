--source include/have_innodb.inc

--echo #
--echo # Parallel Query LIMIT, OFFSET, and FOUND_ROWS boundary coverage.
--echo #

CREATE TABLE lineitem (
  l_orderkey INT NOT NULL PRIMARY KEY,
  l_shipdate DATE NOT NULL,
  l_quantity INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO lineitem VALUES
  (1, '1979-12-31', 10),
  (2, '1980-01-01', 20),
  (3, '1980-01-02', 30),
  (4, '1981-05-10', 40),
  (5, '1992-07-15', 50),
  (6, '1978-03-20', 60),
  (7, '1980-06-01', 70),
  (8, '1985-09-09', 80);

CREATE TABLE lineitem_q1_group (
  l_orderkey INT NOT NULL,
  l_linenumber INT NOT NULL,
  l_shipdate DATE NOT NULL,
  l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_quantity DECIMAL(15,2) NOT NULL,
  l_extendedprice DECIMAL(15,2) NOT NULL,
  l_discount DECIMAL(15,2) NOT NULL,
  l_tax DECIMAL(15,2) NOT NULL,
  l_comment BLOB NOT NULL,
  PRIMARY KEY (l_orderkey, l_linenumber)
) ENGINE=InnoDB;

INSERT INTO lineitem_q1_group VALUES
  (1, 1, '1998-09-01', 'A', 'F', 10.00, 100.00, 0.05, 0.10, 'aa'),
  (2, 1, '1998-09-02', 'A', 'F', 20.00, 200.00, 0.10, 0.08, 'bbb'),
  (3, 1, '1998-09-03', 'A', 'F', 30.00, 300.00, 0.02, 0.04, 'cccc'),
  (4, 1, '1998-08-30', 'N', 'O', 40.00, 400.00, 0.07, 0.05, 'dd'),
  (5, 1, '1998-08-31', 'N', 'O', 50.00, 500.00, 0.06, 0.03, 'eee'),
  (6, 1, '1998-07-15', 'R', 'F', 60.00, 600.00, 0.08, 0.07, 'ffff');

SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_op_over_pq_offset_threshold= @@op_over_pq_offset_threshold;
SET @save_parallel_limit_no_order_by= @@parallel_limit_no_order_by;
SET @save_pq_support_features_switch= @@pq_support_features_switch;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_optimizer_switch= @@optimizer_switch;

SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
SET op_over_pq_offset_threshold= 2048;
SET parallel_limit_no_order_by= ON;
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=on,correlated_subquery=on,hash_join_spill_to_disk=on,insert_select=on';
SET optimizer_trace= 1;

SET parallel_limit_no_order_by= OFF;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus, COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS scalar_limit_count
FROM lineitem
WHERE l_shipdate > '1980-01-01'
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_quantity) AS scalar_limit_sum
FROM lineitem
WHERE l_shipdate > '1980-01-01'
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
SET parallel_limit_no_order_by= ON;

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
LIMIT 1 OFFSET 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey
LIMIT 1, 2;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET op_over_pq_offset_threshold= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey
LIMIT 1, 2;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
SET op_over_pq_offset_threshold= 2048;

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_quantity
FETCH FIRST 2 ROWS WITH TIES;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

CREATE TABLE pq_projection_ties (
  l_orderkey INT NOT NULL PRIMARY KEY,
  l_shipdate DATE NOT NULL,
  l_quantity INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO pq_projection_ties VALUES
  (1, '1980-01-02', 10),
  (2, '1980-01-03', 20),
  (3, '1980-01-04', 20),
  (4, '1980-01-05', 30),
  (5, '1980-01-06', 40);

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM pq_projection_ties
ORDER BY l_quantity
FETCH FIRST 2 ROWS WITH TIES;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
DROP TABLE pq_projection_ties;

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus, COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus
FETCH FIRST 1 ROWS WITH TIES;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

CREATE TABLE pq_group_ties (
  l_orderkey INT NOT NULL PRIMARY KEY,
  g1 CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  g2 CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_quantity INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO pq_group_ties VALUES
  (1, 'A', 'F', 10),
  (2, 'A', 'F', 20),
  (3, 'A', 'O', 30),
  (4, 'B', 'F', 40),
  (5, 'B', 'O', 50);

FLUSH STATUS;
SELECT /*+ PQ(4) */ g1, g2, COUNT(*) AS tie_count
FROM pq_group_ties
GROUP BY g1, g2
ORDER BY g1
FETCH FIRST 1 ROWS WITH TIES;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS g1, g2, COUNT(*) AS tie_count
FROM pq_group_ties
GROUP BY g1, g2
ORDER BY g1
FETCH FIRST 1 ROWS WITH TIES;
SELECT FOUND_ROWS() AS found_rows_after_grouped_ties;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
--error ER_WITH_TIES_NEEDS_ORDER
SELECT /*+ PQ(4) */ g1, g2, COUNT(*) AS tie_count
FROM pq_group_ties
GROUP BY g1, g2
FETCH FIRST 1 ROWS WITH TIES;

DROP TABLE pq_group_ties;

FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey
LIMIT 2;
SELECT FOUND_ROWS() AS found_rows_after_trace_calc;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS COUNT(*) AS found_rows_aggregate_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SELECT FOUND_ROWS() AS found_rows_after_aggregate_calc;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS SUM(l_quantity) AS found_rows_aggregate_sum
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SELECT FOUND_ROWS() AS found_rows_after_aggregate_sum_calc;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS COUNT(*) AS found_rows_aggregate_limit_zero
FROM lineitem
WHERE l_shipdate > '1980-01-01'
LIMIT 0;
SELECT FOUND_ROWS() AS found_rows_after_aggregate_limit_zero;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS COUNT(*) AS found_rows_aggregate_limit_offset
FROM lineitem
WHERE l_shipdate > '1980-01-01'
LIMIT 2, 3;
SELECT FOUND_ROWS() AS found_rows_after_aggregate_limit_offset;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS COUNT(*) AS found_rows_aggregate_having_false
FROM lineitem
WHERE l_shipdate > '1980-01-01'
HAVING COUNT(*) < 0;
SELECT FOUND_ROWS() AS found_rows_after_aggregate_having_false;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS l_quantity, COUNT(*) AS found_rows_grouped_count
FROM lineitem
WHERE l_shipdate > '1980-01-01'
GROUP BY l_quantity
ORDER BY l_quantity
LIMIT 1;
SELECT FOUND_ROWS() AS found_rows_after_grouped_calc;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS l_quantity, COUNT(*) AS found_rows_grouped_desc
FROM lineitem
WHERE l_shipdate > '1980-01-01'
GROUP BY l_quantity
ORDER BY l_quantity DESC
LIMIT 2;
SELECT FOUND_ROWS() AS found_rows_after_grouped_desc;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS l_quantity, COUNT(*) AS found_rows_grouped_desc_offset
FROM lineitem
WHERE l_shipdate > '1980-01-01'
GROUP BY l_quantity
ORDER BY l_quantity DESC
LIMIT 1, 2;
SELECT FOUND_ROWS() AS found_rows_after_grouped_desc_offset;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS l_quantity, COUNT(*) AS found_rows_grouped_limit_offset
FROM lineitem
WHERE l_shipdate > '1980-01-01'
GROUP BY l_quantity
ORDER BY l_quantity
LIMIT 1, 2;
SELECT FOUND_ROWS() AS found_rows_after_grouped_limit_offset;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET op_over_pq_offset_threshold= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS l_quantity, COUNT(*) AS found_rows_grouped_large_offset
FROM lineitem
WHERE l_shipdate > '1980-01-01'
GROUP BY l_quantity
ORDER BY l_quantity
LIMIT 1, 2;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
SET op_over_pq_offset_threshold= 2048;

FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS l_quantity, COUNT(*) AS found_rows_grouped_limit_zero
FROM lineitem
WHERE l_shipdate > '1980-01-01'
GROUP BY l_quantity
ORDER BY l_quantity
LIMIT 0;
SELECT FOUND_ROWS() AS found_rows_after_grouped_limit_zero;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS l_quantity, COUNT(*) AS found_rows_grouped_having_alias_count
FROM lineitem
WHERE l_shipdate > '1980-01-01'
GROUP BY l_quantity
HAVING found_rows_grouped_having_alias_count > 1
ORDER BY l_quantity
LIMIT 1;
SELECT FOUND_ROWS() AS found_rows_after_grouped_having_false;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ NO_PQ */ l_returnflag, l_linestatus,
       SUM(l_quantity) AS sum_qty,
       SUM(l_extendedprice) AS sum_base_price,
       SUM(l_extendedprice * (1 - l_discount)) AS sum_disc_price,
       SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax)) AS sum_charge,
       AVG(l_quantity) AS avg_qty,
       AVG(l_extendedprice) AS avg_price,
       AVG(l_discount) AS avg_disc,
       COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag DESC, l_linestatus ASC
LIMIT 1, 2;

FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS l_returnflag, l_linestatus,
       SUM(l_quantity) AS sum_qty,
       SUM(l_extendedprice) AS sum_base_price,
       SUM(l_extendedprice * (1 - l_discount)) AS sum_disc_price,
       SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax)) AS sum_charge,
       AVG(l_quantity) AS avg_qty,
       AVG(l_extendedprice) AS avg_price,
       AVG(l_discount) AS avg_disc,
       COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag DESC, l_linestatus ASC
LIMIT 1, 2;
SELECT FOUND_ROWS() AS found_rows_after_full_q1_mixed_order_offset;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET op_over_pq_offset_threshold= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS l_returnflag, l_linestatus,
       SUM(l_quantity) AS sum_qty,
       SUM(l_extendedprice) AS sum_base_price,
       SUM(l_extendedprice * (1 - l_discount)) AS sum_disc_price,
       SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax)) AS sum_charge,
       AVG(l_quantity) AS avg_qty,
       AVG(l_extendedprice) AS avg_price,
       AVG(l_discount) AS avg_disc,
       COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag DESC, l_linestatus ASC
LIMIT 1, 2;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
SET op_over_pq_offset_threshold= 2048;

FLUSH STATUS;
SELECT /*+ NO_PQ */ l_returnflag, l_linestatus,
       SUM(l_quantity) AS sum_qty,
       SUM(l_extendedprice) AS sum_base_price,
       SUM(l_extendedprice * (1 - l_discount)) AS sum_disc_price,
       SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax)) AS sum_charge,
       AVG(l_quantity) AS avg_qty,
       AVG(l_extendedprice) AS avg_price,
       AVG(l_discount) AS avg_disc,
       COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
HAVING count_order >= 2
ORDER BY l_returnflag, l_linestatus
LIMIT 1;

FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS l_returnflag, l_linestatus,
       SUM(l_quantity) AS sum_qty,
       SUM(l_extendedprice) AS sum_base_price,
       SUM(l_extendedprice * (1 - l_discount)) AS sum_disc_price,
       SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax)) AS sum_charge,
       AVG(l_quantity) AS avg_qty,
       AVG(l_extendedprice) AS avg_price,
       AVG(l_discount) AS avg_disc,
       COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
HAVING count_order >= 2
ORDER BY l_returnflag, l_linestatus
LIMIT 1;
SELECT FOUND_ROWS() AS found_rows_after_full_q1_grouped_calc;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET optimizer_trace= @save_optimizer_trace;
SET optimizer_switch= @save_optimizer_switch;
SET pq_support_features_switch= @save_pq_support_features_switch;
SET parallel_limit_no_order_by= @save_parallel_limit_no_order_by;
SET op_over_pq_offset_threshold= @save_op_over_pq_offset_threshold;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL pq_master_enable= @save_pq_master_enable;

DROP TABLE lineitem_q1_group;
DROP TABLE lineitem;
