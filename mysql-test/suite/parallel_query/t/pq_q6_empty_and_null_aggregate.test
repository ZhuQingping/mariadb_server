--source include/have_innodb.inc

--echo #
--echo # Parallel Query Q6 empty and NULL aggregate coverage.
--echo #

SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_optimizer_switch= @@optimizer_switch;

SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;

CREATE TABLE lineitem_q6_empty_null (
  l_orderkey INT NOT NULL,
  l_linenumber INT NOT NULL,
  l_shipdate DATE NOT NULL,
  l_quantity DECIMAL(15,2) NOT NULL,
  l_extendedprice DECIMAL(15,2) NULL,
  l_discount DECIMAL(15,2) NULL,
  PRIMARY KEY (l_orderkey, l_linenumber)
) ENGINE=InnoDB;

INSERT INTO lineitem_q6_empty_null VALUES
  (1, 1, '1993-12-31', 10.00, 100.00, 0.06),
  (2, 1, '1994-01-01', 10.00, NULL, 0.05),
  (3, 1, '1994-02-01', 10.00, 300.00, NULL),
  (4, 1, '1994-03-01', 10.00, NULL, NULL),
  (5, 1, '1994-04-01', 25.00, 500.00, 0.06),
  (6, 1, '1995-01-01', 10.00, 600.00, 0.06),
  (7, 1, '1994-05-01', 10.00, 100.00, 0.06);

--echo # Empty Q6 SUM(expr) returns NULL and still executes through PQ.
FLUSH STATUS;
SELECT /*+ NO_PQ */ SUM(l_extendedprice * l_discount) AS q6_empty_serial_sum
FROM lineitem_q6_empty_null
WHERE l_shipdate >= DATE '2100-01-01'
  AND l_shipdate < DATE '2101-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
  AND l_quantity < 24;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_extendedprice * l_discount) AS q6_empty_pq_sum
FROM lineitem_q6_empty_null
WHERE l_shipdate >= DATE '2100-01-01'
  AND l_shipdate < DATE '2101-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
  AND l_quantity < 24;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo # All matching Q6 expressions can be NULL while COUNT(*) remains non-zero.
FLUSH STATUS;
SELECT /*+ NO_PQ */ SUM(l_extendedprice * l_discount) AS q6_all_null_serial_sum
FROM lineitem_q6_empty_null
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_orderkey BETWEEN 2 AND 4
  AND l_quantity < 24;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_extendedprice * l_discount) AS q6_all_null_pq_sum
FROM lineitem_q6_empty_null
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_orderkey BETWEEN 2 AND 4
  AND l_quantity < 24;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS q6_all_null_count_star
FROM lineitem_q6_empty_null
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_orderkey BETWEEN 2 AND 4
  AND l_quantity < 24;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(l_extendedprice * l_discount) AS q6_all_null_count_expr
FROM lineitem_q6_empty_null
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_orderkey BETWEEN 2 AND 4
  AND l_quantity < 24;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo # Q6 SUM(field * field) executes as scalar aggregate in workers.
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_extendedprice * l_discount) AS q6_product_pq_sum
FROM lineitem_q6_empty_null
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
  AND l_quantity < 24;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider.query_shape') AS q6_product_query_shape
FROM information_schema.optimizer_trace;

DROP TABLE lineitem_q6_empty_null;

SET optimizer_switch= @save_optimizer_switch;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL pq_master_enable= @save_pq_master_enable;
