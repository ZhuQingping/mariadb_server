--source include/have_innodb.inc
--source include/have_sequence.inc
--source include/have_innodb_16k.inc

--echo #
--echo # InnoDB PQ B-tree descriptor positive and hardening coverage on 16K pages.
--echo #

SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_optimizer_switch= @@optimizer_switch;

SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET optimizer_trace= 1;
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;

CREATE TABLE pq_btree_descriptor_deep_t (
  id INT NOT NULL,
  payload VARBINARY(768) NOT NULL,
  PRIMARY KEY (id)
) ENGINE=InnoDB STATS_PERSISTENT=1;

INSERT INTO pq_btree_descriptor_deep_t
SELECT CAST(seq AS SIGNED) * 10 - 163840, REPEAT(CHAR(65 + MOD(seq, 26)), 768)
FROM seq_1_to_32768;

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(64) */ COUNT(*) AS descriptor_count_result
FROM pq_btree_descriptor_deep_t
WHERE id > -163840;

SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].scan_provider') AS scan_provider
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_available') AS btree_descriptor_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_count') IS NOT NULL AS btree_descriptor_count_visible
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_boundary_available') AS btree_descriptor_boundary_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_scan_start_available') AS btree_descriptor_scan_start_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_scan_end_available') AS btree_descriptor_scan_end_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_split_used') AS btree_descriptor_split_used
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_execution_used') AS btree_descriptor_execution_used
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(64) */ COUNT(*) AS descriptor_range_count_result
FROM pq_btree_descriptor_deep_t
WHERE id > -81920 AND id < 81930;

SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_scan_start_available') AS range_scan_start_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_scan_end_available') AS range_scan_end_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_split_used') AS range_btree_descriptor_split_used
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_execution_used') AS range_btree_descriptor_execution_used
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(64) */ COUNT(*) AS descriptor_small_range_count_result
FROM pq_btree_descriptor_deep_t
WHERE id > -163840 AND id < -163800;

SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_scan_start_available') AS small_range_scan_start_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_scan_end_available') AS small_range_scan_end_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_split_used') AS small_range_btree_descriptor_split_used
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_execution_used') AS small_range_btree_descriptor_execution_used
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(64) */ COUNT(*) AS descriptor_empty_range_count_result
FROM pq_btree_descriptor_deep_t
WHERE id > -163829 AND id < -163821;

SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].scan_provider') AS empty_range_scan_provider
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_scan_start_available') AS empty_range_scan_start_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_scan_end_available') AS empty_range_scan_end_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_split_used') AS empty_range_btree_descriptor_split_used
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_execution_used') AS empty_range_btree_descriptor_execution_used
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET optimizer_trace= @save_optimizer_trace;
SET optimizer_switch= @save_optimizer_switch;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL pq_master_enable= @save_pq_master_enable;

DROP TABLE pq_btree_descriptor_deep_t;
