HAVING MAX(l_extendedprice) >= 500
ORDER BY MAX(l_extendedprice) DESC, l_returnflag, l_linestatus;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
