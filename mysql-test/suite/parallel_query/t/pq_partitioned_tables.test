CREATE TABLE lineitem_partitioned_list (
  l_orderkey INT NOT NULL PRIMARY KEY,
  l_shipdate DATE NOT NULL,
  l_quantity INT NOT NULL
) ENGINE=InnoDB
PARTITION BY LIST(l_orderkey) (
  PARTITION p0 VALUES IN (1, 2),
  PARTITION p1 VALUES IN (3, 4),
  PARTITION p2 VALUES IN (5, 6)
);
INSERT INTO lineitem_partitioned_list VALUES
  (1, '1979-12-31', 10),
  (2, '1980-01-02', 20),
  (3, '1980-01-02', 30),
  (4, '1981-05-10', 40),
  (5, '1981-05-10', 50),
  (6, '1985-09-09', 60);
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS partition_list_count
FROM lineitem_partitioned_list
WHERE l_shipdate > '1980-01-01';
SHOW SESSION STATUS LIKE 'Parallel_query_count';
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem_partitioned_list
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_shipdate, COUNT(*) AS partition_list_group_count
FROM lineitem_partitioned_list
WHERE l_shipdate > '1980-01-01'
GROUP BY l_shipdate
ORDER BY l_shipdate;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
FLUSH STATUS;
--replace_regex /"rows": [0-9]+/"rows": #/ /"cost": [0-9.]+/"cost": #/
EXPLAIN FORMAT=JSON SELECT /*+ PQ(4) */ COUNT(*) AS partition_list_explain_count
FROM lineitem_partitioned_list
WHERE l_shipdate > '1980-01-01';
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem_partitioned_list PARTITION(p1)
WHERE l_shipdate > '1980-01-01'
ORDER BY l_orderkey;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
DROP TABLE lineitem_partitioned_list;

CREATE TABLE lineitem_partitioned_myisam (
  l_orderkey INT NOT NULL PRIMARY KEY,
  l_shipdate DATE NOT NULL,
  l_quantity INT NOT NULL
) ENGINE=MyISAM
PARTITION BY HASH(l_orderkey) PARTITIONS 2;

INSERT INTO lineitem_partitioned_myisam VALUES
  (1, '1980-01-02', 10),
  (2, '1981-01-02', 20);

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS partition_myisam_trace_count
FROM lineitem_partitioned_myisam
WHERE l_shipdate > '1980-01-01';
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_shipdate, COUNT(*) AS partition_myisam_group_count
FROM lineitem_partitioned_myisam
WHERE l_shipdate > '1980-01-01'
GROUP BY l_shipdate
ORDER BY l_shipdate;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
DROP TABLE lineitem_partitioned_myisam;

SET optimizer_trace= @save_optimizer_trace;
SET optimizer_switch= @save_optimizer_switch;
SET op_over_pq_offset_threshold= @save_op_over_pq_offset_threshold;
SET pq_support_features_switch= @save_pq_support_features_switch;
SET parallel_limit_no_order_by= @save_parallel_limit_no_order_by;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL pq_master_enable= @save_pq_master_enable;
