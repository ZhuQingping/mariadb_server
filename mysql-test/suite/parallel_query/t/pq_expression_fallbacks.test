--source include/have_innodb.inc

--echo #
--echo # Parallel Query expression and function fallback coverage.
--echo #

CREATE TABLE lineitem (
  l_orderkey INT NOT NULL PRIMARY KEY,
  l_shipdate DATE NOT NULL,
  l_quantity INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO lineitem VALUES
  (1, '1979-12-31', 10),
  (2, '1980-01-01', 20),
  (3, '1980-01-02', 30),
  (4, '1981-05-10', 40),
  (5, '1992-07-15', 50),
  (6, '1978-03-20', 60),
  (7, '1980-06-01', 70),
  (8, '1985-09-09', 80);

CREATE TABLE lineitem_q1_group (
  l_orderkey INT NOT NULL,
  l_linenumber INT NOT NULL,
  l_shipdate DATE NOT NULL,
  l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_quantity DECIMAL(15,2) NOT NULL,
  l_extendedprice DECIMAL(15,2) NOT NULL,
  l_discount DECIMAL(15,2) NOT NULL,
  l_tax DECIMAL(15,2) NOT NULL,
  l_comment BLOB NOT NULL,
  PRIMARY KEY (l_orderkey, l_linenumber)
) ENGINE=InnoDB;

INSERT INTO lineitem_q1_group VALUES
  (1, 1, '1998-09-01', 'A', 'F', 10.00, 100.00, 0.05, 0.10, 'aa'),
  (2, 1, '1998-09-02', 'A', 'F', 20.00, 200.00, 0.10, 0.08, 'bbb'),
  (3, 1, '1998-09-03', 'A', 'F', 30.00, 300.00, 0.02, 0.04, 'cccc'),
  (4, 1, '1998-08-30', 'N', 'O', 40.00, 400.00, 0.07, 0.05, 'dd'),
  (5, 1, '1998-08-31', 'N', 'O', 50.00, 500.00, 0.06, 0.03, 'eee'),
  (6, 1, '1998-07-01', 'R', 'F', 60.00, 600.00, 0.08, 0.02, 'ffff');

SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_parallel_limit_no_order_by= @@parallel_limit_no_order_by;
SET @save_pq_support_features_switch= @@pq_support_features_switch;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_optimizer_switch= @@optimizer_switch;
SET @save_op_over_pq_offset_threshold= @@op_over_pq_offset_threshold;

SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
SET parallel_limit_no_order_by= ON;
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=on';
SET op_over_pq_offset_threshold= 2048;
SET optimizer_trace= 1;

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(NULL) AS null_const_trace_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, RAND() < 2 AS rand_guard
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(RAND()) AS rand_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, MD5(CAST(l_quantity AS CHAR)) AS quantity_md5
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS sha2_predicate_count
FROM lineitem
WHERE SHA2(CAST(l_quantity AS CHAR), 256) IS NOT NULL;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey,
       WEIGHT_STRING(CAST(l_quantity AS CHAR)) AS quantity_weight
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS weight_string_predicate_count
FROM lineitem
WHERE WEIGHT_STRING(CAST(l_quantity AS CHAR)) IS NOT NULL;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, UUID_SHORT() IS NOT NULL AS uuid_short_guard
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS uuid_short_predicate_count
FROM lineitem
WHERE CONCAT(UUID_SHORT(), l_orderkey) IS NOT NULL;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, UUID() IS NOT NULL AS uuid_guard
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS uuid_predicate_count
FROM lineitem
WHERE CONCAT(UUID(), l_orderkey) IS NOT NULL;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, FOUND_ROWS() IS NOT NULL AS found_rows_guard
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS found_rows_predicate_count
FROM lineitem
WHERE CONCAT(FOUND_ROWS(), l_orderkey) IS NOT NULL;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, USER() AS login_user,
       CURRENT_USER() AS current_user_name,
       SESSION_USER() AS session_user_name
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS user_predicate_count
FROM lineitem
WHERE CONCAT(USER(), l_orderkey) IS NOT NULL;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey,
       CONNECTION_ID() IS NOT NULL AS connection_id_guard,
       DATABASE() = 'test' AS database_guard
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS connection_id_predicate_count
FROM lineitem
WHERE CONCAT(CONNECTION_ID(), l_orderkey) IS NOT NULL;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, CURRENT_ROLE() AS current_role_name
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, GET_LOCK('pq_func_lock', 0) AS got_lock
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
--disable_result_log
SELECT RELEASE_LOCK('pq_func_lock');
--enable_result_log

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, IS_FREE_LOCK('pq_func_lock') AS free_lock
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, IS_USED_LOCK('pq_func_unused_lock') AS used_lock
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--disable_result_log
SELECT GET_LOCK('pq_func_lock', 0);
--enable_result_log
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, RELEASE_LOCK('pq_func_lock') AS released_lock
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, RELEASE_ALL_LOCKS() >= 0 AS released_all_locks
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS is_free_lock_predicate_count
FROM lineitem
WHERE IS_FREE_LOCK(CONCAT('pq_func_lock_', l_orderkey)) IS NOT NULL;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ DISTINCT l_quantity AS distinct_quantity
FROM lineitem
ORDER BY l_quantity;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, LAST_INSERT_ID() AS last_insert_id_value
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS last_insert_id_predicate_count
FROM lineitem
WHERE CONCAT(LAST_INSERT_ID(), l_orderkey) IS NOT NULL;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(LAST_INSERT_ID(l_quantity)) AS last_insert_id_sum
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
       SUM(LAST_INSERT_ID(l_quantity)) AS last_insert_id_group_sum
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, ROW_COUNT() AS row_count_value
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS row_count_predicate_count
FROM lineitem
WHERE CONCAT(ROW_COUNT(), l_orderkey) IS NOT NULL;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS rand_predicate_count
FROM lineitem
WHERE RAND() < -1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, RAND(1) IS NOT NULL AS rand_guard
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS rand_table_predicate_count
FROM lineitem
WHERE RAND(1) + l_orderkey > 0;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, NOW() IS NOT NULL AS now_guard
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(CURRENT_TIMESTAMP()) AS current_timestamp_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS utc_timestamp_predicate_count
FROM lineitem
WHERE CONCAT(UTC_TIMESTAMP(), l_orderkey) IS NOT NULL;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, SYSDATE() IS NOT NULL AS sysdate_guard
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(SYSDATE()) AS sysdate_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS sysdate_predicate_count
FROM lineitem
WHERE SYSDATE() < TIMESTAMP '1970-01-01 00:00:00';
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, SLEEP(0) AS sleep_projection
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(SLEEP(0)) AS sleep_sum
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS sleep_predicate_count
FROM lineitem
WHERE SLEEP(0) = 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey,
       LOAD_FILE('/tmp/mariadb-pq-load-file-missing') IS NULL AS load_file_guard
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS load_file_predicate_count
FROM lineitem
WHERE CONCAT(LOAD_FILE('/tmp/mariadb-pq-load-file-missing'), l_orderkey) IS NULL;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey,
       COALESCE(MASTER_POS_WAIT('pq-bin.999999', 1, 0), 0) IS NOT NULL AS master_pos_wait_guard,
       COALESCE(MASTER_GTID_WAIT('0-1-999999', 0), 0) IS NOT NULL AS master_gtid_wait_guard
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS replication_wait_predicate_count
FROM lineitem
WHERE COALESCE(MASTER_POS_WAIT(CONCAT('pq-bin.', l_orderkey), 1, 0),
               MASTER_GTID_WAIT(CONCAT('0-1-', l_orderkey), 0),
               l_orderkey) IS NOT NULL;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey,
       HEX(KDF('foo', 'bar', 1, 'pbkdf2_hmac', 128)) IS NOT NULL AS kdf_guard,
       PASSWORD('pq') IS NOT NULL AS password_guard,
       OLD_PASSWORD('pq') IS NOT NULL AS old_password_guard
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS crypto_auth_predicate_count
FROM lineitem
WHERE CONCAT(HEX(KDF('foo', CONCAT('bar', l_orderkey), 1, 'pbkdf2_hmac', 128)),
             PASSWORD(CONCAT('pq', l_orderkey)),
             l_orderkey) IS NOT NULL;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, RANDOM_BYTES(1) IS NOT NULL AS random_bytes_guard
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS random_bytes_predicate_count
FROM lineitem
WHERE CONCAT(HEX(RANDOM_BYTES(1)), l_orderkey) IS NOT NULL;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET @pq_set_user_var := 0;
FLUSH STATUS;
SELECT /*+ PQ(4) */ @pq_set_user_var := COUNT(*) AS set_user_var_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--disable_warnings
DROP SEQUENCE IF EXISTS pq_sequence_func;
--enable_warnings
CREATE SEQUENCE pq_sequence_func START WITH 1;
SELECT NEXTVAL(pq_sequence_func) AS pq_sequence_seed;
FLUSH STATUS;
SELECT /*+ PQ(4) */ NEXTVAL(pq_sequence_func) AS nextval_guard,
       LASTVAL(pq_sequence_func) AS lastval_guard,
       SETVAL(pq_sequence_func, 7) AS setval_guard
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
DROP SEQUENCE pq_sequence_func;

--disable_warnings
DROP SEQUENCE IF EXISTS pq_sequence_func;
--enable_warnings
CREATE SEQUENCE pq_sequence_func START WITH 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS nextval_predicate_count
FROM lineitem
WHERE NEXTVAL(pq_sequence_func) > 0;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
DROP SEQUENCE pq_sequence_func;

--disable_warnings
DROP SEQUENCE IF EXISTS pq_sequence_func;
--enable_warnings
CREATE SEQUENCE pq_sequence_func START WITH 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(NEXTVAL(pq_sequence_func)) AS nextval_sum
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
DROP SEQUENCE pq_sequence_func;

--disable_warnings
DROP SEQUENCE IF EXISTS pq_sequence_func;
--enable_warnings
CREATE SEQUENCE pq_sequence_func START WITH 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS nextval_having_count
FROM lineitem
WHERE l_shipdate > '1980-01-01'
HAVING NEXTVAL(pq_sequence_func) > 0;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
DROP SEQUENCE pq_sequence_func;

--disable_warnings
DROP FUNCTION IF EXISTS `nextval`;
CREATE FUNCTION `nextval`() RETURNS INT DETERMINISTIC RETURN 1;
--enable_warnings
FLUSH STATUS;
--disable_warnings
SELECT /*+ PQ(4) */ `nextval`() AS stored_nextval_guard
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
--enable_warnings
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
DROP FUNCTION `nextval`;

--disable_warnings
CREATE FUNCTION `nextval`(i INT) RETURNS INT DETERMINISTIC RETURN i;
--enable_warnings
FLUSH STATUS;
--disable_warnings
SELECT /*+ PQ(4) */ COUNT(*) AS stored_nextval_predicate_count
FROM lineitem
WHERE `nextval`(l_orderkey) > 0;
--enable_warnings
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
DROP FUNCTION `nextval`;

FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(BENCHMARK(0, 1 + l_quantity)) AS benchmark_sum
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS benchmark_predicate_count
FROM lineitem
WHERE BENCHMARK(0, 1 + l_quantity) = 0;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, ROWNUM() AS rownum_value
FROM lineitem
ORDER BY l_orderkey
LIMIT 1;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS rownum_predicate_count
FROM lineitem
WHERE CONCAT(ROWNUM(), l_orderkey) IS NOT NULL;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_quantity
LIMIT 2;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_quantity DESC
LIMIT 2;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_quantity
LIMIT 1, 2;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_quantity
LIMIT 2;
SELECT FOUND_ROWS() AS found_rows_after_non_pk_order;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

CREATE TABLE lineitem_order_nullable (
  l_orderkey INT NOT NULL PRIMARY KEY,
  l_shipdate DATE NOT NULL,
  l_sort INT NULL,
  l_quantity INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO lineitem_order_nullable VALUES
  (1, '1979-12-31', NULL, 10),
  (2, '1980-01-02', NULL, 20),
  (3, '1980-01-03', 10, 30),
  (4, '1980-01-04', 10, 40),
  (5, '1980-01-05', 20, 50),
  (6, '1980-01-06', 30, 60);
FLUSH STATUS;
SELECT /*+ PQ(4) */ SQL_CALC_FOUND_ROWS l_orderkey, l_quantity
FROM lineitem_order_nullable
WHERE l_shipdate > '1980-01-01'
ORDER BY l_sort
LIMIT 1, 4;
SELECT FOUND_ROWS() AS found_rows_after_nullable_non_pk_order;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
DROP TABLE lineitem_order_nullable;

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY ABS(l_quantity) DESC, l_orderkey
LIMIT 2;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY ABS(l_quantity - 60) DESC, l_orderkey
LIMIT 3;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_orderkey, l_quantity
FROM lineitem
WHERE l_shipdate > '1980-01-01'
ORDER BY l_quantity + 0
LIMIT 2;
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET optimizer_trace= @save_optimizer_trace;
SET optimizer_switch= @save_optimizer_switch;
SET op_over_pq_offset_threshold= @save_op_over_pq_offset_threshold;
SET pq_support_features_switch= @save_pq_support_features_switch;
SET parallel_limit_no_order_by= @save_parallel_limit_no_order_by;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL pq_master_enable= @save_pq_master_enable;

DROP TABLE lineitem_q1_group;
DROP TABLE lineitem;
