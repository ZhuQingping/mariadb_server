--source include/have_innodb.inc

--echo #
--echo # Parallel Query grouped fallback shape coverage.
--echo #

CREATE TABLE lineitem (
  l_orderkey INT NOT NULL PRIMARY KEY,
  l_shipdate DATE NOT NULL,
  l_quantity INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO lineitem VALUES
  (1, '1979-12-31', 10),
  (2, '1980-01-01', 20),
  (3, '1980-01-02', 30),
  (4, '1981-05-10', 40),
  (5, '1992-07-15', 50),
  (6, '1978-03-20', 60),
  (7, '1980-06-01', 70),
  (8, '1985-09-09', 80);

CREATE TABLE lineitem_count_distinct (
  l_orderkey INT NOT NULL PRIMARY KEY,
  l_shipdate DATE NOT NULL,
  l_quantity INT NULL
) ENGINE=InnoDB;

INSERT INTO lineitem_count_distinct VALUES
  (1, '1980-01-02', 10),
  (2, '1980-01-03', 20),
  (75, '1980-01-04', 10),
  (76, '1980-01-05', 30),
  (150, '1980-01-06', NULL),
  (151, '1980-01-07', 20),
  (152, '1979-12-31', 40);

CREATE TABLE lineitem_q1_group (
  l_orderkey INT NOT NULL,
  l_linenumber INT NOT NULL,
  l_shipdate DATE NOT NULL,
  l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_quantity DECIMAL(15,2) NOT NULL,
  l_extendedprice DECIMAL(15,2) NOT NULL,
  l_discount DECIMAL(15,2) NOT NULL,
  l_tax DECIMAL(15,2) NOT NULL,
  l_comment BLOB NOT NULL,
  PRIMARY KEY (l_orderkey, l_linenumber)
) ENGINE=InnoDB;

INSERT INTO lineitem_q1_group VALUES
  (1, 1, '1998-09-01', 'A', 'F', 10.00, 100.00, 0.05, 0.10, 'aa'),
  (2, 1, '1998-09-02', 'A', 'F', 20.00, 200.00, 0.10, 0.08, 'bbb'),
  (3, 1, '1998-09-03', 'A', 'F', 30.00, 300.00, 0.02, 0.04, 'cccc'),
  (4, 1, '1998-08-30', 'N', 'O', 40.00, 400.00, 0.07, 0.05, 'dd'),
  (5, 1, '1998-08-31', 'N', 'O', 50.00, 500.00, 0.06, 0.03, 'eee'),
  (6, 1, '1998-07-15', 'R', 'F', 60.00, 600.00, 0.08, 0.07, 'ffff');

SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_support_features_switch= @@pq_support_features_switch;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_optimizer_switch= @@optimizer_switch;

SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=on';
SET optimizer_trace= 1;

--echo #
--echo # Q1 grouped shape boundaries cover supported and fallback execution.
--echo #

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_linestatus, l_returnflag,
       COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_linestatus, l_returnflag,
       COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
--echo # HAVING-only aggregate on the constrained Q1 path stays on PQ.
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
       COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag DESC, l_linestatus DESC;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
CREATE TABLE pq_group_mixed_order (
  l_orderkey INT NOT NULL PRIMARY KEY,
  l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_linestatus CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_quantity DECIMAL(15,2) NOT NULL
) ENGINE=InnoDB;
INSERT INTO pq_group_mixed_order VALUES
  (1, 'A', 'F', 10.00),
  (2, 'A', 'O', 20.00),
  (3, 'N', 'F', 30.00),
  (4, 'N', 'O', 40.00);
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
       COUNT(*) AS count_order
FROM pq_group_mixed_order
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag ASC, l_linestatus DESC;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
DROP TABLE pq_group_mixed_order;

FLUSH STATUS;
--echo # HAVING scalar subquery constants on the constrained Q1 path stay on PQ.
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
       COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
HAVING SUM(l_quantity) > 10
ORDER BY l_returnflag, l_linestatus;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
       COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
HAVING SUM(l_quantity) > (SELECT 1 FROM lineitem_q1_group
                          WHERE l_orderkey = 1 AND l_linenumber = 1)
ORDER BY l_returnflag, l_linestatus;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
       COUNT(*) AS count_order
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus WITH ROLLUP;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(DISTINCT l_quantity) AS distinct_quantity_count
FROM lineitem
WHERE l_shipdate > '1980-01-01';
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(DISTINCT l_quantity) AS distinct_quantity_sum
FROM lineitem_count_distinct
WHERE l_shipdate > '1980-01-01';
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ AVG(DISTINCT l_quantity) AS distinct_quantity_avg
FROM lineitem_count_distinct
WHERE l_shipdate > '1980-01-01';
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag, l_linestatus,
       COUNT(DISTINCT l_returnflag, l_linestatus) AS multi_distinct_orders
FROM lineitem_q1_group
WHERE l_shipdate <= DATE '1998-09-02'
GROUP BY l_returnflag, l_linestatus
ORDER BY l_returnflag, l_linestatus;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET optimizer_trace= @save_optimizer_trace;
SET optimizer_switch= @save_optimizer_switch;
SET pq_support_features_switch= @save_pq_support_features_switch;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL pq_master_enable= @save_pq_master_enable;

DROP TABLE lineitem_q1_group;
DROP TABLE lineitem_count_distinct;
DROP TABLE lineitem;
