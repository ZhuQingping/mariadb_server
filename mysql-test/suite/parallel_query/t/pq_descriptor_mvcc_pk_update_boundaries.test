connection pq_descriptor_mvcc_reader;
--echo # READ COMMITTED descriptor workers keep the leader statement snapshot across PK movement.
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SET debug_sync= 'after_pq_create_snapshot SIGNAL pq_descriptor_mvcc_rc_snapshot WAIT_FOR pq_descriptor_mvcc_rc_release';
