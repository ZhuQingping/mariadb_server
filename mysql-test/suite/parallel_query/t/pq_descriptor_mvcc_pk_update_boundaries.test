SET debug_sync= 'now SIGNAL pq_descriptor_mvcc_rc_release';

connection pq_descriptor_mvcc_reader;
--reap
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_split_used') AS rc_btree_descriptor_split_used
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
SET debug_sync= 'RESET';
disconnect pq_descriptor_mvcc_reader;

connection default;
SELECT COUNT(*) AS descriptor_mvcc_rc_current_count
FROM pq_descriptor_mvcc_pk_update
WHERE id > -163840;

TRUNCATE TABLE pq_descriptor_mvcc_pk_update;
INSERT INTO pq_descriptor_mvcc_pk_update
SELECT CAST(seq AS SIGNED) * 10 - 163840,
       REPEAT(CHAR(65 + MOD(seq, 26)), 768)
