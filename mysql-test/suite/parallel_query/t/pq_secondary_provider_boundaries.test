--echo # Descending secondary split keys remain on the SQL primary-key scan provider.
--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ l_shipdate
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate_desc)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
