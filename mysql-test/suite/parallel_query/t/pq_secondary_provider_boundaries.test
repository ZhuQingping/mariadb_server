--echo # Prefix secondary split keys remain outside native secondary PQ.
--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ l_comment
FROM lineitem_secondary_pq FORCE INDEX(idx_comment_prefix)
WHERE l_comment >= 'cA'
  AND l_comment < 'cB'
ORDER BY l_comment;

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_comment
FROM lineitem_secondary_pq FORCE INDEX(idx_comment_prefix)
WHERE l_comment >= 'cA'
  AND l_comment < 'cB'
ORDER BY l_comment;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].scan_provider') AS prefix_secondary_scan_provider
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_available') AS prefix_secondary_handler_scan_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_rejected_reason') AS prefix_secondary_handler_rejected_reason
FROM information_schema.optimizer_trace;
SELECT json_detailed(json_extract(trace,
       '$**.not_apply_pq_plan')) AS prefix_secondary_not_apply_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo # Prefix secondary indexes remain rejected before native secondary range use.
--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ COUNT(*) AS prefix_secondary_count
FROM lineitem_secondary_pq FORCE INDEX(idx_comment_prefix)
WHERE l_comment >= 'cA'
  AND l_comment < 'cB';

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS prefix_secondary_count
FROM lineitem_secondary_pq FORCE INDEX(idx_comment_prefix)
WHERE l_comment >= 'cA'
  AND l_comment < 'cB';
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].scan_provider') AS prefix_secondary_count_scan_provider
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_available') AS prefix_secondary_count_handler_scan_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_rejected_reason') AS prefix_secondary_count_handler_rejected_reason
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

