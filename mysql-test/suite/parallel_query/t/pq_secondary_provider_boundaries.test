--source include/have_innodb.inc

--echo #
--echo # Parallel Query secondary-index scan-provider boundary coverage.
--echo #

SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_optimizer_switch= @@optimizer_switch;
SET @save_transaction_isolation= @@transaction_isolation;

SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on,index_condition_pushdown=on';
SET optimizer_trace= 1;
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;

CREATE TABLE lineitem_secondary_pq (
  l_orderkey INT NOT NULL,
  l_linenumber INT NOT NULL,
  l_shipdate DATE NOT NULL,
  l_nullable_shipdate DATE NULL,
  l_ship_year INT AS (YEAR(l_shipdate)) PERSISTENT,
  l_returnflag CHAR(1) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  l_comment VARCHAR(20) NOT NULL DEFAULT '',
  l_quantity DECIMAL(15,2) NOT NULL,
  l_extendedprice DECIMAL(15,2) NOT NULL,
  l_discount DECIMAL(15,2) NOT NULL,
  PRIMARY KEY (l_orderkey, l_linenumber),
  KEY idx_shipdate (l_shipdate),
  KEY idx_nullable_shipdate (l_nullable_shipdate),
  KEY idx_ship_year (l_ship_year),
  KEY idx_shipdate_desc (l_shipdate DESC),
  KEY idx_comment_prefix (l_comment(3)),
  KEY idx_returnflag (l_returnflag),
  KEY idx_shipdate_quantity (l_shipdate, l_quantity)
) ENGINE=InnoDB;

INSERT INTO lineitem_secondary_pq
  (l_orderkey, l_linenumber, l_shipdate, l_nullable_shipdate,
   l_returnflag, l_quantity, l_extendedprice, l_discount)
VALUES
  (1, 1, '1993-12-31', '1993-12-31', 'N', 10.00, 100.00, 0.06),
  (2, 1, '1994-01-01', '1994-01-01', 'A', 12.00, 200.00, 0.05),
  (3, 1, '1994-02-15', '1994-02-15', 'A', 18.00, 250.00, 0.06),
  (4, 1, '1994-06-15', NULL, 'R', 23.00, 300.00, 0.06),
  (5, 1, '1994-08-20', '1994-08-20', 'A', 22.00, 350.00, 0.07),
  (6, 1, '1994-12-31', '1994-12-31', 'N', 24.00, 400.00, 0.07),
  (7, 1, '1995-01-01', '1995-01-01', 'A', 20.00, 500.00, 0.06),
  (8, 1, '1995-05-01', '1995-05-01', 'R', 15.00, 600.00, 0.04);

UPDATE lineitem_secondary_pq
SET l_comment= CONCAT('c', l_returnflag, l_orderkey);

--echo # Covering secondary forward range can use the native InnoDB secondary provider without ICP.
SET optimizer_switch= 'parallel_query=on,index_condition_pushdown=off';
SET force_parallel_execute= OFF;
SELECT COUNT(*) AS covering_secondary_serial_count
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01';

SET force_parallel_execute= ON;
--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ COUNT(*) AS covering_secondary_pq_count
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01';

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS covering_secondary_pq_count
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01';
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].scan_provider') AS covering_secondary_scan_provider
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_available') AS covering_secondary_handler_scan_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].record_buffer_available') AS covering_secondary_record_buffer_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].worker_scan_api') AS covering_secondary_worker_scan_api
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].vfd_used') AS covering_secondary_vfd_used
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].secondary_requires_cluster_lookup') AS covering_secondary_requires_cluster_lookup
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].secondary_keyread_used') AS covering_secondary_keyread_used
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_rejected_reason') AS covering_secondary_btree_rejected_reason
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo # Covering secondary forward projection can use the same native secondary provider.
SET force_parallel_execute= OFF;
SELECT l_shipdate AS covering_secondary_serial_shipdate
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
ORDER BY l_shipdate;

SET force_parallel_execute= ON;
--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ l_shipdate AS covering_secondary_pq_shipdate
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
ORDER BY l_shipdate;

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_shipdate AS covering_secondary_pq_shipdate
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
ORDER BY l_shipdate;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].scan_provider') AS covering_secondary_projection_provider
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_available') AS covering_secondary_projection_handler_available
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo # Non-covering secondary forward projection can use clustered lookup through the native secondary provider.
SET force_parallel_execute= OFF;
SELECT l_quantity AS noncovering_secondary_serial_quantity
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
ORDER BY l_shipdate, l_quantity;

SET force_parallel_execute= ON;
--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ l_quantity AS noncovering_secondary_pq_quantity
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
ORDER BY l_shipdate, l_quantity;

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_quantity AS noncovering_secondary_pq_quantity
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
ORDER BY l_shipdate, l_quantity;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].scan_provider') AS noncovering_secondary_projection_provider
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_available') AS noncovering_secondary_projection_handler_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].secondary_requires_cluster_lookup') AS noncovering_secondary_projection_requires_cluster_lookup
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].secondary_keyread_used') AS noncovering_secondary_projection_keyread_used
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo # Non-covering secondary scalar aggregate without ICP can use clustered lookup through the native secondary provider.
SET optimizer_switch= 'parallel_query=on,index_condition_pushdown=off';
SET force_parallel_execute= OFF;
SELECT SUM(l_extendedprice * l_discount) AS noncovering_secondary_serial_revenue
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01';
SET @noncovering_secondary_serial_revenue= (
  SELECT SUM(l_extendedprice * l_discount)
  FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
  WHERE l_shipdate >= DATE '1994-01-01'
    AND l_shipdate < DATE '1995-01-01');

SET force_parallel_execute= ON;
--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ SUM(l_extendedprice * l_discount) AS noncovering_secondary_pq_revenue
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01';

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_extendedprice * l_discount) AS noncovering_secondary_pq_revenue
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01';
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].scan_provider') AS noncovering_secondary_aggregate_provider
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_available') AS noncovering_secondary_aggregate_handler_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].record_buffer_available') AS noncovering_secondary_aggregate_record_buffer_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].worker_scan_api') AS noncovering_secondary_aggregate_worker_scan_api
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].vfd_used') AS noncovering_secondary_aggregate_vfd_used
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].secondary_requires_cluster_lookup') AS noncovering_secondary_aggregate_requires_cluster_lookup
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].secondary_keyread_used') AS noncovering_secondary_aggregate_keyread_used
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_rejected_reason') AS noncovering_secondary_aggregate_btree_rejected_reason
FROM information_schema.optimizer_trace;
SET @noncovering_secondary_pq_revenue= (
  SELECT /*+ PQ(4) */ SUM(l_extendedprice * l_discount)
  FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
  WHERE l_shipdate >= DATE '1994-01-01'
    AND l_shipdate < DATE '1995-01-01');
SELECT @noncovering_secondary_serial_revenue =
       @noncovering_secondary_pq_revenue AS noncovering_secondary_revenue_equal;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo # Non-covering secondary grouped aggregate without ICP can use clustered lookup through the native secondary provider.
SET optimizer_switch= 'parallel_query=on,index_condition_pushdown=off';
SET force_parallel_execute= OFF;
SELECT l_returnflag,
       SUM(l_quantity) AS noncovering_secondary_serial_sum_qty,
       SUM(l_extendedprice * l_discount) AS noncovering_secondary_serial_revenue,
       COUNT(*) AS noncovering_secondary_serial_count
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
GROUP BY l_returnflag
ORDER BY l_returnflag;

SET force_parallel_execute= ON;
--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ l_returnflag,
       SUM(l_quantity) AS noncovering_secondary_pq_sum_qty,
       SUM(l_extendedprice * l_discount) AS noncovering_secondary_pq_revenue,
       COUNT(*) AS noncovering_secondary_pq_count
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
GROUP BY l_returnflag
ORDER BY l_returnflag;

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_returnflag,
       SUM(l_quantity) AS noncovering_secondary_pq_sum_qty,
       SUM(l_extendedprice * l_discount) AS noncovering_secondary_pq_revenue,
       COUNT(*) AS noncovering_secondary_pq_count
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
GROUP BY l_returnflag
ORDER BY l_returnflag;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].scan_provider') AS noncovering_secondary_group_provider
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_available') AS noncovering_secondary_group_handler_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].secondary_requires_cluster_lookup') AS noncovering_secondary_group_requires_cluster_lookup
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].secondary_keyread_used') AS noncovering_secondary_group_keyread_used
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].btree_descriptor_rejected_reason') AS noncovering_secondary_group_btree_rejected_reason
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

