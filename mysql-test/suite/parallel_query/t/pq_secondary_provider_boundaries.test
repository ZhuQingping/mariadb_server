SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo # Generated-column secondary COUNT-only shapes remain outside PQ admission.
--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ COUNT(*) AS generated_secondary_count
FROM lineitem_secondary_pq FORCE INDEX(idx_ship_year)
WHERE l_ship_year >= 1994
  AND l_ship_year < 1995;

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS generated_secondary_count
FROM lineitem_secondary_pq FORCE INDEX(idx_ship_year)
WHERE l_ship_year >= 1994
  AND l_ship_year < 1995;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].scan_provider') AS generated_secondary_count_scan_provider
