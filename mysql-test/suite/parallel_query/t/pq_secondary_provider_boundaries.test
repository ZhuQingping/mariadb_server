--echo # Secondary range/ICP-like Q6 plan remains the SQL primary-key scan provider at runtime.
SET optimizer_switch= 'parallel_query=on,index_condition_pushdown=on';
--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ SUM(l_extendedprice * l_discount) AS q6_secondary_range_revenue
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
  AND l_quantity < 24;

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ SUM(l_extendedprice * l_discount) AS q6_secondary_range_revenue
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_discount BETWEEN 0.05 AND 0.07
  AND l_quantity < 24;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].scan_provider') AS secondary_range_scan_provider
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_available') AS secondary_range_handler_scan_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_rejected_reason') AS secondary_range_handler_rejected_reason
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo # Simple secondary ICP candidate still rejects native secondary-provider ICP.
--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ COUNT(*) AS secondary_simple_icp_count
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_quantity < 24;

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS secondary_simple_icp_count
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_quantity < 24;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].scan_provider') AS secondary_simple_icp_scan_provider
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_available') AS secondary_simple_icp_handler_scan_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_rejected_reason') AS secondary_simple_icp_handler_rejected_reason
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo # Secondary ICP OR candidate remains outside native secondary-provider ICP.
--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ COUNT(*) AS secondary_or_icp_count
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND (l_quantity < 24 OR l_discount = 0.07);

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS secondary_or_icp_count
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND (l_quantity < 24 OR l_discount = 0.07);
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].scan_provider') AS secondary_or_icp_scan_provider
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_available') AS secondary_or_icp_handler_scan_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_rejected_reason') AS secondary_or_icp_handler_rejected_reason
FROM information_schema.optimizer_trace;
SELECT json_detailed(json_extract(trace,
       '$**.not_apply_pq_plan')) AS secondary_or_icp_not_apply_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo # String/collation secondary range split keys remain SQL primary-key scan provider.
--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ COUNT(*) AS secondary_string_range_count
FROM lineitem_secondary_pq FORCE INDEX(idx_returnflag)
WHERE l_returnflag >= 'A'
  AND l_returnflag < 'B';

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS secondary_string_range_count
FROM lineitem_secondary_pq FORCE INDEX(idx_returnflag)
WHERE l_returnflag >= 'A'
  AND l_returnflag < 'B';
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].scan_provider') AS secondary_string_range_scan_provider
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_available') AS secondary_string_range_handler_scan_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_rejected_reason') AS secondary_string_range_handler_rejected_reason
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo # Secondary ref access also keeps the SQL primary-key scan provider boundary.
--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ COUNT(*) AS secondary_ref_count
FROM lineitem_secondary_pq FORCE INDEX(idx_returnflag)
WHERE l_returnflag = 'A';

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS secondary_ref_count
FROM lineitem_secondary_pq FORCE INDEX(idx_returnflag)
WHERE l_returnflag = 'A';
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].scan_provider') AS secondary_ref_scan_provider
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_available') AS secondary_ref_handler_scan_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_rejected_reason') AS secondary_ref_handler_rejected_reason
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo # Secondary composite range/ICP-like shape remains SQL primary-key split.
--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ COUNT(*) AS secondary_composite_range_count
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate_quantity)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_quantity < 24;

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS secondary_composite_range_count
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate_quantity)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
  AND l_quantity < 24;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].scan_provider') AS secondary_composite_scan_provider
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_available') AS secondary_composite_handler_scan_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_rejected_reason') AS secondary_composite_handler_rejected_reason
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo # Reverse secondary-order projection still uses the SQL primary-key scan provider.
--replace_column 9 #
EXPLAIN SELECT /*+ PQ(4) */ l_shipdate
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
ORDER BY l_shipdate DESC;

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_shipdate
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
ORDER BY l_shipdate DESC;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].scan_provider') AS reverse_order_scan_provider
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_available') AS reverse_order_handler_scan_available
FROM information_schema.optimizer_trace;
SELECT json_extract(trace,
       '$**.parallel_query_scan_provider[0].handler_scan_rejected_reason') AS reverse_order_handler_rejected_reason
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo # Unsupported isolation keeps secondary provider disabled.
SET SESSION TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS secondary_read_uncommitted_count
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01';
SELECT json_detailed(json_extract(trace,
       '$**.not_apply_pq_plan')) AS secondary_read_uncommitted_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET SESSION transaction_isolation= @save_transaction_isolation;

--echo # Locking reads keep secondary provider disabled.
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_shipdate
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
ORDER BY l_shipdate
FOR UPDATE;
SELECT json_detailed(json_extract(trace,
       '$**.not_apply_pq_plan')) AS secondary_for_update_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
SELECT /*+ PQ(4) */ l_shipdate
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01'
ORDER BY l_shipdate
LOCK IN SHARE MODE;
SELECT json_detailed(json_extract(trace,
       '$**.not_apply_pq_plan')) AS secondary_lock_in_share_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo # Active write transactions keep secondary provider disabled.
SET optimizer_trace= 0;
SET optimizer_trace= 1;
FLUSH STATUS;
START TRANSACTION;
INSERT INTO lineitem_secondary_pq
  (l_orderkey, l_linenumber, l_shipdate, l_nullable_shipdate,
   l_returnflag, l_quantity, l_extendedprice, l_discount)
VALUES
  (100, 1, '1994-09-01', '1994-09-01', 'A', 99.00, 900.00, 0.05);
SELECT /*+ PQ(4) */ COUNT(*) AS secondary_active_transaction_count
FROM lineitem_secondary_pq FORCE INDEX(idx_shipdate)
WHERE l_shipdate >= DATE '1994-01-01'
  AND l_shipdate < DATE '1995-01-01';
SELECT json_detailed(json_extract(trace,
       '$**.not_apply_pq_plan')) AS secondary_active_transaction_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';
ROLLBACK;

SET optimizer_trace= @save_optimizer_trace;
SET optimizer_switch= @save_optimizer_switch;
SET SESSION transaction_isolation= @save_transaction_isolation;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL pq_master_enable= @save_pq_master_enable;

DROP TABLE lineitem_secondary_pq;
