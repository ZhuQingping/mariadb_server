--source include/have_innodb.inc

--echo #
--echo # Parallel Query group key type and TIME predicate coverage.
--echo #

SET @save_force_parallel_execute= @@force_parallel_execute;
SET @save_parallel_default_dop= @@parallel_default_dop;
SET @save_pq_support_features_switch= @@pq_support_features_switch;
SET @save_pq_master_enable= @@global.pq_master_enable;
SET @save_parallel_max_threads= @@global.parallel_max_threads;
SET @save_parallel_memory_limit= @@global.parallel_memory_limit;
SET @save_optimizer_trace= @@optimizer_trace;
SET @save_optimizer_switch= @@optimizer_switch;

SET GLOBAL pq_master_enable= ON;
SET GLOBAL parallel_max_threads= 64;
SET GLOBAL parallel_memory_limit= 104857600;
SET optimizer_switch= 'parallel_query=on';
SET force_parallel_execute= ON;
SET parallel_default_dop= 4;
SET pq_support_features_switch= 'simple_aggregate=on,count_distinct=on';

CREATE TABLE pq_group_key_types (
  id INT NOT NULL PRIMARY KEY,
  g_int INT NULL,
  g_dec DECIMAL(10,2) NULL,
  g_date DATE NULL,
  g_time TIME(6) NULL,
  g_dt DATETIME(6) NULL,
  qty INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO pq_group_key_types VALUES
  (1, -2, -10.50, '1979-12-31', '-00:00:01.000001', '1979-12-31 23:59:59.000001', 1),
  (2, -1, -10.50, '1980-01-01', '00:00:00.000000', '1980-01-01 00:00:00.000000', 1),
  (3, 0, 0.00, '1980-01-01', '00:00:00.000000', '1980-01-01 00:00:00.000000', 1),
  (4, 1, 1.20, '1998-09-02', '12:34:56.123456', '1998-09-02 12:34:56.123456', 1),
  (5, 1, 1.20, '1998-09-02', '12:34:56.123456', '1998-09-02 12:34:56.123456', 1),
  (6, 2, 100.01, NULL, NULL, NULL, 1),
  (7, 255, NULL, '2000-01-01', '23:59:59.999999', '2000-01-01 00:00:00.999999', 1),
  (8, 256, 100.01, '2000-01-01', '23:59:59.999999', '2000-01-01 00:00:00.999999', 1),
  (9, NULL, NULL, NULL, NULL, NULL, 1);

FLUSH STATUS;
SELECT /*+ PQ(4) */ MIN(g_time) AS time_min
FROM pq_group_key_types;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ MAX(g_time) AS time_max
FROM pq_group_key_types;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ g_int, COUNT(*) AS count_order
FROM pq_group_key_types
GROUP BY g_int
ORDER BY g_int;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ g_dec, COUNT(*) AS count_order
FROM pq_group_key_types
GROUP BY g_dec
ORDER BY g_dec;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ g_date, COUNT(*) AS count_order
FROM pq_group_key_types
GROUP BY g_date
ORDER BY g_date;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ g_time, COUNT(*) AS count_order
FROM pq_group_key_types
GROUP BY g_time
ORDER BY g_time;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ g_dt, COUNT(*) AS count_order
FROM pq_group_key_types
GROUP BY g_dt
ORDER BY g_dt;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ g_int, g_date, COUNT(*) AS count_order, SUM(qty) AS sum_qty
FROM pq_group_key_types
GROUP BY g_int, g_date
ORDER BY g_int, g_date;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ g_int, g_time, COUNT(*) AS count_order
FROM pq_group_key_types
GROUP BY g_int, g_time
ORDER BY g_int, g_time
LIMIT 4;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ g_dec, g_dt, COUNT(*) AS count_order
FROM pq_group_key_types
GROUP BY g_dec, g_dt
ORDER BY g_dec, g_dt
LIMIT 3;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ g_int, COUNT(*) AS count_order, g_date, SUM(qty) AS sum_qty
FROM pq_group_key_types
GROUP BY g_int, g_date
ORDER BY g_int, g_date
LIMIT 4;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

INSERT INTO pq_group_key_types VALUES
  (10, NULL, NULL, NULL, NULL, NULL, 1),
  (100, NULL, NULL, NULL, NULL, NULL, 1);

FLUSH STATUS;
SELECT /*+ PQ(4) */ g_int, COUNT(*) AS count_order, SUM(qty) AS sum_qty
FROM pq_group_key_types
GROUP BY g_int
HAVING g_int IS NULL
ORDER BY g_int;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

FLUSH STATUS;
SELECT /*+ PQ(4) */ g_int, COUNT(*) AS count_order
FROM pq_group_key_types
GROUP BY g_int
ORDER BY g_int DESC;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

--echo #
--echo # Optimizer trace covers supported TIME predicates and fallback reasons.
--echo #

SET optimizer_trace=1;

FLUSH STATUS;
SELECT /*+ PQ(4) */ COUNT(*) AS time_predicate_count
FROM pq_group_key_types
WHERE g_time > TIME '00:00:00';
SELECT json_detailed(json_extract(trace, '$**.not_apply_pq_plan')) AS pq_trace
FROM information_schema.optimizer_trace;
SHOW SESSION STATUS LIKE 'Parallel_query_count';

SET optimizer_trace= @save_optimizer_trace;
SET optimizer_switch= @save_optimizer_switch;
SET pq_support_features_switch= @save_pq_support_features_switch;
SET force_parallel_execute= @save_force_parallel_execute;
SET parallel_default_dop= @save_parallel_default_dop;
SET GLOBAL parallel_memory_limit= @save_parallel_memory_limit;
SET GLOBAL parallel_max_threads= @save_parallel_max_threads;
SET GLOBAL pq_master_enable= @save_pq_master_enable;

DROP TABLE pq_group_key_types;
